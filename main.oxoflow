# oxo-flow port of nf-core/mag 5.5.0 (default-parameters main path).
#
# Upstream: https://github.com/nf-core/mag @ 5.5.0
#   (sha 56abab5b023ce953c9c43fe21090d156ad0e18af)
# Default path: FastQC(raw) -> fastp -> phiX removal (bowtie2) ->
#   FastQC(trimmed) -> [SPAdes + MEGAHIT assembly] -> gunzip ->
#   QUAST + PRODIGAL -> bowtie2 binning preparation -> binning
#   (MetaBAT2, MaxBin2, CONCOCT, COMEBin, MetaBinner, SemiBin2) ->
#   depths -> BUSCO bin QC -> QUAST bins -> GTDB-Tk classification ->
#   bin summary -> PROKKA annotation -> ALE -> MultiQC.
#
# Fidelity notes (see README for the full table):
# - Commands mirror the upstream module scripts byte-for-byte under default
#   params; upstream process labels/overrides are baked into
#   [rules.resources].
# - oxo-flow has no {assembler} wildcard: every per-assembler process is
#   emitted as one rule per assembler with the assembler hard-coded in the
#   rule name and file paths (rule name suffix _megahit / _spades).
# - The upstream binning_map_mode='group' behavior is replicated: every
#   assembly is aligned against every sample's reads in the cohort
#   (bowtie2_align_* loops over the group's read sets).
# - Rules whose tools write generic-named files into the working directory
#   (spades, megahit, busco, gtdbtk, metabinner, semibin, ...) run inside a
#   per-rule scratch subdir and move named outputs out afterwards, because
#   oxo-flow executes every rule in one shared working directory (upstream
#   Nextflow gives every task its own directory).
# - MultiQC input collection mirrors the upstream channel mix; the
#   nf-core boilerplate inputs (workflow_summary_mqc.yaml,
#   methods_description_mqc.yaml, versions.yml) are not ported.

[workflow]
name = "oxo-flow-mag"
version = "1.0.0"
# Points at the reads sheet by default so sheet-mode activation needs only
# : metadata_file must be a [workflow] key (loaded at
# parse time, before {meta.*} plan-time gating) — a --arg metadata_file
# override arrives after parse and never reaches the metadata table.
# Default mode (reads_sheet = "") leaves the metadata rows unused: every
# {meta.*} gate bakes false at plan time and the paired-end byte plan is
# unchanged.
metadata_file = "test/fixtures/reads_sheet.tsv"
description = "Metagenome assembly and binning: FastQC, fastp, phiX removal, SPAdes/MEGAHIT assembly, QUAST, PRODIGAL, bowtie2 mapping, binning (MetaBAT2/MaxBin2/CONCOCT/COMEBin/MetaBinner/SemiBin2), depths, BUSCO QC, GTDB-Tk classification, bin summary, PROKKA annotation, ALE, MultiQC"
author = "oxo-flow-community"

[config]
# Input directory containing {sample}_R1.fastq.gz / {sample}_R2.fastq.gz
# paired-end read files (upstream --input samplesheet; single-end and
# multi-library lanes are not ported). The repo default ships tiny test
# fixtures; point this at your data.
input_dir = "test/fixtures/raw"
out_dir = "results"
# Sheet-mode input (off by default): when reads_sheet is set to a TSV path,
# it is loaded as [workflow].metadata_file (per-sample read paths + layout)
# and the paired-end {sample}_R1/_R2 rules are replaced by per-layout sheet
# rules (see modules/01_preprocessing.oxoflow / 02_assembly.oxoflow). Sheet
# columns: sample, reads_1, reads_2 (empty for single-end / interleaved),
# reads_layout (pe | single | interleaved).
# The sample set still comes from [[sample_groups]] below (the engine treats
# metadata_file as a lookup only) — point both at your sheet's samples, or
# pass --samples S1,S2,.... Empty (default) keeps the paired-end
# {sample}_R1/_R2 pattern untouched (byte-identical plan).
# Example sheet (test/fixtures/reads_sheet.tsv ships one):
#   sample  short_reads_fastq1              short_reads_fastq2              short_reads_layout
#   S1      test/fixtures/raw/S1_R1.fastq.gz test/fixtures/raw/S1_R2.fastq.gz pe
#   SE1     test/fixtures/raw/S1_R1.fastq.gz                                 single
#   IL1     test/fixtures/interleaved_IL1.fastq.gz                           interleaved
reads_sheet = ""
# phiX reference (upstream --phix_reference default =
# projectDir/assets/data/GCA_002596845.1_ASM259684v1_genomic.fna.gz)
phix_reference = "assets/data/GCA_002596845.1_ASM259684v1_genomic.fna.gz"
# GTDB-Tk database: local path to the release .tar.gz or an unpacked
# directory (upstream --gtdb_db, ~100GB). oxo-flow cannot download it
# mid-run (the prep rule only unpacks), so the default is empty and
# run_gtdbtk=true fails fast until a local path is set.
gtdb_db = ""
# GTDB-Tk gate: the ~100GB reference database is user-provided (see the
# README requirements); run_gtdbtk=false runs the full pipeline minus the
# GTDB-Tk classification (the documented live-test contract).
run_gtdbtk = true
# Clipping (upstream params with the same defaults; --clip_tool selects the
# adapter trimmer, fastp is the upstream default)
clip_tool = "fastp"
reads_minlength = 15
fastp_qualified_quality = 15
fastp_cut_mean_quality = 15
fastp_trim_polyg = false
adapterremoval_minquality = 2
adapterremoval_adapter1 = "AGATCGGAAGAGCACACGTCTGAACTCCAGTCACNNNNNNATCTCGTATGCCGTCTTCTGCTTG"
adapterremoval_adapter2 = "AGATCGGAAGAGCGTCGTGTAGGGAAAGAGTGTAGATCTCGGTGGTCGCCGTATCATT"
adapterremoval_trim_quality_stretch = false
# Host read removal (upstream --host_fasta / --host_fasta_bowtie2index; the
# reference fasta is required, the prebuilt bowtie2 index is optional and
# skips the build rule)
host_fasta = ""
host_fasta_bowtie2index = ""
host_removal_verysensitive = false
# Read normalization (upstream --bbnorm; runs between phiX removal and assembly)
bbnorm = false
bbnorm_target = 100
bbnorm_min = 5
# Bin size filtering (upstream --bin_min_size / --bin_max_size; defaults
# 0/null make the seqkit-based filter a no-op)
bin_min_size = 0
bin_max_size = ""
min_contig_size = 1500
min_length_unbinned_contigs = 1000000
max_unbinned_contigs = 100
# Binning options (upstream params with the same defaults)
bin_concoct_chunksize = 10000
bin_concoct_overlap = 0
bin_concoct_donotconcatlast = false
bin_metabinner_scale = "large"
semibin_rng_seed = 1
semibin_environment = "global"
metabat_rng_seed = 1
shortread_percentidentity = ""
# GTDB-Tk (upstream params with the same defaults)
gtdbtk_min_completeness = 50.0
gtdbtk_max_contamination = 10.0
gtdbtk_min_perc_aa = 10
gtdbtk_min_af = 0.65
gtdbtk_pplacer_cpus = 1
gtdbtk_use_full_tree = false
gtdbtk_place_species = false
# DAS Tool bin refinement (upstream --refine_bins_dastool / --refine_bins_dastool_threshold)
refine_bins_dastool = false
refine_bins_dastool_threshold = 0.5
# CheckM bin QC (upstream --run_checkm; the 1.1GB lineage database is
# downloaded at env creation and unpacked at run time — see README)
run_checkm = false
checkm_db = ""
# CheckM2 bin QC (upstream --run_checkm2; the ~10GB .dmnd database is
# user-provided — checkm2 database --download; fails fast when empty)
run_checkm2 = false
checkm2_db = ""
# GUNC contamination QC (upstream --run_gunc; the reference database is
# user-provided — gunc download_db; fails fast when empty)
run_gunc = false
gunc_db = ""
# CAT/BAT bin classification (upstream --cat_db; the CAT_prepare database
# is user-provided — CAT_pack download + prepare, or the archive/directory
# itself; db/ and tax/ directories are discovered inside it)
cat_db = ""
cat_allow_unofficial_lineages = false
# Virus identification (upstream --run_virus_identification; the geNomad
# database is user-provided — genomad download-database; fails fast when empty)
run_virus_identification = false
genomad_db = ""
# Domain classification with Tiara (upstream --bin_domain_classification / --tiara_min_length)
bin_domain_classification = false
tiara_min_length = 3000
# PROKKA (upstream params with the same defaults)
prokka_with_compliance = false
prokka_fast_mode = false
# ALE (upstream --ale_per_base_output default false -> --metagenome --nout)
ale_per_base_output = false
# Space-separated list of sample ids used by the binning-preparation
# bowtie2 alignment rules (binning_map_mode='group': every assembly is
# aligned against every sample's reads). Keep in sync with the sample
# group below.
cohort_samples = "S1 S2"

[[sample_groups]]
name = "cohort"
samples = ["S1", "S2", "SE1", "IL1"]

[defaults]
threads = 1
memory = "6G"

# ---------------------------------------------------------------------------
# Rule fragments (one upstream process per rule; per-assembler processes are
# hard-coded per assembler, see README fidelity table).
# ---------------------------------------------------------------------------
[[include]]
path = "modules/01_preprocessing.oxoflow"

[[include]]
path = "modules/02_assembly.oxoflow"

[[include]]
path = "modules/03_binning_prep.oxoflow"

[[include]]
path = "modules/04_binning.oxoflow"

[[include]]
path = "modules/05_binqc.oxoflow"

[[include]]
path = "modules/06_taxonomy.oxoflow"

[[include]]
path = "modules/07_refinement.oxoflow"

[[include]]
path = "modules/08_domain.oxoflow"

[[include]]
path = "modules/09_catpack.oxoflow"

[[include]]
path = "modules/10_virus_identification.oxoflow"
