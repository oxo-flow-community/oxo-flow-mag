rm -rf .tmp/dastool_f2c2b_megahit_semibin2_{sample}
"""

[rules.resources]
threads = 1
memory = "4G"
time_limit = "4h"

[rules.environment]
conda = "envs/dastool.yaml"

# DASTOOL_DASTOOL (label process_medium; one per assembler). The six
# contiglist tables are comma-joined; empty tables are dropped (upstream
# channel semantics). The assembly contigs are decompressed first (module
# behavior). Auxiliary tables are published flat under
# results/GenomeBinning/DASTool/ (upstream publishDir pattern
# '*.{tsv,log,eval,seqlength}'); the *_DASTool_bins dir stays in
# intermediates for RENAME_POSTDASTOOL.
[[rules]]
name = "dastool_dastool_spades"
when = "config.refine_bins_dastool"
input = [
    "intermediates/assembly/SPAdes/SPAdes-{sample}.scaffolds.fa.gz",
    "intermediates/refinement/contig2bin/SPAdes-MetaBAT2-{sample}_contiglist.tsv",
    "intermediates/refinement/contig2bin/SPAdes-MaxBin2-{sample}_contiglist.tsv",
    "intermediates/refinement/contig2bin/SPAdes-CONCOCT-{sample}_contiglist.tsv",
    "intermediates/refinement/contig2bin/SPAdes-COMEBin-{sample}_contiglist.tsv",
    "intermediates/refinement/contig2bin/SPAdes-MetaBinner-{sample}_contiglist.tsv",
    "intermediates/refinement/contig2bin/SPAdes-SemiBin2-{sample}_contiglist.tsv",
]
output = [
    "intermediates/refinement/dastool/SPAdes-DASTool-{sample}_DASTool_bins",
    "{config.out_dir}/GenomeBinning/DASTool",
]
depends_on = [
    "dastool_fastatocontig2bin_spades_metabat2",
    "dastool_fastatocontig2bin_spades_maxbin2",
    "dastool_fastatocontig2bin_spades_concoct",
    "dastool_fastatocontig2bin_spades_comebin",
    "dastool_fastatocontig2bin_spades_metabinner",
    "dastool_fastatocontig2bin_spades_semibin2",
]
description = "Refine the SPAdes bins with DAS Tool (upstream DASTOOL_DASTOOL)"
shell = """
wd=$(pwd)
mkdir -p intermediates/refinement/dastool {config.out_dir}/GenomeBinning/DASTool
mkdir -p .tmp/dastool_spades_{sample} && cd .tmp/dastool_spades_{sample}
# decompress the assembly contigs (module behavior: clean_contigs = - .gz)
cp "$wd/intermediates/assembly/SPAdes/SPAdes-{sample}.scaffolds.fa.gz" .
gunzip -q -f SPAdes-{sample}.scaffolds.fa.gz
# comma-joined contig2bin tables, skipping empty groups
tsvs=""
for t in "$wd"/intermediates/refinement/contig2bin/SPAdes-*-{sample}_contiglist.tsv; do
    [ -s "$t" ] || continue
    ln -sf "$t" .
    tsvs="${tsvs},$(basename "$t")"
done
tsvs=${tsvs#,}
if [ -n "$tsvs" ]; then
    DAS_Tool \\
        --write_bins \\
        --write_unbinned \\
        --write_bin_evals \\
        --score_threshold {config.refine_bins_dastool_threshold} \\
        -t {threads} \\
        -i "$tsvs" \\
        -c SPAdes-{sample}.scaffolds.fa \\
        -o SPAdes-DASTool-{sample}
    [ $? -eq 0 ] || { echo "DAS_Tool failed for SPAdes-{sample}" 1>&2; exit 1; }
else
    touch SPAdes-DASTool-{sample}_DASTool.log
    mkdir -p SPAdes-DASTool-{sample}_DASTool_bins
fi
mv SPAdes-DASTool-{sample}_DASTool_bins "$wd/intermediates/refinement/dastool/"
# publish the auxiliary tables flat (upstream publishDir '*.{tsv,log,eval,seqlength}')
if [ -f SPAdes-DASTool-{sample}_DASTool.log ]; then
    mv SPAdes-DASTool-{sample}_DASTool.log "$wd/{config.out_dir}/GenomeBinning/DASTool/"
fi
if [ -f SPAdes-DASTool-{sample}_DASTool_summary.tsv ]; then
    mv SPAdes-DASTool-{sample}_DASTool_summary.tsv "$wd/{config.out_dir}/GenomeBinning/DASTool/"
fi
if [ -f SPAdes-DASTool-{sample}_DASTool_contig2bin.tsv ]; then
    mv SPAdes-DASTool-{sample}_DASTool_contig2bin.tsv "$wd/{config.out_dir}/GenomeBinning/DASTool/"
fi
if [ -f SPAdes-DASTool-{sample}_allBins.eval ]; then
    mv SPAdes-DASTool-{sample}_allBins.eval "$wd/{config.out_dir}/GenomeBinning/DASTool/"
fi
if [ -f SPAdes-DASTool-{sample}.seqlength ]; then
    mv SPAdes-DASTool-{sample}.seqlength "$wd/{config.out_dir}/GenomeBinning/DASTool/"
fi
cd "$wd"
rm -rf .tmp/dastool_spades_{sample}
"""

[rules.resources]
threads = 8
memory = "14G"
time_limit = "4h"

[rules.environment]
conda = "envs/dastool.yaml"

[[rules]]
name = "dastool_dastool_megahit"
when = "config.refine_bins_dastool"
input = [
    "intermediates/assembly/MEGAHIT/MEGAHIT-{sample}.contigs.fa.gz",
    "intermediates/refinement/contig2bin/MEGAHIT-MetaBAT2-{sample}_contiglist.tsv",
    "intermediates/refinement/contig2bin/MEGAHIT-MaxBin2-{sample}_contiglist.tsv",
    "intermediates/refinement/contig2bin/MEGAHIT-CONCOCT-{sample}_contiglist.tsv",
    "intermediates/refinement/contig2bin/MEGAHIT-COMEBin-{sample}_contiglist.tsv",
    "intermediates/refinement/contig2bin/MEGAHIT-MetaBinner-{sample}_contiglist.tsv",
    "intermediates/refinement/contig2bin/MEGAHIT-SemiBin2-{sample}_contiglist.tsv",
]
output = [
    "intermediates/refinement/dastool/MEGAHIT-DASTool-{sample}_DASTool_bins",
    "{config.out_dir}/GenomeBinning/DASTool",
]
depends_on = [
    "dastool_fastatocontig2bin_megahit_metabat2",
    "dastool_fastatocontig2bin_megahit_maxbin2",
    "dastool_fastatocontig2bin_megahit_concoct",
    "dastool_fastatocontig2bin_megahit_comebin",
    "dastool_fastatocontig2bin_megahit_metabinner",
    "dastool_fastatocontig2bin_megahit_semibin2",
]
description = "Refine the MEGAHIT bins with DAS Tool (upstream DASTOOL_DASTOOL)"
shell = """
wd=$(pwd)
mkdir -p intermediates/refinement/dastool {config.out_dir}/GenomeBinning/DASTool
mkdir -p .tmp/dastool_megahit_{sample} && cd .tmp/dastool_megahit_{sample}
# decompress the assembly contigs (module behavior: clean_contigs = - .gz)
cp "$wd/intermediates/assembly/MEGAHIT/MEGAHIT-{sample}.contigs.fa.gz" .
gunzip -q -f MEGAHIT-{sample}.contigs.fa.gz
# comma-joined contig2bin tables, skipping empty groups
tsvs=""
for t in "$wd"/intermediates/refinement/contig2bin/MEGAHIT-*-{sample}_contiglist.tsv; do
    [ -s "$t" ] || continue
    ln -sf "$t" .
    tsvs="${tsvs},$(basename "$t")"
done
tsvs=${tsvs#,}
if [ -n "$tsvs" ]; then
    DAS_Tool \\
        --write_bins \\
        --write_unbinned \\
        --write_bin_evals \\
        --score_threshold {config.refine_bins_dastool_threshold} \\
        -t {threads} \\
        -i "$tsvs" \\
        -c MEGAHIT-{sample}.contigs.fa \\
        -o MEGAHIT-DASTool-{sample}
    [ $? -eq 0 ] || { echo "DAS_Tool failed for MEGAHIT-{sample}" 1>&2; exit 1; }
else
    touch MEGAHIT-DASTool-{sample}_DASTool.log
    mkdir -p MEGAHIT-DASTool-{sample}_DASTool_bins
fi
mv MEGAHIT-DASTool-{sample}_DASTool_bins "$wd/intermediates/refinement/dastool/"
# publish the auxiliary tables flat (upstream publishDir '*.{tsv,log,eval,seqlength}')
if [ -f MEGAHIT-DASTool-{sample}_DASTool.log ]; then
    mv MEGAHIT-DASTool-{sample}_DASTool.log "$wd/{config.out_dir}/GenomeBinning/DASTool/"
fi
if [ -f MEGAHIT-DASTool-{sample}_DASTool_summary.tsv ]; then
    mv MEGAHIT-DASTool-{sample}_DASTool_summary.tsv "$wd/{config.out_dir}/GenomeBinning/DASTool/"
fi
if [ -f MEGAHIT-DASTool-{sample}_DASTool_contig2bin.tsv ]; then
    mv MEGAHIT-DASTool-{sample}_DASTool_contig2bin.tsv "$wd/{config.out_dir}/GenomeBinning/DASTool/"
fi
if [ -f MEGAHIT-DASTool-{sample}_allBins.eval ]; then
    mv MEGAHIT-DASTool-{sample}_allBins.eval "$wd/{config.out_dir}/GenomeBinning/DASTool/"
fi
if [ -f MEGAHIT-DASTool-{sample}.seqlength ]; then
    mv MEGAHIT-DASTool-{sample}.seqlength "$wd/{config.out_dir}/GenomeBinning/DASTool/"
fi
cd "$wd"
rm -rf .tmp/dastool_megahit_{sample}
"""

[rules.resources]
threads = 8
memory = "14G"
time_limit = "4h"

[rules.environment]
conda = "envs/dastool.yaml"

# RENAME_POSTDASTOOL (label process_single; one per assembler). The unbinned
# file is renamed to {assembler}-DASToolUnbinned-{sample}.fa and all bins are
# re-compressed; the refined bins and the unbinned file are published to
# results/GenomeBinning/DASTool/{bins,unbinned} (upstream publishDir).
[[rules]]
name = "dastool_rename_post_spades"
when = "config.refine_bins_dastool"
input = ["intermediates/refinement/dastool/SPAdes-DASTool-{sample}_DASTool_bins"]
output = [
    "{config.out_dir}/GenomeBinning/DASTool/bins",
    "{config.out_dir}/GenomeBinning/DASTool/unbinned",
]
depends_on = ["dastool_dastool_spades"]
description = "Rename the unbinned file and re-compress the SPAdes DAS Tool bins (upstream RENAME_POSTDASTOOL)"
shell = """
wd=$(pwd)
mkdir -p {config.out_dir}/GenomeBinning/DASTool/bins {config.out_dir}/GenomeBinning/DASTool/unbinned
mkdir -p .tmp/dastool_rename_post_spades_{sample} && cd .tmp/dastool_rename_post_spades_{sample}
for f in "$wd/intermediates/refinement/dastool/SPAdes-DASTool-{sample}_DASTool_bins/"*.fa; do
    [ -e "$f" ] || continue
    ln -sf "$f" .
done
if [ -f unbinned.fa ]; then
    mv unbinned.fa SPAdes-DASToolUnbinned-{sample}.fa
fi
# re-compress bins to match the gzipped bins used across the rest of the pipeline
if ls *.fa >/dev/null 2>&1; then
    gzip -f *.fa
fi
# the refined bins keep their original binner names ({assembler}-{binner}Refined-...)
for f in SPAdes-*Refined-{sample}.*.fa.gz; do
    [ -e "$f" ] || continue
    mv "$f" "$wd/{config.out_dir}/GenomeBinning/DASTool/bins/"
done
for f in SPAdes-DASToolUnbinned-{sample}.fa.gz; do
    [ -e "$f" ] || continue
    mv "$f" "$wd/{config.out_dir}/GenomeBinning/DASTool/unbinned/"
done
cd "$wd"
rm -rf .tmp/dastool_rename_post_spades_{sample}
"""

[rules.resources]
threads = 1
memory = "4G"
time_limit = "4h"

[rules.environment]
conda = "envs/gunzip.yaml"

[[rules]]
name = "dastool_rename_post_megahit"
when = "config.refine_bins_dastool"
input = ["intermediates/refinement/dastool/MEGAHIT-DASTool-{sample}_DASTool_bins"]
output = [
    "{config.out_dir}/GenomeBinning/DASTool/bins",
    "{config.out_dir}/GenomeBinning/DASTool/unbinned",
]
depends_on = ["dastool_dastool_megahit"]
description = "Rename the unbinned file and re-compress the MEGAHIT DAS Tool bins (upstream RENAME_POSTDASTOOL)"
shell = """
wd=$(pwd)
mkdir -p {config.out_dir}/GenomeBinning/DASTool/bins {config.out_dir}/GenomeBinning/DASTool/unbinned
mkdir -p .tmp/dastool_rename_post_megahit_{sample} && cd .tmp/dastool_rename_post_megahit_{sample}
for f in "$wd/intermediates/refinement/dastool/MEGAHIT-DASTool-{sample}_DASTool_bins/"*.fa; do
    [ -e "$f" ] || continue
    ln -sf "$f" .
done
if [ -f unbinned.fa ]; then
    mv unbinned.fa MEGAHIT-DASToolUnbinned-{sample}.fa
fi
# re-compress bins to match the gzipped bins used across the rest of the pipeline
if ls *.fa >/dev/null 2>&1; then
    gzip -f *.fa
fi
# the refined bins keep their original binner names ({assembler}-{binner}Refined-...)
for f in MEGAHIT-*Refined-{sample}.*.fa.gz; do
    [ -e "$f" ] || continue
    mv "$f" "$wd/{config.out_dir}/GenomeBinning/DASTool/bins/"
done
for f in MEGAHIT-DASToolUnbinned-{sample}.fa.gz; do
    [ -e "$f" ] || continue
    mv "$f" "$wd/{config.out_dir}/GenomeBinning/DASTool/unbinned/"
done
cd "$wd"
rm -rf .tmp/dastool_rename_post_megahit_{sample}
"""

[rules.resources]
threads = 1
memory = "4G"
time_limit = "4h"

[rules.environment]
conda = "envs/gunzip.yaml"
