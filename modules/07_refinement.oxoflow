[workflow]
name = "07_refinement"
description = "nf-core/mag 5.5.0 binning_refinement fragment (--refine_bins_dastool; off by default)"
# ---------------------------------------------------------------------------
# BINNING REFINEMENT (nf-core/mag 5.5.0, gated on config.refine_bins_dastool):
# per (assembler, binner, sample) RENAME_PREDASTOOL decompresses and renames
# the bins to {assembler}-{binner}Refined-{sample}.{num}.fa, then
# DASTOOL_FASTATOCONTIG2BIN builds the contig2bin table, then one
# DASTOOL_DASTOOL per (assembler, sample) fuses the six binners with
# DAS_Tool, and RENAME_POSTDASTOOL renames unbinned.fa and re-compresses the
# refined bins for publication. Everything is when-gated on
# config.refine_bins_dastool (upstream params.refine_bins_dastool=false), so
# the default plan is untouched.
# ---------------------------------------------------------------------------

# RENAME_PREDASTOOL (label process_single; regex rename + gunzip). Each rule
# handles one (assembler, binner) pair; zero-bin groups emit an empty dir.
[[rules]]
name = "dastool_rename_pre_spades_metabat2"
when = "config.refine_bins_dastool"
input = ["{config.out_dir}/GenomeBinning/MetaBAT2/bins"]
output = ["intermediates/refinement/renamed_bins/SPAdes-MetaBAT2Refined-{sample}"]
depends_on = ["metabat2_spades"]
description = "Rename and decompress the SPAdes MetaBAT2 bins for DAS Tool (upstream RENAME_PREDASTOOL)"
shell = """
wd=$(pwd)
outdir=intermediates/refinement/renamed_bins/SPAdes-MetaBAT2Refined-{sample}
mkdir -p "$outdir"
for bin in "$wd/{config.out_dir}/GenomeBinning/MetaBAT2/bins/SPAdes-MetaBAT2-{sample}"*.fa.gz; do
    [ -e "$bin" ] || continue
    base=$(basename "$bin" .gz)
    # DAS Tool works on uncompressed fasta, so decompress gzipped bins first
    if [[ "$base" =~ SPAdes-MetaBAT2-{sample}.([_[:alnum:]]+).fa ]]; then
        num=${BASH_REMATCH[1]}
        gzip -cdf "$bin" > "$wd/$outdir/SPAdes-MetaBAT2Refined-{sample}.${num}.fa"
    else
        echo "ERROR: the bin filename $base does not match the expected format 'SPAdes-MetaBAT2-{sample}.([_[:alnum:]]+).fa'!" 1>&2
        exit 1
    fi
done
"""

[rules.resources]
threads = 1
memory = "4G"
time_limit = "4h"

[rules.environment]
conda = "envs/gunzip.yaml"

[[rules]]
name = "dastool_rename_pre_spades_maxbin2"
when = "config.refine_bins_dastool"
input = ["{config.out_dir}/GenomeBinning/MaxBin2/bins"]
output = ["intermediates/refinement/renamed_bins/SPAdes-MaxBin2Refined-{sample}"]
depends_on = ["maxbin2_spades"]
description = "Rename and decompress the SPAdes MaxBin2 bins for DAS Tool (upstream RENAME_PREDASTOOL)"
shell = """
wd=$(pwd)
outdir=intermediates/refinement/renamed_bins/SPAdes-MaxBin2Refined-{sample}
mkdir -p "$outdir"
for bin in "$wd/{config.out_dir}/GenomeBinning/MaxBin2/bins/SPAdes-MaxBin2-{sample}"*.fa.gz; do
    [ -e "$bin" ] || continue
    base=$(basename "$bin" .gz)
    # DAS Tool works on uncompressed fasta, so decompress gzipped bins first
    if [[ "$base" =~ SPAdes-MaxBin2-{sample}.([_[:alnum:]]+).fa ]]; then
        num=${BASH_REMATCH[1]}
        gzip -cdf "$bin" > "$wd/$outdir/SPAdes-MaxBin2Refined-{sample}.${num}.fa"
    else
        echo "ERROR: the bin filename $base does not match the expected format 'SPAdes-MaxBin2-{sample}.([_[:alnum:]]+).fa'!" 1>&2
        exit 1
    fi
done
"""

[rules.resources]
threads = 1
memory = "4G"
time_limit = "4h"

[rules.environment]
conda = "envs/gunzip.yaml"

[[rules]]
name = "dastool_rename_pre_spades_concoct"
when = "config.refine_bins_dastool"
input = ["{config.out_dir}/GenomeBinning/CONCOCT/bins"]
