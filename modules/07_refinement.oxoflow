when = "config.refine_bins_dastool"
input = ["intermediates/refinement/renamed_bins/MEGAHIT-SemiBin2Refined-{sample}"]
output = ["intermediates/refinement/contig2bin/MEGAHIT-SemiBin2-{sample}_contiglist.tsv"]
depends_on = ["dastool_rename_pre_megahit_semibin2"]
description = "Contig-to-bin table for the MEGAHIT SemiBin2 refined bins (upstream DASTOOL_FASTATOCONTIG2BIN)"
shell = """
wd=$(pwd)
mkdir -p intermediates/refinement/contig2bin
