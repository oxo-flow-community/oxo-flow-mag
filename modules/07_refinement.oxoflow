for f in "$wd/intermediates/refinement/renamed_bins/MEGAHIT-SemiBin2Refined-{sample}"/*.fa; do
    [ -e "$f" ] || continue
    ln -sf "$f" .
done
if ls *.fa >/dev/null 2>&1; then
    Fasta_to_Contig2Bin.sh -i . -e fa > "$wd/intermediates/refinement/contig2bin/MEGAHIT-SemiBin2-{sample}_contiglist.tsv"
else
    touch "$wd/intermediates/refinement/contig2bin/MEGAHIT-SemiBin2-{sample}_contiglist.tsv"
