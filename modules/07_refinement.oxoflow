        exit 1
    fi
done
"""

[rules.resources]
threads = 1
memory = "4G"
time_limit = "4h"

[rules.environment]
conda = "envs/gunzip.yaml"

# DASTOOL_FASTATOCONTIG2BIN (label process_single; -i . -e fa on the renamed
# bins). Zero-bin groups emit an empty tsv so the declared output holds; the
# dastool rule skips empty tsvs (upstream channel semantics: binners with no
# bins never reach DAS Tool).
[[rules]]
name = "dastool_fastatocontig2bin_spades_metabat2"
when = "config.refine_bins_dastool"
input = ["intermediates/refinement/renamed_bins/SPAdes-MetaBAT2Refined-{sample}"]
output = ["intermediates/refinement/contig2bin/SPAdes-MetaBAT2-{sample}_contiglist.tsv"]
depends_on = ["dastool_rename_pre_spades_metabat2"]
description = "Contig-to-bin table for the SPAdes MetaBAT2 refined bins (upstream DASTOOL_FASTATOCONTIG2BIN)"
shell = """
wd=$(pwd)
mkdir -p intermediates/refinement/contig2bin
mkdir -p .tmp/dastool_f2c2b_spades_metabat2_{sample} && cd .tmp/dastool_f2c2b_spades_metabat2_{sample}
for f in "$wd/intermediates/refinement/renamed_bins/SPAdes-MetaBAT2Refined-{sample}"/*.fa; do
    [ -e "$f" ] || continue
    ln -sf "$f" .
done
if ls *.fa >/dev/null 2>&1; then
    Fasta_to_Contig2Bin.sh -i . -e fa > "$wd/intermediates/refinement/contig2bin/SPAdes-MetaBAT2-{sample}_contiglist.tsv"
else
    touch "$wd/intermediates/refinement/contig2bin/SPAdes-MetaBAT2-{sample}_contiglist.tsv"
fi
cd "$wd"
rm -rf .tmp/dastool_f2c2b_spades_metabat2_{sample}
"""

