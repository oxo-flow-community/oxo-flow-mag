[workflow]
name = "11_ancient_dna"
description = "nf-core/mag 5.5.0 ancient_dna fragment (upstream params.ancient_dna, default false)"
# ---------------------------------------------------------------------------
# ANCIENT_DNA (nf-core/mag 5.5.0, gated on config.ancient_dna):
# ANCIENT_DNA_ASSEMBLY_VALIDATION runs pydamage analyze/filter on the
# binning-prep own-alignment BAMs, then freebayes + bcftools consensus
# produce damage-corrected contigs; BINNING_PYDAMAGE summarises per-bin
# damage into pydamage_bins_summary.tsv (consumed by bin_summary via
# combine_tables.py --pydamagebins_summary).
#
# Every rule is when-gated on config.ancient_dna (upstream default false),
# so the default plan prunes the whole family at plan time.
# ---------------------------------------------------------------------------
[[rules]]
name = "pydamage_analyze_spades"
when = "config.ancient_dna"
input = [
    "intermediates/binning/alignments/SPAdes/SPAdes-{sample}.bam",
    "intermediates/binning/alignments/SPAdes/SPAdes-{sample}.bam.bai",
]
output = [
    "intermediates/ancient_dna/SPAdes/SPAdes-{sample}_pydamage_results.csv",
]
depends_on = ["bowtie2_align_spades"]
description = "pydamage analyze on the SPAdes own-alignment BAM (upstream PYDAMAGE_ANALYZE via ANCIENT_DNA_ASSEMBLY_VALIDATION)"
shell = """
wd=$(pwd)
mkdir -p intermediates/ancient_dna/SPAdes
mkdir -p .tmp/pydamage_analyze_spades_{sample} && cd .tmp/pydamage_analyze_spades_{sample}
export NUMBA_CACHE_DIR=./tmp
export MPLCONFIGDIR=./tmp
ln -sf "$wd/intermediates/binning/alignments/SPAdes/SPAdes-{sample}.bam" .
ln -sf "$wd/intermediates/binning/alignments/SPAdes/SPAdes-{sample}.bam.bai" .
pydamage analyze -p {threads} SPAdes-{sample}.bam
mv pydamage_results/pydamage_results.csv "$wd/intermediates/ancient_dna/SPAdes/SPAdes-{sample}_pydamage_results.csv"
cd "$wd"
rm -rf .tmp/pydamage_analyze_spades_{sample}
"""

[rules.resources]
threads = 2
memory = "8G"
time_limit = "8h"

[rules.environment]
conda = "envs/pydamage.yaml"

[[rules]]
name = "pydamage_analyze_megahit"
when = "config.ancient_dna"
input = [
    "intermediates/binning/alignments/MEGAHIT/MEGAHIT-{sample}.bam",
    "intermediates/binning/alignments/MEGAHIT/MEGAHIT-{sample}.bam.bai",
]
output = [
    "intermediates/ancient_dna/MEGAHIT/MEGAHIT-{sample}_pydamage_results.csv",
]
depends_on = ["bowtie2_align_megahit"]
description = "pydamage analyze on the MEGAHIT own-alignment BAM (upstream PYDAMAGE_ANALYZE via ANCIENT_DNA_ASSEMBLY_VALIDATION)"
shell = """
wd=$(pwd)
mkdir -p intermediates/ancient_dna/MEGAHIT
mkdir -p .tmp/pydamage_analyze_megahit_{sample} && cd .tmp/pydamage_analyze_megahit_{sample}
export NUMBA_CACHE_DIR=./tmp
export MPLCONFIGDIR=./tmp
ln -sf "$wd/intermediates/binning/alignments/MEGAHIT/MEGAHIT-{sample}.bam" .
ln -sf "$wd/intermediates/binning/alignments/MEGAHIT/MEGAHIT-{sample}.bam.bai" .
pydamage analyze -p {threads} MEGAHIT-{sample}.bam
mv pydamage_results/pydamage_results.csv "$wd/intermediates/ancient_dna/MEGAHIT/MEGAHIT-{sample}_pydamage_results.csv"
cd "$wd"
rm -rf .tmp/pydamage_analyze_megahit_{sample}
"""

[rules.resources]
threads = 2
memory = "8G"
time_limit = "8h"

[rules.environment]
conda = "envs/pydamage.yaml"

[[rules]]
name = "pydamage_filter_spades"
when = "config.ancient_dna"
input = ["intermediates/ancient_dna/SPAdes/SPAdes-{sample}_pydamage_results.csv"]
output = [
    "intermediates/ancient_dna/SPAdes/SPAdes-{sample}_pydamage_filtered_results.csv",
]
depends_on = ["pydamage_analyze_spades"]
description = "pydamage filter on the SPAdes analyze results (upstream PYDAMAGE_FILTER)"
shell = """
wd=$(pwd)
mkdir -p .tmp/pydamage_filter_spades_{sample} && cd .tmp/pydamage_filter_spades_{sample}
export NUMBA_CACHE_DIR=./tmp
export MPLCONFIGDIR=./tmp
cp "$wd/intermediates/ancient_dna/SPAdes/SPAdes-{sample}_pydamage_results.csv" .
pydamage filter SPAdes-{sample}_pydamage_results.csv
mv pydamage_results/pydamage_filtered_results.csv "$wd/intermediates/ancient_dna/SPAdes/SPAdes-{sample}_pydamage_filtered_results.csv"
cd "$wd"
rm -rf .tmp/pydamage_filter_spades_{sample}
"""

[rules.resources]
threads = 1
memory = "6G"
time_limit = "4h"

[rules.environment]
conda = "envs/pydamage.yaml"

[[rules]]
name = "pydamage_filter_megahit"
when = "config.ancient_dna"
input = ["intermediates/ancient_dna/MEGAHIT/MEGAHIT-{sample}_pydamage_results.csv"]
output = [
    "intermediates/ancient_dna/MEGAHIT/MEGAHIT-{sample}_pydamage_filtered_results.csv",
]
depends_on = ["pydamage_analyze_megahit"]
description = "pydamage filter on the MEGAHIT analyze results (upstream PYDAMAGE_FILTER)"
shell = """
wd=$(pwd)
mkdir -p .tmp/pydamage_filter_megahit_{sample} && cd .tmp/pydamage_filter_megahit_{sample}
export NUMBA_CACHE_DIR=./tmp
export MPLCONFIGDIR=./tmp
cp "$wd/intermediates/ancient_dna/MEGAHIT/MEGAHIT-{sample}_pydamage_results.csv" .
pydamage filter MEGAHIT-{sample}_pydamage_results.csv
mv pydamage_results/pydamage_filtered_results.csv "$wd/intermediates/ancient_dna/MEGAHIT/MEGAHIT-{sample}_pydamage_filtered_results.csv"
cd "$wd"
rm -rf .tmp/pydamage_filter_megahit_{sample}
"""

[rules.resources]
threads = 1
memory = "6G"
time_limit = "4h"

[rules.environment]
conda = "envs/pydamage.yaml"

[[rules]]
name = "ancient_consensus_spades"
when = "config.ancient_dna"
input = [
    "intermediates/assembly/SPAdes/SPAdes-{sample}.scaffolds.fa",
    "intermediates/binning/alignments/SPAdes/SPAdes-{sample}.bam",
    "intermediates/binning/alignments/SPAdes/SPAdes-{sample}.bam.bai",
    "intermediates/ancient_dna/SPAdes/SPAdes-{sample}_pydamage_filtered_results.csv",
]
output = [
    "intermediates/assembly/SPAdes/SPAdes-{sample}.scaffolds.corrected.fa",
    "intermediates/ancient_dna/SPAdes/SPAdes-{sample}_recalibrated.vcf.gz",
]
depends_on = ["pydamage_filter_spades", "bowtie2_align_spades", "gunzip_spades"]
description = "freebayes recall + bcftools consensus over the damage-filtered positions (upstream FREEBAYES/BCFTOOLS_INDEX/BCFTOOLS_VIEW/BCFTOOLS_CONSENSUS)"
shell = """
wd=$(pwd)
mkdir -p .tmp/ancient_consensus_spades_{sample} && cd .tmp/ancient_consensus_spades_{sample}
ln -sf "$wd/intermediates/assembly/SPAdes/SPAdes-{sample}.scaffolds.fa" ref.fa
samtools faidx ref.fa
ln -sf "$wd/intermediates/binning/alignments/SPAdes/SPAdes-{sample}.bam" .
ln -sf "$wd/intermediates/binning/alignments/SPAdes/SPAdes-{sample}.bam.bai" .
# freebayes recall (upstream aDNA branch passes no ext.args)
freebayes -f ref.fa SPAdes-{sample}.bam > recal.vcf
bgzip -c recal.vcf > "$wd/intermediates/ancient_dna/SPAdes/SPAdes-{sample}_recalibrated.vcf.gz"
tabix -p vcf "$wd/intermediates/ancient_dna/SPAdes/SPAdes-{sample}_recalibrated.vcf.gz"
# bcftools consensus applies the recalibrated variants to the assembly
# (upstream BCFTOOLS_VIEW default args pass the whole VCF; the pydamage
# filter output feeds the per-bin summary, not the consensus call)
bcftools consensus "$wd/intermediates/ancient_dna/SPAdes/SPAdes-{sample}_recalibrated.vcf.gz" < ref.fa > consensus.fa
mv consensus.fa "$wd/intermediates/assembly/SPAdes/SPAdes-{sample}.scaffolds.corrected.fa"
cd "$wd"
rm -rf .tmp/ancient_consensus_spades_{sample}
"""

[rules.resources]
threads = 4
memory = "10G"
time_limit = "12h"

[rules.environment]
conda = "envs/freebayes.yaml"

[[rules]]
name = "ancient_consensus_megahit"
when = "config.ancient_dna"
input = [
    "intermediates/assembly/MEGAHIT/MEGAHIT-{sample}.contigs.fa",
    "intermediates/binning/alignments/MEGAHIT/MEGAHIT-{sample}.bam",
    "intermediates/binning/alignments/MEGAHIT/MEGAHIT-{sample}.bam.bai",
    "intermediates/ancient_dna/MEGAHIT/MEGAHIT-{sample}_pydamage_filtered_results.csv",
]
output = [
    "intermediates/assembly/MEGAHIT/MEGAHIT-{sample}.contigs.corrected.fa",
    "intermediates/ancient_dna/MEGAHIT/MEGAHIT-{sample}_recalibrated.vcf.gz",
]
depends_on = ["pydamage_filter_megahit", "bowtie2_align_megahit", "gunzip_megahit"]
description = "freebayes recall + bcftools consensus over the damage-filtered positions (upstream FREEBAYES/BCFTOOLS chain, MEGAHIT assembly)"
shell = """
wd=$(pwd)
mkdir -p .tmp/ancient_consensus_megahit_{sample} && cd .tmp/ancient_consensus_megahit_{sample}
ln -sf "$wd/intermediates/assembly/MEGAHIT/MEGAHIT-{sample}.contigs.fa" ref.fa
samtools faidx ref.fa
ln -sf "$wd/intermediates/binning/alignments/MEGAHIT/MEGAHIT-{sample}.bam" .
ln -sf "$wd/intermediates/binning/alignments/MEGAHIT/MEGAHIT-{sample}.bam.bai" .
freebayes -f ref.fa MEGAHIT-{sample}.bam > recal.vcf
bgzip -c recal.vcf > "$wd/intermediates/ancient_dna/MEGAHIT/MEGAHIT-{sample}_recalibrated.vcf.gz"
tabix -p vcf "$wd/intermediates/ancient_dna/MEGAHIT/MEGAHIT-{sample}_recalibrated.vcf.gz"
bcftools consensus "$wd/intermediates/ancient_dna/MEGAHIT/MEGAHIT-{sample}_recalibrated.vcf.gz" < ref.fa > consensus.fa
mv consensus.fa "$wd/intermediates/assembly/MEGAHIT/MEGAHIT-{sample}.contigs.corrected.fa"
cd "$wd"
rm -rf .tmp/ancient_consensus_megahit_{sample}
"""

[rules.resources]
threads = 4
memory = "10G"
time_limit = "12h"

[rules.environment]
conda = "envs/freebayes.yaml"

[[rules]]
name = "pydamage_bins_summary"
when = "config.ancient_dna"
input = [
    "{config.out_dir}/GenomeBinning/MetaBAT2/bins",
]
output = [
    "{config.out_dir}/GenomeBinning/QC/pydamage_bins_summary.tsv",
]
depends_on = ["pydamage_analyze_spades", "pydamage_analyze_megahit", "metabat2_spades"]
description = "Per-bin median pydamage statistics (upstream BINNING_PYDAMAGE via summarise_pydamagebins.py)"
shell = """
wd=$(pwd)
mkdir -p {config.out_dir}/GenomeBinning/QC
# contig2bin: rebuild in-rule from the published bins (the same
# Fasta_to_Contig2Bin contract DAS Tool uses, scoped to MetaBAT2 SPAdes
# bins — the bin set bin_summary rows are keyed on)
MAP=$(mktemp)
for f in "$wd"/{config.out_dir}/GenomeBinning/MetaBAT2/bins/SPAdes-MetaBAT2-{sample}*.fa.gz; do
    [ -e "$f" ] || continue
    bin=$(basename "$f" .fa.gz)
    gunzip -c "$f" | awk -v b="$bin" '/^>/{print b "\\t" substr($1,2)}' >> "$MAP"
done
python3 "$wd/scripts/summarise_pydamagebins.py" \
    --contig-to-bin-map "$MAP" \
    --output "$wd/{config.out_dir}/GenomeBinning/QC/pydamage_bins_summary.tsv" \
    --verbose \
    "$wd"/intermediates/ancient_dna/*/*_pydamage_results.csv
rm -f "$MAP"
"""

[rules.resources]
threads = 1
memory = "6G"
time_limit = "4h"

[rules.environment]
conda = "envs/bin_summary.yaml"
