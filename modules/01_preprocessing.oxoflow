[workflow]
name = "01_preprocessing"
description = "nf-core/mag 5.5.0 01_preprocessing fragment"
# ---------------------------------------------------------------------------
# SHORTREAD_PREPROCESSING (nf-core/mag 5.5.0):
# FASTQC_RAW -> {clip_tool: FASTP | ADAPTERREMOVAL_PE | TRIMMOMATIC} ->
# BOWTIE2_REMOVAL_BUILD/ALIGN (--host_fasta, off by default) ->
# BOWTIE2_PHIX_REMOVAL_BUILD -> BOWTIE2_PHIX_REMOVAL_ALIGN -> FASTQC_TRIMMED
# -> BBMAP_BBNORM (--bbnorm, off by default). Lane merging and
# assembly_input are not ported (off by default).
#
# The clip-tool switch is a when-gated same-output branch (empirically
# validated on the engine): exactly one clip rule fires per config.clip_tool
# value; phix_align consumes whichever clipped reads exist via a shell
# precedence chain, mirroring the upstream channel wiring where the host
# removal output supersedes the clipped reads.
# ---------------------------------------------------------------------------

# FASTQC_RAW (label process_low, ext.args '--quiet', prefix {id}_run{run}_raw)
[[rules]]
name = "fastqc_raw"
input = [
    "{config.input_dir}/{sample}_R1.fastq.gz",
    "{config.input_dir}/{sample}_R2.fastq.gz",
]
output = [
    "{config.out_dir}/QC_shortreads/fastqc/{sample}_run1_raw_1_fastqc.html",
    "{config.out_dir}/QC_shortreads/fastqc/{sample}_run1_raw_2_fastqc.html",
]
description = "Run FastQC on the raw reads (upstream FASTQC_RAW)"
shell = """
# upstream renames reads to <prefix>_1/2.fastq.gz for consistent MultiQC naming
ln -sf {input[0]} {sample}_run1_raw_1.fastq.gz
ln -sf {input[1]} {sample}_run1_raw_2.fastq.gz
# --memory = task.memory (12G) / task.cpus (2) in MB (label process_low)
fastqc \\
    --quiet \\
    --threads {threads} \\
    --memory $(( {effective_memory_mb} / 4 )) \\
    {sample}_run1_raw_1.fastq.gz \\
    {sample}_run1_raw_2.fastq.gz
mkdir -p {config.out_dir}/QC_shortreads/fastqc
mv {sample}_run1_raw_1_fastqc.html {output[0]}
mv {sample}_run1_raw_2_fastqc.html {output[1]}
# the fastqc zip archives stay in the rule scratch dir: upstream FASTQC_RAW
# publishes *.html only (conf/modules.config)
"""

[rules.resources]
threads = 2
memory = "12G"
time_limit = "4h"

[rules.environment]
conda = "envs/fastqc.yaml"

# FASTP (label process_medium + 8GB override, prefix {id}_run{run}_fastp;
# upstream default clip_tool=fastp, so the gate is on by default)
[[rules]]
name = "fastp"
when = "config.clip_tool == 'fastp'"
input = [
    "{config.input_dir}/{sample}_R1.fastq.gz",
    "{config.input_dir}/{sample}_R2.fastq.gz",
]
output = [
    "intermediates/QC_shortreads/fastp/{sample}_run1_fastp_1.fastp.fastq.gz",
    "intermediates/QC_shortreads/fastp/{sample}_run1_fastp_2.fastp.fastq.gz",
    "{config.out_dir}/QC_shortreads/fastp/{sample}/{sample}_run1_fastp.fastp.json",
    "{config.out_dir}/QC_shortreads/fastp/{sample}/{sample}_run1_fastp.fastp.html",
    "intermediates/QC_shortreads/fastp/{sample}_run1_fastp.fastp.log",
]
description = "Adapter and quality trimming with fastp (upstream FASTP)"
shell = """
mkdir -p intermediates/QC_shortreads/fastp {config.out_dir}/QC_shortreads/fastp/{sample}
ln -sf {input[0]} {sample}_run1_fastp_1.fastq.gz
ln -sf {input[1]} {sample}_run1_fastp_2.fastq.gz
# upstream: 2>| >(tee ...) process substitution is not available in the
# oxo-flow sh -c executor; the log is captured with a plain redirect instead
# upstream: params.fastp_trim_polyg ? "--trim_poly_g" : ''
if [ "{config.fastp_trim_polyg}" = "true" ]; then
    fastp_polyg="--trim_poly_g"
else
    fastp_polyg=""
fi
fastp \\
    --in1 {sample}_run1_fastp_1.fastq.gz \\
    --in2 {sample}_run1_fastp_2.fastq.gz \\
    --out1 {sample}_run1_fastp_1.fastp.fastq.gz \\
    --out2 {sample}_run1_fastp_2.fastp.fastq.gz \\
    --json {sample}_run1_fastp.fastp.json \\
    --html {sample}_run1_fastp.fastp.html \\
    --thread {threads} \\
    --detect_adapter_for_pe \\
    -q {config.fastp_qualified_quality} \\
    --cut_front \\
    --cut_tail \\
    --cut_mean_quality {config.fastp_cut_mean_quality} \\
    --length_required {config.reads_minlength} \\
    $fastp_polyg \\
    2> {sample}_run1_fastp.fastp.log
mv {sample}_run1_fastp_1.fastp.fastq.gz intermediates/QC_shortreads/fastp/
mv {sample}_run1_fastp_2.fastp.fastq.gz intermediates/QC_shortreads/fastp/
mv {sample}_run1_fastp.fastp.json {config.out_dir}/QC_shortreads/fastp/{sample}/
mv {sample}_run1_fastp.fastp.html {config.out_dir}/QC_shortreads/fastp/{sample}/
mv {sample}_run1_fastp.fastp.log intermediates/QC_shortreads/fastp/
"""

[rules.resources]
threads = 6
memory = "8G"
time_limit = "8h"

[rules.environment]
conda = "envs/fastp.yaml"

# ADAPTERREMOVAL_PE (label process_medium, prefix {id}_run{run}_ar2; upstream
# conf/modules.config ADAPTERREMOVAL_PE ext.args)
[[rules]]
name = "adapterremoval_pe"
when = "config.clip_tool == 'adapterremoval'"
input = [
    "{config.input_dir}/{sample}_R1.fastq.gz",
    "{config.input_dir}/{sample}_R2.fastq.gz",
]
output = [
    "intermediates/QC_shortreads/adapterremoval/{sample}_run1_ar2.pair1.truncated.fastq.gz",
    "intermediates/QC_shortreads/adapterremoval/{sample}_run1_ar2.pair2.truncated.fastq.gz",
    "{config.out_dir}/QC_shortreads/adapterremoval/{sample}/{sample}_run1_ar2.settings",
]
description = "Adapter and quality trimming with AdapterRemoval (upstream ADAPTERREMOVAL_PE)"
shell = """
mkdir -p intermediates/QC_shortreads/adapterremoval {config.out_dir}/QC_shortreads/adapterremoval/{sample}
ln -sf {input[0]} {sample}_run1_ar2_1.fastq.gz
ln -sf {input[1]} {sample}_run1_ar2_2.fastq.gz
# upstream ext.args (conf/modules.config ADAPTERREMOVAL_PE):
# --minlength / --adapter1 / --adapter2 / --minquality / --trimns /
# --trimwindows 4 (or --trim_qualities when adapterremoval_trim_quality_stretch)
if [ "{config.adapterremoval_trim_quality_stretch}" = "true" ]; then
    trim_arg="--trim_qualities"
else
    trim_arg="--trimwindows 4"
fi
AdapterRemoval \\
    --file1 {sample}_run1_ar2_1.fastq.gz \\
    --file2 {sample}_run1_ar2_2.fastq.gz \\
    --minlength {config.reads_minlength} \\
    --adapter1 {config.adapterremoval_adapter1} \\
    --adapter2 {config.adapterremoval_adapter2} \\
    --minquality {config.adapterremoval_minquality} \\
    --trimns \\
    $trim_arg \\
    --basename {sample}_run1_ar2 \\
    --threads {threads} \\
    --seed 42 \\
    --gzip
# upstream ensure_fastq(): AdapterRemoval names outputs .gz, not .fastq.gz
for f in {sample}_run1_ar2.pair1.truncated.gz {sample}_run1_ar2.pair2.truncated.gz; do
    [ -f "$f" ] && mv "$f" "${f::-3}.fastq.gz"
done
mv {sample}_run1_ar2.pair1.truncated.fastq.gz intermediates/QC_shortreads/adapterremoval/
mv {sample}_run1_ar2.pair2.truncated.fastq.gz intermediates/QC_shortreads/adapterremoval/
mv {sample}_run1_ar2.settings {config.out_dir}/QC_shortreads/adapterremoval/{sample}/
"""

[rules.resources]
threads = 6
memory = "8G"
time_limit = "8h"

[rules.environment]
conda = "envs/adapterremoval.yaml"

# TRIMMOMATIC (label process_medium, prefix {id}_run{run}_trimmomatic; upstream
# conf/modules.config TRIMMOMATIC ext.args)
[[rules]]
name = "trimmomatic"
when = "config.clip_tool == 'trimmomatic'"
input = [
    "{config.input_dir}/{sample}_R1.fastq.gz",
    "{config.input_dir}/{sample}_R2.fastq.gz",
]
output = [
    "intermediates/QC_shortreads/trimmomatic/{sample}_run1_trimmomatic.paired.trim_1.fastq.gz",
    "intermediates/QC_shortreads/trimmomatic/{sample}_run1_trimmomatic.paired.trim_2.fastq.gz",
    "intermediates/QC_shortreads/trimmomatic/{sample}_run1_trimmomatic.unpaired.trim_1.fastq.gz",
    "intermediates/QC_shortreads/trimmomatic/{sample}_run1_trimmomatic.unpaired.trim_2.fastq.gz",
    "{config.out_dir}/QC_shortreads/trimmomatic/{sample}/{sample}_run1_trimmomatic_trim.log",
]
description = "Adapter and quality trimming with Trimmomatic (upstream TRIMMOMATIC)"
shell = """
mkdir -p intermediates/QC_shortreads/trimmomatic {config.out_dir}/QC_shortreads/trimmomatic/{sample}
# upstream renames reads to <prefix>_1/2.fastq.gz; the module names its own
# outputs, so the ln -sf names are free
ln -sf {input[0]} {sample}_run1_trimmomatic_1.fastq.gz
ln -sf {input[1]} {sample}_run1_trimmomatic_2.fastq.gz
# upstream: 2>| >(tee ...) process substitution is not available in the
# oxo-flow sh -c executor; the log is captured with a plain redirect instead
trimmomatic \\
    PE \\
    -threads {threads} \\
    -trimlog {sample}_run1_trimmomatic_trim.log \\
    -summary {sample}_run1_trimmomatic.summary \\
    {sample}_run1_trimmomatic_1.fastq.gz \\
    {sample}_run1_trimmomatic_2.fastq.gz \\
    {sample}_run1_trimmomatic.paired.trim_1.fastq.gz \\
    {sample}_run1_trimmomatic.unpaired.trim_1.fastq.gz \\
    {sample}_run1_trimmomatic.paired.trim_2.fastq.gz \\
    {sample}_run1_trimmomatic.unpaired.trim_2.fastq.gz \\
    LEADING:30 TRAILING:30 SLIDINGWINDOW:4:20 MINLEN:35 \\
    2> {sample}_run1_trimmomatic_out.log
mv {sample}_run1_trimmomatic.paired.trim_1.fastq.gz intermediates/QC_shortreads/trimmomatic/
mv {sample}_run1_trimmomatic.paired.trim_2.fastq.gz intermediates/QC_shortreads/trimmomatic/
mv {sample}_run1_trimmomatic.unpaired.trim_1.fastq.gz intermediates/QC_shortreads/trimmomatic/
mv {sample}_run1_trimmomatic.unpaired.trim_2.fastq.gz intermediates/QC_shortreads/trimmomatic/
mv {sample}_run1_trimmomatic_trim.log {config.out_dir}/QC_shortreads/trimmomatic/{sample}/
"""

[rules.resources]
threads = 6
memory = "8G"
time_limit = "8h"

[rules.environment]
conda = "envs/trimmomatic.yaml"

# BOWTIE2_PHIX_REMOVAL_BUILD (single instance; builds the phiX index once)
[[rules]]
name = "phix_build"
input = ["{config.phix_reference}"]
output = [
    "intermediates/binning/phix_index/GCA_002596845.1_ASM259684v1_genomic.fna.1.bt2",
    "intermediates/binning/phix_index/GCA_002596845.1_ASM259684v1_genomic.fna.rev.1.bt2",
]
description = "Build the bowtie2 index for phiX read removal (upstream BOWTIE2_PHIX_REMOVAL_BUILD)"
shell = """
wd=$(pwd)
mkdir -p intermediates/binning/phix_index
cd intermediates/binning/phix_index
# upstream: bowtie2-build <fasta> <fasta.simpleName>; the phiX reference is
# kept gzipped (bowtie2-build detects it), index base = file name minus .gz
bowtie2-build \\
    --threads {threads} \\
    "$wd/{config.phix_reference}" \\
    GCA_002596845.1_ASM259684v1_genomic.fna
cd "$wd"
"""

[rules.resources]
threads = 1
memory = "6G"
time_limit = "4h"

[rules.environment]
conda = "envs/bowtie2.yaml"

# BOWTIE2_REMOVAL_BUILD (--host_fasta; skipped when a prebuilt index is given)
[[rules]]
name = "host_removal_build"
when = "config.host_fasta != '' && config.host_fasta_bowtie2index == ''"
input = ["{config.host_fasta}"]
output = ["intermediates/binning/host_index"]
description = "Build the bowtie2 index for host read removal (upstream BOWTIE2_REMOVAL_BUILD)"
shell = """
wd=$(pwd)
mkdir -p intermediates/binning/host_index
cd intermediates/binning/host_index
# upstream: bowtie2-build <fasta> <fasta.simpleName>; the reference may be
# gzipped (bowtie2-build detects it), index base = file name minus .gz
base=$(basename "{config.host_fasta}")
base=${base%.gz}
bowtie2-build \\
    --threads {threads} \\
    "$wd/{config.host_fasta}" \\
    "$base"
cd "$wd"
"""

[rules.resources]
threads = 2
memory = "6G"
time_limit = "4h"

[rules.environment]
conda = "envs/bowtie2.yaml"

# BOWTIE2_REMOVAL_ALIGN (8 cpu / 2 GB override, prefix {id}_run{run}_host_removed;
# upstream conf/modules.config BOWTIE2_REMOVAL_ALIGN ext.args --sensitive /
# --very-sensitive)
[[rules]]
name = "host_removal_align"
when = "config.host_fasta != ''"
input = [
    "intermediates/QC_shortreads/fastp/{sample}_run1_fastp_1.fastp.fastq.gz",
    "intermediates/QC_shortreads/fastp/{sample}_run1_fastp_2.fastp.fastq.gz",
    "intermediates/QC_shortreads/adapterremoval/{sample}_run1_ar2.pair1.truncated.fastq.gz",
    "intermediates/QC_shortreads/adapterremoval/{sample}_run1_ar2.pair2.truncated.fastq.gz",
    "intermediates/QC_shortreads/trimmomatic/{sample}_run1_trimmomatic.paired.trim_1.fastq.gz",
    "intermediates/QC_shortreads/trimmomatic/{sample}_run1_trimmomatic.paired.trim_2.fastq.gz",
    "intermediates/binning/host_index",
]
output = [
    "intermediates/QC_shortreads/remove_host/{sample}_run1_host_removed.unmapped_1.fastq.gz",
    "intermediates/QC_shortreads/remove_host/{sample}_run1_host_removed.unmapped_2.fastq.gz",
    "{config.out_dir}/QC_shortreads/remove_host/{sample}_run1_host_removed.bowtie2.log",
]
description = "Remove host reads by bowtie2 mapping (upstream BOWTIE2_REMOVAL_ALIGN)"
depends_on = ["host_removal_build"]
shell = """
mkdir -p intermediates/QC_shortreads/remove_host {config.out_dir}/QC_shortreads/remove_host
# the index comes from the build rule or from the user-supplied prebuilt index
if [ -n "{config.host_fasta_bowtie2index}" ]; then
    INDEX=`find -L {config.host_fasta_bowtie2index} -name "*.rev.1.bt2" | sed "s/\\.rev.1.bt2$//"`
    [ -z "$INDEX" ] && INDEX=`find -L {config.host_fasta_bowtie2index} -name "*.rev.1.bt2l" | sed "s/\\.rev.1.bt2l$//"`
else
    INDEX=`find -L intermediates/binning/host_index -name "*.rev.1.bt2" | sed "s/\\.rev.1.bt2$//"`
    [ -z "$INDEX" ] && INDEX=`find -L intermediates/binning/host_index -name "*.rev.1.bt2l" | sed "s/\\.rev.1.bt2l$//"`
fi
[ -z "$INDEX" ] && echo "Bowtie2 index files not found" 1>&2 && exit 1
# precedence over the clip-tool outputs (upstream: host removal runs on the
# clipped reads; exactly one clip variant exists per clip_tool value)
if [ -f "intermediates/QC_shortreads/fastp/{sample}_run1_fastp_1.fastp.fastq.gz" ]; then
    r1=intermediates/QC_shortreads/fastp/{sample}_run1_fastp_1.fastp.fastq.gz
    r2=intermediates/QC_shortreads/fastp/{sample}_run1_fastp_2.fastp.fastq.gz
elif [ -f "intermediates/QC_shortreads/adapterremoval/{sample}_run1_ar2.pair1.truncated.fastq.gz" ]; then
    r1=intermediates/QC_shortreads/adapterremoval/{sample}_run1_ar2.pair1.truncated.fastq.gz
    r2=intermediates/QC_shortreads/adapterremoval/{sample}_run1_ar2.pair2.truncated.fastq.gz
else
    r1=intermediates/QC_shortreads/trimmomatic/{sample}_run1_trimmomatic.paired.trim_1.fastq.gz
    r2=intermediates/QC_shortreads/trimmomatic/{sample}_run1_trimmomatic.paired.trim_2.fastq.gz
fi
if [ "{config.host_removal_verysensitive}" = "true" ]; then
    sens="--very-sensitive"
else
    sens="--sensitive"
fi
bowtie2 -p {threads} \\
        -x "$INDEX" \\
        -1 "$r1" -2 "$r2" \\
        $sens \\
        --un-conc-gz {sample}_run1_host_removed.unmapped_%.fastq.gz \\
        --al-conc-gz {sample}_run1_host_removed.mapped_%.fastq.gz \\
        1> /dev/null \\
        2> {sample}_run1_host_removed.bowtie2.log
rm -f {sample}_run1_host_removed.mapped_*.fastq.gz

mv {sample}_run1_host_removed.unmapped_1.fastq.gz intermediates/QC_shortreads/remove_host/
mv {sample}_run1_host_removed.unmapped_2.fastq.gz intermediates/QC_shortreads/remove_host/
mv {sample}_run1_host_removed.bowtie2.log {config.out_dir}/QC_shortreads/remove_host/
"""

[rules.resources]
threads = 8
memory = "2G"
time_limit = "6h"

[rules.environment]
conda = "envs/bowtie2.yaml"

# BOWTIE2_PHIX_REMOVAL_ALIGN (8 cpu / 2 GB override, prefix {id}_run{run}_phix_removed)
[[rules]]
name = "phix_align"
input = [
    "intermediates/QC_shortreads/fastp/{sample}_run1_fastp_1.fastp.fastq.gz",
    "intermediates/QC_shortreads/fastp/{sample}_run1_fastp_2.fastp.fastq.gz",
    "intermediates/QC_shortreads/adapterremoval/{sample}_run1_ar2.pair1.truncated.fastq.gz",
    "intermediates/QC_shortreads/adapterremoval/{sample}_run1_ar2.pair2.truncated.fastq.gz",
    "intermediates/QC_shortreads/trimmomatic/{sample}_run1_trimmomatic.paired.trim_1.fastq.gz",
    "intermediates/QC_shortreads/trimmomatic/{sample}_run1_trimmomatic.paired.trim_2.fastq.gz",
    "intermediates/QC_shortreads/remove_host/{sample}_run1_host_removed.unmapped_1.fastq.gz",
    "intermediates/QC_shortreads/remove_host/{sample}_run1_host_removed.unmapped_2.fastq.gz",
    "intermediates/binning/phix_index",
]
output = [
    "intermediates/QC_shortreads/remove_phix/{sample}_run1_phix_removed_1.unmapped.fastq.gz",
    "intermediates/QC_shortreads/remove_phix/{sample}_run1_phix_removed_2.unmapped.fastq.gz",
    "{config.out_dir}/QC_shortreads/remove_phix/{sample}_run1_phix_removed.bowtie2.log",
]
description = "Remove phiX reads by bowtie2 mapping (upstream BOWTIE2_PHIX_REMOVAL_ALIGN)"
depends_on = ["phix_build", "host_removal_align", "adapterremoval_pe", "trimmomatic"]
shell = """
mkdir -p intermediates/QC_shortreads/remove_phix {config.out_dir}/QC_shortreads/remove_phix
INDEX=`find -L intermediates/binning/phix_index -name "*.rev.1.bt2" | sed "s/\\.rev.1.bt2$//"`
[ -z "$INDEX" ] && INDEX=`find -L intermediates/binning/phix_index -name "*.rev.1.bt2l" | sed "s/\\.rev.1.bt2l$//"`
[ -z "$INDEX" ] && echo "Bowtie2 index files not found" 1>&2 && exit 1
# precedence chain mirroring the upstream channel wiring: phiX removal runs on
# the host-removed reads when host removal is enabled, else on the clipped
# reads of the active clip_tool (the other candidates are gated out, and the
# engine tolerates declared inputs that never materialize)
if [ -f "intermediates/QC_shortreads/remove_host/{sample}_run1_host_removed.unmapped_1.fastq.gz" ]; then
    r1=intermediates/QC_shortreads/remove_host/{sample}_run1_host_removed.unmapped_1.fastq.gz
    r2=intermediates/QC_shortreads/remove_host/{sample}_run1_host_removed.unmapped_2.fastq.gz
elif [ -f "intermediates/QC_shortreads/adapterremoval/{sample}_run1_ar2.pair1.truncated.fastq.gz" ]; then
    r1=intermediates/QC_shortreads/adapterremoval/{sample}_run1_ar2.pair1.truncated.fastq.gz
    r2=intermediates/QC_shortreads/adapterremoval/{sample}_run1_ar2.pair2.truncated.fastq.gz
elif [ -f "intermediates/QC_shortreads/trimmomatic/{sample}_run1_trimmomatic.paired.trim_1.fastq.gz" ]; then
    r1=intermediates/QC_shortreads/trimmomatic/{sample}_run1_trimmomatic.paired.trim_1.fastq.gz
    r2=intermediates/QC_shortreads/trimmomatic/{sample}_run1_trimmomatic.paired.trim_2.fastq.gz
else
    r1=intermediates/QC_shortreads/fastp/{sample}_run1_fastp_1.fastp.fastq.gz
    r2=intermediates/QC_shortreads/fastp/{sample}_run1_fastp_2.fastp.fastq.gz
fi

bowtie2 -p {threads} \\
        -x "$INDEX" \\
        -1 "$r1" -2 "$r2" \\
        --un-conc-gz {sample}_run1_phix_removed_%.unmapped.fastq.gz \\
        --al-conc-gz {sample}_run1_phix_removed_%.mapped.fastq.gz \\
        1> /dev/null \\
        2> {sample}_run1_phix_removed.bowtie2.log
rm -f {sample}_run1_phix_removed_*.mapped.fastq.gz

mv {sample}_run1_phix_removed_1.unmapped.fastq.gz intermediates/QC_shortreads/remove_phix/
mv {sample}_run1_phix_removed_2.unmapped.fastq.gz intermediates/QC_shortreads/remove_phix/
mv {sample}_run1_phix_removed.bowtie2.log {config.out_dir}/QC_shortreads/remove_phix/
"""

[rules.resources]
threads = 8
memory = "2G"
time_limit = "6h"

[rules.environment]
conda = "envs/bowtie2.yaml"

# BBMAP_BBNORM (--bbnorm; runs on the phiX-removed reads, feeds the assembly)
[[rules]]
name = "bbnorm"
when = "config.bbnorm"
input = [
    "intermediates/QC_shortreads/remove_phix/{sample}_run1_phix_removed_1.unmapped.fastq.gz",
    "intermediates/QC_shortreads/remove_phix/{sample}_run1_phix_removed_2.unmapped.fastq.gz",
]
output = [
    "intermediates/QC_shortreads/bbnorm/{sample}_1.nm.fastq.gz",
    "intermediates/QC_shortreads/bbnorm/{sample}_2.nm.fastq.gz",
    "{config.out_dir}/bbmap/bbnorm/logs/{sample}_run1_bbnorm.log",
]
description = "Read normalization with BBNorm (upstream BBMAP_BBNORM)"
shell = """
mkdir -p intermediates/QC_shortreads/bbnorm {config.out_dir}/bbmap/bbnorm/logs
# upstream: -Xmx = 80% of task.memory, clamped to >= 1g
mem_g=$(( {effective_memory_mb} * 8 / 10 / 1024 ))
[ "$mem_g" -lt 1 ] && mem_g=1
bbnorm.sh \\
    in={input[0]} \\
    in2={input[1]} \\
    out1={sample}_1.nm.fastq.gz \\
    out2={sample}_2.nm.fastq.gz \\
    target={config.bbnorm_target} \\
    min={config.bbnorm_min} \\
    threads={threads} \\
    -Xmx${mem_g}g \\
    &> {sample}_run1_bbnorm.log
mv {sample}_1.nm.fastq.gz intermediates/QC_shortreads/bbnorm/
mv {sample}_2.nm.fastq.gz intermediates/QC_shortreads/bbnorm/
mv {sample}_run1_bbnorm.log {config.out_dir}/bbmap/bbnorm/logs/
"""

[rules.resources]
threads = 6
memory = "12G"
time_limit = "12h"

[rules.environment]
conda = "envs/bbmap.yaml"

# FASTQC_TRIMMED (label process_low, ext.args '--quiet', prefix {id}_run{run}_trimmed)
[[rules]]
name = "fastqc_trimmed"
input = [
    "intermediates/QC_shortreads/remove_phix/{sample}_run1_phix_removed_1.unmapped.fastq.gz",
    "intermediates/QC_shortreads/remove_phix/{sample}_run1_phix_removed_2.unmapped.fastq.gz",
]
output = [
    "{config.out_dir}/QC_shortreads/fastqc/{sample}_run1_trimmed_1_fastqc.html",
    "{config.out_dir}/QC_shortreads/fastqc/{sample}_run1_trimmed_2_fastqc.html",
]
description = "Run FastQC on the phiX-removed reads (upstream FASTQC_TRIMMED)"
shell = """
ln -sf {input[0]} {sample}_run1_trimmed_1.fastq.gz
ln -sf {input[1]} {sample}_run1_trimmed_2.fastq.gz
fastqc \\
    --quiet \\
    --threads {threads} \\
    --memory $(( {effective_memory_mb} / 4 )) \\
    {sample}_run1_trimmed_1.fastq.gz \\
    {sample}_run1_trimmed_2.fastq.gz
mkdir -p {config.out_dir}/QC_shortreads/fastqc
mv {sample}_run1_trimmed_1_fastqc.html {output[0]}
mv {sample}_run1_trimmed_2_fastqc.html {output[1]}
# the fastqc zip archives stay in the rule scratch dir: upstream FASTQC_TRIMMED
# publishes *.html only (conf/modules.config)
"""

[rules.resources]
threads = 2
memory = "12G"
time_limit = "4h"

[rules.environment]
conda = "envs/fastqc.yaml"
