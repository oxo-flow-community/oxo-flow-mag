mkdir -p .tmp/catpack_bins_spades_metabinner_{sample} && cd .tmp/catpack_bins_spades_metabinner_{sample}
mkdir -p input_bins
for f in "$wd"/{config.out_dir}/GenomeBinning/MetaBinner/bins/SPAdes-MetaBinner-{sample}*.fa.gz; do
