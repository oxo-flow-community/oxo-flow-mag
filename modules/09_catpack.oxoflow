[rules.resources]
threads = 1
memory = "6G"
time_limit = "4h"

[rules.environment]
conda = "envs/catpack.yaml"

[[rules]]
name = "catpack_bins_megahit_maxbin2"
when = "config.cat_db"
input = [
    "{config.out_dir}/GenomeBinning/MaxBin2/bins",
    "intermediates/cat_db/db",
]
output = [
    "{config.out_dir}/Taxonomy/CAT/MEGAHIT/MaxBin2/{sample}/bins/MEGAHIT-MaxBin2-{sample}-bins.bin2classification.txt",
    "{config.out_dir}/Taxonomy/CAT/MEGAHIT/MaxBin2/{sample}/bins/MEGAHIT-MaxBin2-{sample}-bins.ORF2LCA.txt",
    "{config.out_dir}/Taxonomy/CAT/MEGAHIT/MaxBin2/{sample}/bins/MEGAHIT-MaxBin2-{sample}-bins.log",
]
depends_on = ["maxbin2_megahit", "cat_db_preparation"]
description = "CAT_pack bins classification of the MEGAHIT MaxBin2 bins (upstream CATPACK_BINS)"
shell = """
wd=$(pwd)
db_dir=$(find -L intermediates/cat_db -maxdepth 3 -type d -name db | head -1)
tax_dir=$(find -L intermediates/cat_db -maxdepth 3 -type d -name tax | head -1)
if [ -z "$db_dir" ] || [ -z "$tax_dir" ]; then
    echo "cat_db: the database must contain db/ and tax/ directories (a CAT_prepare archive or unpacked directory)" 1>&2
    exit 1
fi
mkdir -p .tmp/catpack_bins_megahit_maxbin2_{sample} && cd .tmp/catpack_bins_megahit_maxbin2_{sample}
mkdir -p input_bins
for f in "$wd"/{config.out_dir}/GenomeBinning/MaxBin2/bins/MEGAHIT-MaxBin2-{sample}*.fa.gz; do
    [ -e "$f" ] || continue
    gunzip -c "$f" > input_bins/$(basename "$f" .gz)
done
if ls input_bins/* >/dev/null 2>&1; then
    CAT_pack bins \\
        -n {threads} \\
        -b input_bins/ \\
        -d "$wd/$db_dir" \\
        -t "$wd/$tax_dir" \\
        -s .fa \\
        -o MEGAHIT-MaxBin2-{sample}-bins
    mkdir -p "$wd/{config.out_dir}/Taxonomy/CAT/MEGAHIT/MaxBin2/{sample}/bins"
    mv MEGAHIT-MaxBin2-{sample}-bins.* "$wd/{config.out_dir}/Taxonomy/CAT/MEGAHIT/MaxBin2/{sample}/bins/" 2>/dev/null || true
else
    # zero-bin group: emit the empty artifacts so the declared-output
    # contract holds
    echo "catpack: no bins matched for {sample}" 1>&2
    mkdir -p "$wd/{config.out_dir}/Taxonomy/CAT/MEGAHIT/MaxBin2/{sample}/bins"
    touch "$wd/{config.out_dir}/Taxonomy/CAT/MEGAHIT/MaxBin2/{sample}/bins/MEGAHIT-MaxBin2-{sample}-bins.bin2classification.txt"
    touch "$wd/{config.out_dir}/Taxonomy/CAT/MEGAHIT/MaxBin2/{sample}/bins/MEGAHIT-MaxBin2-{sample}-bins.ORF2LCA.txt"
    touch "$wd/{config.out_dir}/Taxonomy/CAT/MEGAHIT/MaxBin2/{sample}/bins/MEGAHIT-MaxBin2-{sample}-bins.log"
fi
cd "$wd"
rm -rf .tmp/catpack_bins_megahit_maxbin2_{sample}
"""

