[workflow]
name = "09_catpack"
description = "nf-core/mag 5.5.0 09_catpack fragment"
# ---------------------------------------------------------------------------
# oxo-flow port of nf-core/mag 5.5.0 CAT/BAT/RAT bin classification
# (upstream subworkflows/local/catpack/main.nf, bins column). Gated on
# config.cat_db; see main.oxoflow for the database contract.

# ---------------------------------------------------------------------------
# CAT/BAT/RAT bin classification (upstream subworkflows/local/catpack/main.nf,
# bins column: CATPACK_BINS -> CATPACK_ADDNAMES_BINS ->
# CATPACK_SUMMARISE_BINS -> bat_summary.tsv). Needs a local CAT database
# (config.cat_db = CAT_prepare .tar.gz archive or unpacked directory with
# db/ and tax/ subdirectories; upstream --cat_db). The contigs column
# (CATPACK_UNBINS, --cat_classify_unbinned default false) is ported below
# as the when-gated catpack_unbinned_* family (config.cat_classify_unbinned).
# ---------------------------------------------------------------------------
[[rules]]
name = "cat_db_preparation"
when = "config.cat_db"
input = ["{config.cat_db}"]
output = ["intermediates/cat_db/db"]
description = "Unpack or copy the local CAT database (upstream CATPACK_DB_UNTAR / fromPath)"
shell = """
if [ -z "{input[0]}" ]; then
    echo "cat_db is empty: set config.cat_db to the local CAT_prepare archive (.tar.gz) or unpacked directory, or run without it" 1>&2
    exit 1
fi
mkdir -p intermediates/cat_db/db
if [ -d "{input[0]}" ]; then
    # user passed a directory instead of a tar.gz
    cp -r "{input[0]}"/. intermediates/cat_db/db/
else
    tar -xzf "{input[0]}" -C intermediates/cat_db/db
fi
"""

[rules.resources]
threads = 1
memory = "6G"
time_limit = "4h"

[rules.environment]
conda = "envs/catpack.yaml"

[[rules]]
name = "catpack_bins_spades_metabat2"
when = "config.cat_db"
input = [
    "{config.out_dir}/GenomeBinning/MetaBAT2/bins",
    "intermediates/cat_db/db",
]
output = [
    "{config.out_dir}/Taxonomy/CAT/SPAdes/MetaBAT2/{sample}/bins/SPAdes-MetaBAT2-{sample}-bins.bin2classification.txt",
    "{config.out_dir}/Taxonomy/CAT/SPAdes/MetaBAT2/{sample}/bins/SPAdes-MetaBAT2-{sample}-bins.ORF2LCA.txt",
    "{config.out_dir}/Taxonomy/CAT/SPAdes/MetaBAT2/{sample}/bins/SPAdes-MetaBAT2-{sample}-bins.log",
]
depends_on = ["metabat2_spades", "cat_db_preparation"]
description = "CAT_pack bins classification of the SPAdes MetaBAT2 bins (upstream CATPACK_BINS)"
shell = """
wd=$(pwd)
db_dir=$(find -L intermediates/cat_db -maxdepth 3 -type d -name db | head -1)
tax_dir=$(find -L intermediates/cat_db -maxdepth 3 -type d -name tax | head -1)
if [ -z "$db_dir" ] || [ -z "$tax_dir" ]; then
    echo "cat_db: the database must contain db/ and tax/ directories (a CAT_prepare archive or unpacked directory)" 1>&2
    exit 1
fi
mkdir -p .tmp/catpack_bins_spades_metabat2_{sample} && cd .tmp/catpack_bins_spades_metabat2_{sample}
mkdir -p input_bins
for f in "$wd"/{config.out_dir}/GenomeBinning/MetaBAT2/bins/SPAdes-MetaBAT2-{sample}*.fa.gz; do
    [ -e "$f" ] || continue
    gunzip -c "$f" > input_bins/$(basename "$f" .gz)
done
if ls input_bins/* >/dev/null 2>&1; then
    CAT_pack bins \\
        -n {threads} \\
        -b input_bins/ \\
        -d "$wd/$db_dir" \\
        -t "$wd/$tax_dir" \\
        -s .fa \\
        -o SPAdes-MetaBAT2-{sample}-bins
    mkdir -p "$wd/{config.out_dir}/Taxonomy/CAT/SPAdes/MetaBAT2/{sample}/bins"
    mv SPAdes-MetaBAT2-{sample}-bins.* "$wd/{config.out_dir}/Taxonomy/CAT/SPAdes/MetaBAT2/{sample}/bins/" 2>/dev/null || true
else
    # zero-bin group: emit the empty artifacts so the declared-output
    # contract holds
    echo "catpack: no bins matched for {sample}" 1>&2
    mkdir -p "$wd/{config.out_dir}/Taxonomy/CAT/SPAdes/MetaBAT2/{sample}/bins"
    touch "$wd/{config.out_dir}/Taxonomy/CAT/SPAdes/MetaBAT2/{sample}/bins/SPAdes-MetaBAT2-{sample}-bins.bin2classification.txt"
    touch "$wd/{config.out_dir}/Taxonomy/CAT/SPAdes/MetaBAT2/{sample}/bins/SPAdes-MetaBAT2-{sample}-bins.ORF2LCA.txt"
    touch "$wd/{config.out_dir}/Taxonomy/CAT/SPAdes/MetaBAT2/{sample}/bins/SPAdes-MetaBAT2-{sample}-bins.log"
fi
cd "$wd"
rm -rf .tmp/catpack_bins_spades_metabat2_{sample}
"""

[rules.resources]
threads = 6
memory = "16G"
time_limit = "8h"

[rules.environment]
conda = "envs/catpack.yaml"

[[rules]]
name = "catpack_addnames_spades_metabat2"
when = "config.cat_db"
input = [
    "{config.out_dir}/Taxonomy/CAT/SPAdes/MetaBAT2/{sample}/bins/SPAdes-MetaBAT2-{sample}-bins.bin2classification.txt",
    "intermediates/cat_db/db",
]
output = [
    "{config.out_dir}/Taxonomy/CAT/SPAdes/MetaBAT2/{sample}/bins/SPAdes-MetaBAT2-{sample}-bins_bin2classification.names.txt",
]
depends_on = ["catpack_bins_spades_metabat2"]
description = "CAT_pack add_names of the SPAdes MetaBAT2 classification (upstream CATPACK_ADDNAMES_BINS, --only_official unless cat_allow_unofficial_lineages)"
shell = """
wd=$(pwd)
tax_dir=$(find -L intermediates/cat_db -maxdepth 3 -type d -name tax | head -1)
if [ -z "$tax_dir" ]; then
    echo "cat_db: the database must contain a tax/ directory (a CAT_prepare archive or unpacked directory)" 1>&2
    exit 1
fi
mkdir -p {config.out_dir}/Taxonomy/CAT/SPAdes/MetaBAT2/{sample}/bins
mkdir -p .tmp/catpack_addnames_spades_metabat2_{sample} && cd .tmp/catpack_addnames_spades_metabat2_{sample}
if [ -s "$wd/{input[0]}" ]; then
    only_official="--only_official"
    if [ "{config.cat_allow_unofficial_lineages}" = "true" ]; then
        only_official=""
    fi
    CAT_pack add_names \\
        $only_official \\
        -i "$wd/{input[0]}" \\
        -t "$wd/$tax_dir" \\
        -o SPAdes-MetaBAT2-{sample}-bins_bin2classification.names.txt
    mv SPAdes-MetaBAT2-{sample}-bins_bin2classification.names.txt "$wd/{config.out_dir}/Taxonomy/CAT/SPAdes/MetaBAT2/{sample}/bins/"
else
    touch "$wd/{config.out_dir}/Taxonomy/CAT/SPAdes/MetaBAT2/{sample}/bins/SPAdes-MetaBAT2-{sample}-bins_bin2classification.names.txt"
fi
cd "$wd"
rm -rf .tmp/catpack_addnames_spades_metabat2_{sample}
"""

[rules.resources]
threads = 1
memory = "6G"
time_limit = "4h"

[rules.environment]
conda = "envs/catpack.yaml"

[[rules]]
name = "catpack_summarise_spades_metabat2"
when = "config.cat_db && !config.cat_allow_unofficial_lineages"
input = [
    "{config.out_dir}/Taxonomy/CAT/SPAdes/MetaBAT2/{sample}/bins/SPAdes-MetaBAT2-{sample}-bins_bin2classification.names.txt",
    "intermediates/cat_db/db",
]
output = [
    "{config.out_dir}/Taxonomy/CAT/SPAdes/MetaBAT2/{sample}/bins/SPAdes-MetaBAT2-{sample}-bins_summary.txt",
]
depends_on = ["catpack_addnames_spades_metabat2"]
description = "CAT_pack summarise of the SPAdes MetaBAT2 names (upstream CATPACK_SUMMARISE_BINS, only when cat_allow_unofficial_lineages=false)"
shell = """
wd=$(pwd)
mkdir -p {config.out_dir}/Taxonomy/CAT/SPAdes/MetaBAT2/{sample}/bins
mkdir -p .tmp/catpack_summarise_spades_metabat2_{sample} && cd .tmp/catpack_summarise_spades_metabat2_{sample}
if [ -s "$wd/{input[0]}" ]; then
    CAT_pack summarise \\
        -i "$wd/{input[0]}" \\
        -o SPAdes-MetaBAT2-{sample}-bins_summary.txt
    mv SPAdes-MetaBAT2-{sample}-bins_summary.txt "$wd/{config.out_dir}/Taxonomy/CAT/SPAdes/MetaBAT2/{sample}/bins/"
else
    touch "$wd/{config.out_dir}/Taxonomy/CAT/SPAdes/MetaBAT2/{sample}/bins/SPAdes-MetaBAT2-{sample}-bins_summary.txt"
fi
cd "$wd"
rm -rf .tmp/catpack_summarise_spades_metabat2_{sample}
"""

[rules.resources]
