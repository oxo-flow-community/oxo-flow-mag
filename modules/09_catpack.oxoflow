[rules.resources]
threads = 1
memory = "6G"
time_limit = "4h"

[rules.environment]
conda = "envs/catpack.yaml"

[[rules]]
name = "catpack_bins_megahit_semibin2"
when = "config.cat_db"
input = [
    "{config.out_dir}/GenomeBinning/SemiBin2/bins",
    "intermediates/cat_db/db",
]
output = [
    "{config.out_dir}/Taxonomy/CAT/MEGAHIT/SemiBin2/{sample}/bins/MEGAHIT-SemiBin2-{sample}-bins.bin2classification.txt",
    "{config.out_dir}/Taxonomy/CAT/MEGAHIT/SemiBin2/{sample}/bins/MEGAHIT-SemiBin2-{sample}-bins.ORF2LCA.txt",
    "{config.out_dir}/Taxonomy/CAT/MEGAHIT/SemiBin2/{sample}/bins/MEGAHIT-SemiBin2-{sample}-bins.log",
]
depends_on = ["semibin_megahit", "cat_db_preparation"]
description = "CAT_pack bins classification of the MEGAHIT SemiBin2 bins (upstream CATPACK_BINS)"
shell = """
wd=$(pwd)
db_dir=$(find -L intermediates/cat_db -maxdepth 3 -type d -name db | head -1)
tax_dir=$(find -L intermediates/cat_db -maxdepth 3 -type d -name tax | head -1)
if [ -z "$db_dir" ] || [ -z "$tax_dir" ]; then
    echo "cat_db: the database must contain db/ and tax/ directories (a CAT_prepare archive or unpacked directory)" 1>&2
    exit 1
fi
mkdir -p .tmp/catpack_bins_megahit_semibin2_{sample} && cd .tmp/catpack_bins_megahit_semibin2_{sample}
mkdir -p input_bins
for f in "$wd"/{config.out_dir}/GenomeBinning/SemiBin2/bins/MEGAHIT-SemiBin2-{sample}*.fa.gz; do
    [ -e "$f" ] || continue
    gunzip -c "$f" > input_bins/$(basename "$f" .gz)
