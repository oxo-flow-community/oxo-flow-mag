        -b input_seqs/ \
        -d "$wd/$db_dir" \
        -t "$wd/$tax_dir" \
        -s .fa \
        -o MEGAHIT-MaxBin2-{sample}-unbinned
    mkdir -p "$wd/{config.out_dir}/Taxonomy/CAT/MEGAHIT/MaxBin2/{sample}/unbinned"
    mv MEGAHIT-MaxBin2-{sample}-unbinned.* "$wd/{config.out_dir}/Taxonomy/CAT/MEGAHIT/MaxBin2/{sample}/unbinned/" 2>/dev/null || true
else
    # no unbinned chunks survived the min-length filter: emit empty
    # artifacts so the declared-output contract holds
    echo "catpack unbinned: no chunks matched for {sample}" 1>&2
    mkdir -p "$wd/{config.out_dir}/Taxonomy/CAT/MEGAHIT/MaxBin2/{sample}/unbinned"
    touch "$wd/{config.out_dir}/Taxonomy/CAT/MEGAHIT/MaxBin2/{sample}/unbinned/MEGAHIT-MaxBin2-{sample}-unbinned.bin2classification.txt"
    touch "$wd/{config.out_dir}/Taxonomy/CAT/MEGAHIT/MaxBin2/{sample}/unbinned/MEGAHIT-MaxBin2-{sample}-unbinned.ORF2LCA.txt"
    touch "$wd/{config.out_dir}/Taxonomy/CAT/MEGAHIT/MaxBin2/{sample}/unbinned/MEGAHIT-MaxBin2-{sample}-unbinned.log"
fi
cd "$wd"
rm -rf .tmp/catpack_unbinned_megahit_maxbin2_{sample}
