    touch "$wd/{config.out_dir}/Taxonomy/CAT/MEGAHIT/SemiBin2/{sample}/unbinned/MEGAHIT-SemiBin2-{sample}-unbinned.bin2classification.txt"
    touch "$wd/{config.out_dir}/Taxonomy/CAT/MEGAHIT/SemiBin2/{sample}/unbinned/MEGAHIT-SemiBin2-{sample}-unbinned.ORF2LCA.txt"
    touch "$wd/{config.out_dir}/Taxonomy/CAT/MEGAHIT/SemiBin2/{sample}/unbinned/MEGAHIT-SemiBin2-{sample}-unbinned.log"
fi
cd "$wd"
rm -rf .tmp/catpack_unbinned_megahit_semibin2_{sample}
"""

[rules.resources]
threads = 6
memory = "16G"
time_limit = "8h"

[rules.environment]
conda = "envs/catpack.yaml"

[[rules]]
name = "catpack_unbinned_megahit_comebin"
when = "config.cat_db && config.cat_classify_unbinned"
input = [
    "{config.out_dir}/GenomeBinning/COMEBin/unbinned",
    "intermediates/cat_db/db",
]
output = [
    "{config.out_dir}/Taxonomy/CAT/MEGAHIT/COMEBin/{sample}/unbinned/MEGAHIT-COMEBin-{sample}-unbinned.bin2classification.txt",
    "{config.out_dir}/Taxonomy/CAT/MEGAHIT/COMEBin/{sample}/unbinned/MEGAHIT-COMEBin-{sample}-unbinned.ORF2LCA.txt",
    "{config.out_dir}/Taxonomy/CAT/MEGAHIT/COMEBin/{sample}/unbinned/MEGAHIT-COMEBin-{sample}-unbinned.log",
]
depends_on = ["comebin_megahit", "cat_db_preparation"]
description = "CAT_pack classification of the MEGAHIT COMEBin unbinned contig chunks (upstream CATPACK_UNBINS, --cat_classify_unbinned)"
shell = """
wd=$(pwd)
db_dir=$(find -L intermediates/cat_db -maxdepth 3 -type d -name db | head -1)
tax_dir=$(find -L intermediates/cat_db -maxdepth 3 -type d -name tax | head -1)
if [ -z "$db_dir" ] || [ -z "$tax_dir" ]; then
    echo "cat_db: the database must contain db/ and tax/ directories" 1>&2
    exit 1
fi
mkdir -p .tmp/catpack_unbinned_megahit_comebin_{sample} && cd .tmp/catpack_unbinned_megahit_comebin_{sample}
mkdir -p input_seqs
for f in "$wd"/{config.out_dir}/GenomeBinning/COMEBin/unbinned/MEGAHIT-COMEBin-{sample}*[0-9].fa.gz; do
    [ -e "$f" ] || continue
    gunzip -c "$f" > input_seqs/$(basename "$f" .gz)
done
if ls input_seqs/* >/dev/null 2>&1; then
    CAT_pack bins \
        -n {threads} \
        -b input_seqs/ \
        -d "$wd/$db_dir" \
        -t "$wd/$tax_dir" \
        -s .fa \
        -o MEGAHIT-COMEBin-{sample}-unbinned
    mkdir -p "$wd/{config.out_dir}/Taxonomy/CAT/MEGAHIT/COMEBin/{sample}/unbinned"
    mv MEGAHIT-COMEBin-{sample}-unbinned.* "$wd/{config.out_dir}/Taxonomy/CAT/MEGAHIT/COMEBin/{sample}/unbinned/" 2>/dev/null || true
else
    # no unbinned chunks survived the min-length filter: emit empty
    # artifacts so the declared-output contract holds
    echo "catpack unbinned: no chunks matched for {sample}" 1>&2
    mkdir -p "$wd/{config.out_dir}/Taxonomy/CAT/MEGAHIT/COMEBin/{sample}/unbinned"
    touch "$wd/{config.out_dir}/Taxonomy/CAT/MEGAHIT/COMEBin/{sample}/unbinned/MEGAHIT-COMEBin-{sample}-unbinned.bin2classification.txt"
    touch "$wd/{config.out_dir}/Taxonomy/CAT/MEGAHIT/COMEBin/{sample}/unbinned/MEGAHIT-COMEBin-{sample}-unbinned.ORF2LCA.txt"
    touch "$wd/{config.out_dir}/Taxonomy/CAT/MEGAHIT/COMEBin/{sample}/unbinned/MEGAHIT-COMEBin-{sample}-unbinned.log"
fi
cd "$wd"
rm -rf .tmp/catpack_unbinned_megahit_comebin_{sample}
"""

[rules.resources]
threads = 6
memory = "16G"
time_limit = "8h"

[rules.environment]
conda = "envs/catpack.yaml"

[[rules]]
name = "catpack_bat_summary"
when = "config.cat_db"
input = ["{config.out_dir}/Taxonomy/CAT"]
output = ["{config.out_dir}/Taxonomy/CAT/bat_summary.tsv"]
depends_on = [
    "catpack_addnames_spades_metabat2",
    "catpack_addnames_spades_maxbin2",
    "catpack_addnames_spades_concoct",
    "catpack_addnames_spades_comebin",
    "catpack_addnames_spades_metabinner",
    "catpack_addnames_spades_semibin2",
    "catpack_addnames_megahit_metabat2",
    "catpack_addnames_megahit_maxbin2",
    "catpack_addnames_megahit_concoct",
    "catpack_addnames_megahit_comebin",
    "catpack_addnames_megahit_metabinner",
    "catpack_addnames_megahit_semibin2",
]
description = "Concatenate all CAT_pack add_names tables (upstream CATPACK collectFile bat_summary.tsv, keepHeader + sort deep)"
shell = """
mkdir -p {config.out_dir}/Taxonomy/CAT
if ls {config.out_dir}/Taxonomy/CAT/*/*/*/bins/*bin2classification.names.txt >/dev/null 2>&1; then
    first=$(ls {config.out_dir}/Taxonomy/CAT/*/*/*/bins/*bin2classification.names.txt | head -1)
    head -1 "$first" > bat_summary.tsv
    for f in {config.out_dir}/Taxonomy/CAT/*/*/*/bins/*bin2classification.names.txt; do
        tail -n +2 "$f"
    done | sort >> bat_summary.tsv
else
    touch bat_summary.tsv
fi
mv bat_summary.tsv {config.out_dir}/Taxonomy/CAT/
"""

[rules.resources]
threads = 1
memory = "6G"
time_limit = "4h"

[rules.environment]
conda = "envs/qsv.yaml"


