    touch "$wd/{config.out_dir}/Taxonomy/CAT/MEGAHIT/MetaBinner/{sample}/bins/MEGAHIT-MetaBinner-{sample}-bins.log"
fi
cd "$wd"
rm -rf .tmp/catpack_bins_megahit_metabinner_{sample}
