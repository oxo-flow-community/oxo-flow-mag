if ls input_bins/* >/dev/null 2>&1; then
    CAT_pack bins \\
        -n {threads} \\
        -b input_bins/ \\
        -d "$wd/$db_dir" \\
        -t "$wd/$tax_dir" \\
        -s .fa \\
        -o MEGAHIT-SemiBin2-{sample}-bins
    mkdir -p "$wd/{config.out_dir}/Taxonomy/CAT/MEGAHIT/SemiBin2/{sample}/bins"
    mv MEGAHIT-SemiBin2-{sample}-bins.* "$wd/{config.out_dir}/Taxonomy/CAT/MEGAHIT/SemiBin2/{sample}/bins/" 2>/dev/null || true
else
    # zero-bin group: emit the empty artifacts so the declared-output
    # contract holds
    echo "catpack: no bins matched for {sample}" 1>&2
    mkdir -p "$wd/{config.out_dir}/Taxonomy/CAT/MEGAHIT/SemiBin2/{sample}/bins"
    touch "$wd/{config.out_dir}/Taxonomy/CAT/MEGAHIT/SemiBin2/{sample}/bins/MEGAHIT-SemiBin2-{sample}-bins.bin2classification.txt"
    touch "$wd/{config.out_dir}/Taxonomy/CAT/MEGAHIT/SemiBin2/{sample}/bins/MEGAHIT-SemiBin2-{sample}-bins.ORF2LCA.txt"
    touch "$wd/{config.out_dir}/Taxonomy/CAT/MEGAHIT/SemiBin2/{sample}/bins/MEGAHIT-SemiBin2-{sample}-bins.log"
fi
cd "$wd"
rm -rf .tmp/catpack_bins_megahit_semibin2_{sample}
"""

