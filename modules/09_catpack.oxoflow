    mkdir -p "$wd/{config.out_dir}/Taxonomy/CAT/SPAdes/CONCOCT/{sample}/bins"
    touch "$wd/{config.out_dir}/Taxonomy/CAT/SPAdes/CONCOCT/{sample}/bins/SPAdes-CONCOCT-{sample}-bins.bin2classification.txt"
    touch "$wd/{config.out_dir}/Taxonomy/CAT/SPAdes/CONCOCT/{sample}/bins/SPAdes-CONCOCT-{sample}-bins.ORF2LCA.txt"
