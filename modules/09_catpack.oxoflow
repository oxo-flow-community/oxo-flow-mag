    touch "$wd/{config.out_dir}/Taxonomy/CAT/SPAdes/MaxBin2/{sample}/bins/SPAdes-MaxBin2-{sample}-bins.ORF2LCA.txt"
    touch "$wd/{config.out_dir}/Taxonomy/CAT/SPAdes/MaxBin2/{sample}/bins/SPAdes-MaxBin2-{sample}-bins.log"
fi
cd "$wd"
