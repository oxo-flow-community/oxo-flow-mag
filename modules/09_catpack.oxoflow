[rules.resources]
threads = 1
memory = "6G"
time_limit = "4h"

[rules.environment]
conda = "envs/catpack.yaml"

[[rules]]
name = "catpack_bins_spades_concoct"
when = "config.cat_db"
input = [
    "{config.out_dir}/GenomeBinning/CONCOCT/bins",
    "intermediates/cat_db/db",
]
output = [
    "{config.out_dir}/Taxonomy/CAT/SPAdes/CONCOCT/{sample}/bins/SPAdes-CONCOCT-{sample}-bins.bin2classification.txt",
    "{config.out_dir}/Taxonomy/CAT/SPAdes/CONCOCT/{sample}/bins/SPAdes-CONCOCT-{sample}-bins.ORF2LCA.txt",
    "{config.out_dir}/Taxonomy/CAT/SPAdes/CONCOCT/{sample}/bins/SPAdes-CONCOCT-{sample}-bins.log",
