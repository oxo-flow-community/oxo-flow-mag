        -b input_bins/ \\
        -d "$wd/$db_dir" \\
        -t "$wd/$tax_dir" \\
        -s .fa \\
        -o MEGAHIT-MetaBinner-{sample}-bins
    mkdir -p "$wd/{config.out_dir}/Taxonomy/CAT/MEGAHIT/MetaBinner/{sample}/bins"
    mv MEGAHIT-MetaBinner-{sample}-bins.* "$wd/{config.out_dir}/Taxonomy/CAT/MEGAHIT/MetaBinner/{sample}/bins/" 2>/dev/null || true
else
    # zero-bin group: emit the empty artifacts so the declared-output
    # contract holds
    echo "catpack: no bins matched for {sample}" 1>&2
    mkdir -p "$wd/{config.out_dir}/Taxonomy/CAT/MEGAHIT/MetaBinner/{sample}/bins"
    touch "$wd/{config.out_dir}/Taxonomy/CAT/MEGAHIT/MetaBinner/{sample}/bins/MEGAHIT-MetaBinner-{sample}-bins.bin2classification.txt"
