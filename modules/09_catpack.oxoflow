[rules.resources]
threads = 1
memory = "6G"
time_limit = "4h"

[rules.environment]
conda = "envs/catpack.yaml"

[[rules]]
name = "catpack_unbinned_spades_metabat2"
when = "config.cat_db && config.cat_classify_unbinned"
input = [
    "{config.out_dir}/GenomeBinning/MetaBAT2/unbinned",
    "intermediates/cat_db/db",
]
output = [
    "{config.out_dir}/Taxonomy/CAT/SPAdes/MetaBAT2/{sample}/unbinned/SPAdes-MetaBAT2-{sample}-unbinned.bin2classification.txt",
    "{config.out_dir}/Taxonomy/CAT/SPAdes/MetaBAT2/{sample}/unbinned/SPAdes-MetaBAT2-{sample}-unbinned.ORF2LCA.txt",
    "{config.out_dir}/Taxonomy/CAT/SPAdes/MetaBAT2/{sample}/unbinned/SPAdes-MetaBAT2-{sample}-unbinned.log",
]
depends_on = ["split_fasta_metabat2_spades", "cat_db_preparation"]
description = "CAT_pack classification of the SPAdes MetaBAT2 unbinned contig chunks (upstream CATPACK_UNBINS, --cat_classify_unbinned)"
shell = """
wd=$(pwd)
db_dir=$(find -L intermediates/cat_db -maxdepth 3 -type d -name db | head -1)
tax_dir=$(find -L intermediates/cat_db -maxdepth 3 -type d -name tax | head -1)
if [ -z "$db_dir" ] || [ -z "$tax_dir" ]; then
    echo "cat_db: the database must contain db/ and tax/ directories" 1>&2
    exit 1
fi
mkdir -p .tmp/catpack_unbinned_spades_metabat2_{sample} && cd .tmp/catpack_unbinned_spades_metabat2_{sample}
mkdir -p input_seqs
for f in "$wd"/{config.out_dir}/GenomeBinning/MetaBAT2/unbinned/SPAdes-MetaBAT2-{sample}*[0-9].fa.gz; do
    [ -e "$f" ] || continue
    gunzip -c "$f" > input_seqs/$(basename "$f" .gz)
done
if ls input_seqs/* >/dev/null 2>&1; then
    CAT_pack bins \
        -n {threads} \
        -b input_seqs/ \
        -d "$wd/$db_dir" \
        -t "$wd/$tax_dir" \
        -s .fa \
        -o SPAdes-MetaBAT2-{sample}-unbinned
    mkdir -p "$wd/{config.out_dir}/Taxonomy/CAT/SPAdes/MetaBAT2/{sample}/unbinned"
    mv SPAdes-MetaBAT2-{sample}-unbinned.* "$wd/{config.out_dir}/Taxonomy/CAT/SPAdes/MetaBAT2/{sample}/unbinned/" 2>/dev/null || true
else
    # no unbinned chunks survived the min-length filter: emit empty
    # artifacts so the declared-output contract holds
    echo "catpack unbinned: no chunks matched for {sample}" 1>&2
    mkdir -p "$wd/{config.out_dir}/Taxonomy/CAT/SPAdes/MetaBAT2/{sample}/unbinned"
    touch "$wd/{config.out_dir}/Taxonomy/CAT/SPAdes/MetaBAT2/{sample}/unbinned/SPAdes-MetaBAT2-{sample}-unbinned.bin2classification.txt"
    touch "$wd/{config.out_dir}/Taxonomy/CAT/SPAdes/MetaBAT2/{sample}/unbinned/SPAdes-MetaBAT2-{sample}-unbinned.ORF2LCA.txt"
    touch "$wd/{config.out_dir}/Taxonomy/CAT/SPAdes/MetaBAT2/{sample}/unbinned/SPAdes-MetaBAT2-{sample}-unbinned.log"
fi
cd "$wd"
rm -rf .tmp/catpack_unbinned_spades_metabat2_{sample}
"""

