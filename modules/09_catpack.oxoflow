depends_on = ["concoct_extract_spades", "cat_db_preparation"]
description = "CAT_pack bins classification of the SPAdes CONCOCT bins (upstream CATPACK_BINS)"
shell = """
wd=$(pwd)
db_dir=$(find -L intermediates/cat_db -maxdepth 3 -type d -name db | head -1)
