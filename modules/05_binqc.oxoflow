    mv {sample}-auto-busco.log "$wd/$2/" 2>/dev/null || true
    mv short_summary.* "$wd/$2/" 2>/dev/null || true
}
mkdir -p {config.out_dir}/GenomeBinning/QC/BUSCO
mkdir -p .tmp/busco_megahit_comebin_{sample} && cd .tmp/busco_megahit_comebin_{sample}
# bins (meta.refinement='unrefined')
run_busco "$wd/{config.out_dir}/GenomeBinning/COMEBin/bins/MEGAHIT-COMEBin-{sample}*.fa.gz" "{config.out_dir}/GenomeBinning/QC/BUSCO/MEGAHIT-COMEBin-unclassified-unrefined-{sample}"
