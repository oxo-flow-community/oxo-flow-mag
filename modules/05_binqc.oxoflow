depends_on = ["checkm_lineagewf_megahit_metabinner"]
description = "CheckM qa of the MEGAHIT MetaBinner lineage_wf runs (upstream CHECKM_QA)"
shell = """
wd=$(pwd)
if [ -n "{config.checkm_db}" ]; then
    export CHECKM_DATA_PATH="$wd/{config.checkm_db}"
fi
run_qa() {
    # $1 = lineage_wf output dir, $2 = qa output basename
    if [ -f "$1/lineage.ms" ]; then
        checkm \\
            qa \\
