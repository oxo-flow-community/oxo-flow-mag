"""

[rules.resources]
threads = 4
memory = "8G"
time_limit = "6h"

[rules.environment]
conda = "envs/checkm.yaml"

[[rules]]
name = "checkm_lineagewf_megahit_semibin2"
when = "config.run_checkm"
input = [
    "{config.out_dir}/GenomeBinning/SemiBin2/bins",
    "{config.out_dir}/GenomeBinning/SemiBin2/unbinned",
