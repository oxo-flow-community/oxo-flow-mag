mv SPAdes-MaxBin2-unclassified-unrefined_unbinned-{sample}_wf* "$wd/{config.out_dir}/GenomeBinning/QC/CheckM/"
cd "$wd"
rm -rf .tmp/checkm_lw_spades_maxbin2_{sample}
"""

