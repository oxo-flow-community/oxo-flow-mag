]
depends_on = ["semibin_megahit"]
description = "GUNC run of the MEGAHIT SemiBin2 bins and chunks (upstream GUNC_RUN)"
shell = """
wd=$(pwd)
if [ -z "{config.gunc_db}" ]; then
    echo "gunc: config.gunc_db must point to a local GUNC database when run_gunc=true" 1>&2
    exit 1
fi
run_gunc() {
    # $1 = input glob pattern, $2 = prefix (output basename)
    mkdir -p input_files
    for f in $1; do
        [ -e "$f" ] || continue
        ln -sf "$f" input_files/$(basename "$f")
    done
    if ls input_files/* >/dev/null 2>&1; then
        ls input_files/* > input_files.txt
        gunc \\
            run \\
            --input_file input_files.txt \\
            --db_file "$wd/{config.gunc_db}" \\
            --threads {threads}
        # gunc names the tables after the database file; rename to the group
        # prefix so raw/<prefix>/ holds exactly one group's tables
        mv *maxCSS_level.tsv "$2_maxCSS_level.tsv"
        mv *all_levels.tsv "$2_all_levels.tsv" 2>/dev/null || touch "$2_all_levels.tsv"
    else
        # zero-bin group: emit the empty artifacts so the declared-output
        # contract holds
        echo "gunc: no bins matched for {sample} ($2)" 1>&2
        touch "$2_maxCSS_level.tsv"
        touch "$2_all_levels.tsv"
    fi
    mkdir -p "$wd/{config.out_dir}/GenomeBinning/QC/GUNC/raw/$2"
    mv "$2_maxCSS_level.tsv" "$wd/{config.out_dir}/GenomeBinning/QC/GUNC/raw/$2/"
    mv "$2_all_levels.tsv" "$wd/{config.out_dir}/GenomeBinning/QC/GUNC/raw/$2/"
}
mkdir -p {config.out_dir}/GenomeBinning/QC/GUNC/raw
mkdir -p .tmp/gunc_megahit_semibin2_{sample} && cd .tmp/gunc_megahit_semibin2_{sample}
# bins (meta.refinement='unrefined')
run_gunc "$wd/{config.out_dir}/GenomeBinning/SemiBin2/bins/MEGAHIT-SemiBin2-{sample}*.fa.gz" MEGAHIT-SemiBin2-unclassified-unrefined-{sample}
rm -rf input_files
# unbinned chunks (meta.refinement='unrefined_unbinned')
run_gunc "$wd/{config.out_dir}/GenomeBinning/SemiBin2/unbinned/MEGAHIT-SemiBin2-{sample}*[0-9].fa.gz" MEGAHIT-SemiBin2-unclassified-unrefined_unbinned-{sample}
cd "$wd"
rm -rf .tmp/gunc_megahit_semibin2_{sample}
"""

[rules.resources]
threads = 4
memory = "8G"
time_limit = "8h"

[rules.environment]
conda = "envs/gunc.yaml"

[[rules]]
name = "concat_gunc_tsv"
when = "config.run_gunc"
input = ["{config.out_dir}/GenomeBinning/QC/GUNC/raw"]
output = ["{config.out_dir}/GenomeBinning/QC/gunc_summary.tsv"]
depends_on = [
    "gunc_spades_metabat2",
    "gunc_spades_maxbin2",
    "gunc_spades_concoct",
    "gunc_spades_comebin",
    "gunc_spades_metabinner",
    "gunc_spades_semibin2",
    "gunc_megahit_metabat2",
    "gunc_megahit_maxbin2",
    "gunc_megahit_concoct",
    "gunc_megahit_comebin",
    "gunc_megahit_metabinner",
    "gunc_megahit_semibin2",
]
description = "Concatenate all GUNC maxCSS tables (upstream CONCAT_GUNC_TSV, qsv cat rowskey)"
shell = """
export QSV_SKIP_FORMAT_CHECK=1
mkdir -p {config.out_dir}/GenomeBinning/QC
if ls {config.out_dir}/GenomeBinning/QC/GUNC/raw/*/*maxCSS_level.tsv >/dev/null 2>&1; then
    qsv cat rowskey --delimiter '\\t' -o gunc_summary.tsv {config.out_dir}/GenomeBinning/QC/GUNC/raw/*/*maxCSS_level.tsv
else
    touch gunc_summary.tsv
fi
mv gunc_summary.tsv {config.out_dir}/GenomeBinning/QC/
"""

[rules.resources]
threads = 1
memory = "6G"
time_limit = "4h"

[rules.environment]
conda = "envs/qsv.yaml"


[[rules]]
name = "gunc_mergecheckm_spades_metabat2"
when = "config.run_gunc && config.run_checkm"
input = [
    "{config.out_dir}/GenomeBinning/QC/GUNC/raw/SPAdes-MetaBAT2-unclassified-unrefined-{sample}/SPAdes-MetaBAT2-unclassified-unrefined-{sample}_maxCSS_level.tsv",
    "{config.out_dir}/GenomeBinning/QC/GUNC/raw/SPAdes-MetaBAT2-unclassified-unrefined_unbinned-{sample}/SPAdes-MetaBAT2-unclassified-unrefined_unbinned-{sample}_maxCSS_level.tsv",
    "{config.out_dir}/GenomeBinning/QC/CheckM/SPAdes-MetaBAT2-unclassified-unrefined-{sample}_qa.txt",
    "{config.out_dir}/GenomeBinning/QC/CheckM/SPAdes-MetaBAT2-unclassified-unrefined_unbinned-{sample}_qa.txt",
]
output = [
    "{config.out_dir}/GenomeBinning/QC/GUNC/checkmmerged/SPAdes-MetaBAT2-unclassified-unrefined-{sample}/gunc_merge_checkm.tsv",
    "{config.out_dir}/GenomeBinning/QC/GUNC/checkmmerged/SPAdes-MetaBAT2-unclassified-unrefined_unbinned-{sample}/gunc_merge_checkm.tsv",
]
depends_on = ["gunc_spades_metabat2", "checkm_qa_spades_metabat2"]
description = "GUNC merge_checkm of the SPAdes MetaBAT2 groups (upstream GUNC_MERGECHECKM)"
shell = """
wd=$(pwd)
run_merge() {
    # $1 = gunc maxCSS tsv, $2 = checkm qa txt, $3 = publish dir
    mkdir -p "$3"
    if [ -s "$1" ] && [ -s "$2" ]; then
        gunc \\
            merge_checkm \\
            -g "$1" \\
            -c "$2" \\
            -o .
        mv gunc_merge_checkm.tsv "$3/"
    else
        touch "$3/gunc_merge_checkm.tsv"
    fi
}
mkdir -p {config.out_dir}/GenomeBinning/QC/GUNC/checkmmerged
run_merge "$wd/{input[0]}" "$wd/{input[2]}" "$wd/{config.out_dir}/GenomeBinning/QC/GUNC/checkmmerged/SPAdes-MetaBAT2-unclassified-unrefined-{sample}"
run_merge "$wd/{input[1]}" "$wd/{input[3]}" "$wd/{config.out_dir}/GenomeBinning/QC/GUNC/checkmmerged/SPAdes-MetaBAT2-unclassified-unrefined_unbinned-{sample}"
"""

