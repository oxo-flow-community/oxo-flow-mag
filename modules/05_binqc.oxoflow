"""

[rules.resources]
threads = 4
memory = "16G"
time_limit = "12h"

[rules.environment]
conda = "envs/checkm.yaml"

[[rules]]
name = "checkm_qa_megahit_comebin"
when = "config.run_checkm"
input = [
    "{config.out_dir}/GenomeBinning/QC/CheckM/MEGAHIT-COMEBin-unclassified-unrefined-{sample}_wf",
    "{config.out_dir}/GenomeBinning/QC/CheckM/MEGAHIT-COMEBin-unclassified-unrefined_unbinned-{sample}_wf",
]
output = [
    "{config.out_dir}/GenomeBinning/QC/CheckM/MEGAHIT-COMEBin-unclassified-unrefined-{sample}_qa.txt",
    "{config.out_dir}/GenomeBinning/QC/CheckM/MEGAHIT-COMEBin-unclassified-unrefined_unbinned-{sample}_qa.txt",
]
depends_on = ["checkm_lineagewf_megahit_comebin"]
description = "CheckM qa of the MEGAHIT COMEBin lineage_wf runs (upstream CHECKM_QA)"
shell = """
wd=$(pwd)
if [ -n "{config.checkm_db}" ]; then
    export CHECKM_DATA_PATH="$wd/{config.checkm_db}"
fi
run_qa() {
    # $1 = lineage_wf output dir, $2 = qa output basename
    if [ -f "$1/lineage.ms" ]; then
        checkm \\
            qa \\
            --threads {threads} \\
            --file "$2_qa.txt" \\
            "$1/lineage.ms" \\
            "$1" \\
            -o 2 \\
            --tab_table
    else
        touch "$2_qa.txt"
    fi
}
mkdir -p {config.out_dir}/GenomeBinning/QC/CheckM
mkdir -p .tmp/checkm_qa_megahit_comebin_{sample} && cd .tmp/checkm_qa_megahit_comebin_{sample}
run_qa "$wd/{config.out_dir}/GenomeBinning/QC/CheckM/MEGAHIT-COMEBin-unclassified-unrefined-{sample}_wf" MEGAHIT-COMEBin-unclassified-unrefined-{sample}
run_qa "$wd/{config.out_dir}/GenomeBinning/QC/CheckM/MEGAHIT-COMEBin-unclassified-unrefined_unbinned-{sample}_wf" MEGAHIT-COMEBin-unclassified-unrefined_unbinned-{sample}
mv MEGAHIT-COMEBin-unclassified-unrefined-{sample}_qa.txt "$wd/{config.out_dir}/GenomeBinning/QC/CheckM/"
mv MEGAHIT-COMEBin-unclassified-unrefined_unbinned-{sample}_qa.txt "$wd/{config.out_dir}/GenomeBinning/QC/CheckM/"
cd "$wd"
rm -rf .tmp/checkm_qa_megahit_comebin_{sample}
"""

[rules.resources]
threads = 4
memory = "8G"
time_limit = "6h"

[rules.environment]
conda = "envs/checkm.yaml"

[[rules]]
name = "checkm_lineagewf_megahit_metabinner"
when = "config.run_checkm"
input = [
    "{config.out_dir}/GenomeBinning/MetaBinner/bins",
    "{config.out_dir}/GenomeBinning/MetaBinner/unbinned",
]
output = [
    "{config.out_dir}/GenomeBinning/QC/CheckM/MEGAHIT-MetaBinner-unclassified-unrefined-{sample}_wf",
    "{config.out_dir}/GenomeBinning/QC/CheckM/MEGAHIT-MetaBinner-unclassified-unrefined-{sample}_wf.tsv",
    "{config.out_dir}/GenomeBinning/QC/CheckM/MEGAHIT-MetaBinner-unclassified-unrefined_unbinned-{sample}_wf",
    "{config.out_dir}/GenomeBinning/QC/CheckM/MEGAHIT-MetaBinner-unclassified-unrefined_unbinned-{sample}_wf.tsv",
]
depends_on = ["metabinner_bins_megahit", "split_fasta_metabinner_megahit"]
description = "CheckM lineage_wf of the MEGAHIT MetaBinner bins and chunks (upstream CHECKM_LINEAGEWF)"
shell = """
wd=$(pwd)
if [ -n "{config.checkm_db}" ]; then
    export CHECKM_DATA_PATH="$wd/{config.checkm_db}"
fi
run_checkm() {
    # $1 = input glob pattern, $2 = prefix (lineage_wf output basename)
    mkdir -p input_bins
    for f in $1; do
        [ -e "$f" ] || continue
        gzip -cdf "$f" > input_bins/$(basename "$f" .gz)
    done
    if ls input_bins/* >/dev/null 2>&1; then
        checkm \\
            lineage_wf \\
            -t {threads} \\
            -f "$2.tsv" \\
            --tab_table \\
            --pplacer_threads {threads} \\
            -x fa \\
            input_bins/ \\
            "$2"
    else
        # zero-bin group: emit the empty artifacts so the declared-output
        # contract holds; the qa rule guards on the missing lineage.ms
        echo "checkm: no bins matched for {sample} ($2)" 1>&2
        touch "$2.tsv"
        mkdir -p "$2"
    fi
}
mkdir -p {config.out_dir}/GenomeBinning/QC/CheckM
mkdir -p .tmp/checkm_lw_megahit_metabinner_{sample} && cd .tmp/checkm_lw_megahit_metabinner_{sample}
# bins (meta.refinement='unrefined')
run_checkm "$wd/{config.out_dir}/GenomeBinning/MetaBinner/bins/MEGAHIT-MetaBinner-{sample}*.fa.gz" MEGAHIT-MetaBinner-unclassified-unrefined-{sample}_wf
rm -rf input_bins
# unbinned chunks (meta.refinement='unrefined_unbinned')
run_checkm "$wd/{config.out_dir}/GenomeBinning/MetaBinner/unbinned/MEGAHIT-MetaBinner-{sample}*[0-9].fa.gz" MEGAHIT-MetaBinner-unclassified-unrefined_unbinned-{sample}_wf
mv MEGAHIT-MetaBinner-unclassified-unrefined-{sample}_wf* "$wd/{config.out_dir}/GenomeBinning/QC/CheckM/"
mv MEGAHIT-MetaBinner-unclassified-unrefined_unbinned-{sample}_wf* "$wd/{config.out_dir}/GenomeBinning/QC/CheckM/"
cd "$wd"
rm -rf .tmp/checkm_lw_megahit_metabinner_{sample}
"""

[rules.resources]
threads = 4
memory = "16G"
time_limit = "12h"

[rules.environment]
conda = "envs/checkm.yaml"

[[rules]]
name = "checkm_qa_megahit_metabinner"
when = "config.run_checkm"
input = [
    "{config.out_dir}/GenomeBinning/QC/CheckM/MEGAHIT-MetaBinner-unclassified-unrefined-{sample}_wf",
    "{config.out_dir}/GenomeBinning/QC/CheckM/MEGAHIT-MetaBinner-unclassified-unrefined_unbinned-{sample}_wf",
