rm -rf .tmp/busco_spades_concoct_{sample}
"""

[rules.resources]
threads = 6
memory = "16G"
time_limit = "12h"

[rules.environment]
conda = "envs/busco.yaml"

[[rules]]
name = "mag_depths_spades_concoct"
when = "config.reads_sheet == '' || {meta.reads_2} != '' || {meta.reads_layout} == 'interleaved'"
input = [
    "{config.out_dir}/GenomeBinning/CONCOCT/bins",
    "{config.out_dir}/GenomeBinning/CONCOCT/unbinned",
    "intermediates/binning/depths/SPAdes-{sample}-depth.txt.gz",
