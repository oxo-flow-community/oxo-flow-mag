[rules.resources]
threads = 6
memory = "16G"
time_limit = "12h"

[rules.environment]
conda = "envs/busco.yaml"

[[rules]]
name = "mag_depths_megahit_metabat2"
input = [
    "{config.out_dir}/GenomeBinning/MetaBAT2/bins",
    "{config.out_dir}/GenomeBinning/MetaBAT2/unbinned",
    "intermediates/binning/depths/MEGAHIT-{sample}-depth.txt.gz",
]
output = ["intermediates/binning/depths/bins/MEGAHIT-MetaBAT2-{sample}-binDepths.tsv"]
depends_on = ["depths_megahit", "metabat2_megahit", "split_fasta_metabat2_megahit"]
description = "Per-bin median coverage of the MEGAHIT MetaBAT2 bins (upstream MAG_DEPTHS)"
shell = """
mkdir -p intermediates/binning/depths/bins
bins_list=""
for f in {config.out_dir}/GenomeBinning/MetaBAT2/bins/MEGAHIT-MetaBAT2-{sample}*.fa.gz \
         {config.out_dir}/GenomeBinning/MetaBAT2/unbinned/MEGAHIT-MetaBAT2-{sample}*[0-9].fa.gz; do
    [ -e "$f" ] && bins_list="$bins_list $f"
done
if [ -n "$bins_list" ]; then
    get_mag_depths.py --bins $bins_list \
        --depths intermediates/binning/depths/MEGAHIT-{sample}-depth.txt.gz \
        --assembler MEGAHIT \
        --id {sample} \
        --binner MetaBAT2
else
    touch MEGAHIT-MetaBAT2-{sample}-binDepths.tsv
fi
mv MEGAHIT-MetaBAT2-{sample}-binDepths.tsv intermediates/binning/depths/bins/
"""

[rules.resources]
threads = 1
memory = "16G"
time_limit = "4h"

[rules.environment]
conda = "envs/mag_depths.yaml"

[[rules]]
name = "quast_bins_megahit_metabat2"
input = [
    "{config.out_dir}/GenomeBinning/MetaBAT2/bins",
    "{config.out_dir}/GenomeBinning/MetaBAT2/unbinned",
]
output = [
    "{config.out_dir}/GenomeBinning/QC/MEGAHIT-MetaBAT2-unclassified-unrefined-{sample}-quast_summary.tsv",
    "{config.out_dir}/GenomeBinning/QC/MEGAHIT-MetaBAT2-unclassified-unrefined_unbinned-{sample}-quast_summary.tsv",
]
depends_on = ["metabat2_megahit", "split_fasta_metabat2_megahit"]
description = "Per-bin metaQUAST QC of the MEGAHIT MetaBAT2 bins and chunks (upstream QUAST_BINS)"
shell = """
wd=$(pwd)
mkdir -p .tmp/quast_megahit_metabat2_{sample} && cd .tmp/quast_megahit_metabat2_{sample}
run_quast() {
    # $1 = input glob pattern, $2 = summary prefix, $3 = output dir name
    mkdir -p "$3"
    n=0
    for f in $1; do
        [ -e "$f" ] || continue
        bin=$(basename "$f")
        metaquast.py --threads {threads} --max-ref-number 0 --rna-finding --gene-finding -l "$bin" "$f" -o "$3/$bin"
        n=$((n+1))
    done
    if [ "$n" -gt 0 ]; then
        for d in $3/*; do
            if ! [ -f "$2-quast_summary.tsv" ]; then
                cp "$d/transposed_report.tsv" "$2-quast_summary.tsv"
            else
                tail -n +2 "$d/transposed_report.tsv" >> "$2-quast_summary.tsv"
            fi
        done
    else
        touch "$2-quast_summary.tsv"
    fi
}
mkdir -p "$wd/{config.out_dir}/GenomeBinning/QC/QUAST"
# bins (meta.refinement='unrefined')
run_quast "$wd/{config.out_dir}/GenomeBinning/MetaBAT2/bins/MEGAHIT-MetaBAT2-{sample}*.fa.gz" "MEGAHIT-MetaBAT2-unclassified-unrefined-{sample}" QUAST_bins
# unbinned chunks (meta.refinement='unrefined_unbinned')
run_quast "$wd/{config.out_dir}/GenomeBinning/MetaBAT2/unbinned/MEGAHIT-MetaBAT2-{sample}*[0-9].fa.gz" "MEGAHIT-MetaBAT2-unclassified-unrefined_unbinned-{sample}" QUAST_chunks
mv QUAST_bins/* "$wd/{config.out_dir}/GenomeBinning/QC/QUAST/" 2>/dev/null || true
mv QUAST_chunks/* "$wd/{config.out_dir}/GenomeBinning/QC/QUAST/" 2>/dev/null || true
mv *-quast_summary.tsv "$wd/{config.out_dir}/GenomeBinning/QC/"
cd "$wd"
rm -rf .tmp/quast_megahit_metabat2_{sample}
"""

