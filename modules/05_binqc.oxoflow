    # $1 = input glob pattern, $2 = prefix (lineage_wf output basename)
    mkdir -p input_bins
    for f in $1; do
        [ -e "$f" ] || continue
        gzip -cdf "$f" > input_bins/$(basename "$f" .gz)
    done
    if ls input_bins/* >/dev/null 2>&1; then
        checkm \\
            lineage_wf \\
            -t {threads} \\
            -f "$2.tsv" \\
            --tab_table \\
            --pplacer_threads {threads} \\
            -x fa \\
            input_bins/ \\
            "$2"
    else
        # zero-bin group: emit the empty artifacts so the declared-output
        # contract holds; the qa rule guards on the missing lineage.ms
        echo "checkm: no bins matched for {sample} ($2)" 1>&2
        touch "$2.tsv"
        mkdir -p "$2"
    fi
}
mkdir -p {config.out_dir}/GenomeBinning/QC/CheckM
mkdir -p .tmp/checkm_lw_megahit_semibin2_{sample} && cd .tmp/checkm_lw_megahit_semibin2_{sample}
# bins (meta.refinement='unrefined')
run_checkm "$wd/{config.out_dir}/GenomeBinning/SemiBin2/bins/MEGAHIT-SemiBin2-{sample}*.fa.gz" MEGAHIT-SemiBin2-unclassified-unrefined-{sample}_wf
rm -rf input_bins
# unbinned chunks (meta.refinement='unrefined_unbinned'); SemiBin2 has no
# split_fasta upstream, so the glob normally matches nothing
run_checkm "$wd/{config.out_dir}/GenomeBinning/SemiBin2/unbinned/MEGAHIT-SemiBin2-{sample}*[0-9].fa.gz" MEGAHIT-SemiBin2-unclassified-unrefined_unbinned-{sample}_wf
mv MEGAHIT-SemiBin2-unclassified-unrefined-{sample}_wf* "$wd/{config.out_dir}/GenomeBinning/QC/CheckM/"
mv MEGAHIT-SemiBin2-unclassified-unrefined_unbinned-{sample}_wf* "$wd/{config.out_dir}/GenomeBinning/QC/CheckM/"
cd "$wd"
rm -rf .tmp/checkm_lw_megahit_semibin2_{sample}
"""

