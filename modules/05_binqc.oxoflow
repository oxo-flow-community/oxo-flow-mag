        [ -e "$f" ] || continue
        bin=$(basename "$f")
        metaquast.py --threads {threads} --max-ref-number 0 --rna-finding --gene-finding -l "$bin" "$f" -o "$3/$bin"
        n=$((n+1))
    done
    if [ "$n" -gt 0 ]; then
        for d in $3/*; do
            if ! [ -f "$2-quast_summary.tsv" ]; then
                cp "$d/transposed_report.tsv" "$2-quast_summary.tsv"
            else
                tail -n +2 "$d/transposed_report.tsv" >> "$2-quast_summary.tsv"
            fi
        done
    else
        touch "$2-quast_summary.tsv"
    fi
}
mkdir -p "$wd/{config.out_dir}/GenomeBinning/QC/QUAST"
# bins (meta.refinement='unrefined')
run_quast "$wd/{config.out_dir}/GenomeBinning/SemiBin2/bins/MEGAHIT-SemiBin2-{sample}*.fa.gz" "MEGAHIT-SemiBin2-unclassified-unrefined-{sample}" QUAST_bins
# unbinned chunks (meta.refinement='unrefined_unbinned')
run_quast "$wd/{config.out_dir}/GenomeBinning/SemiBin2/unbinned/MEGAHIT-SemiBin2-{sample}*[0-9].fa.gz" "MEGAHIT-SemiBin2-unclassified-unrefined_unbinned-{sample}" QUAST_chunks
mv QUAST_bins/* "$wd/{config.out_dir}/GenomeBinning/QC/QUAST/" 2>/dev/null || true
mv QUAST_chunks/* "$wd/{config.out_dir}/GenomeBinning/QC/QUAST/" 2>/dev/null || true
mv *-quast_summary.tsv "$wd/{config.out_dir}/GenomeBinning/QC/"
cd "$wd"
rm -rf .tmp/quast_megahit_semibin2_{sample}
"""

[rules.resources]
threads = 1
memory = "2G"
time_limit = "4h"

[rules.environment]
conda = "envs/quast.yaml"

# ---------------------------------------------------------------------------
# CONCAT_BUSCO: qsv cat rowskey over every BUSCO batch summary (upstream
# CONCAT_BUSCO_TSV with meta.id='busco' -> busco_summary.tsv)
# ---------------------------------------------------------------------------
[[rules]]
name = "concat_busco"
input = ["{config.out_dir}/GenomeBinning/QC/BUSCO"]
output = ["{config.out_dir}/GenomeBinning/QC/busco_summary.tsv"]
depends_on = [
    "busco_spades_metabat2",
    "busco_spades_maxbin2",
    "busco_spades_concoct",
    "busco_spades_comebin",
    "busco_spades_metabinner",
    "busco_spades_semibin2",
    "busco_megahit_metabat2",
    "busco_megahit_maxbin2",
    "busco_megahit_concoct",
    "busco_megahit_comebin",
    "busco_megahit_metabinner",
    "busco_megahit_semibin2"
]
description = "Concatenate all BUSCO batch summaries (upstream CONCAT_BUSCO_TSV, qsv cat rowskey)"
shell = """
export QSV_SKIP_FORMAT_CHECK=1
mkdir -p {config.out_dir}/GenomeBinning/QC
if ls {config.out_dir}/GenomeBinning/QC/BUSCO/*/*.batch_summary.txt >/dev/null 2>&1; then
    qsv cat rowskey --delimiter '\t' -o busco_summary.tsv {config.out_dir}/GenomeBinning/QC/BUSCO/*/*.batch_summary.txt
else
    touch busco_summary.tsv
fi
mv busco_summary.tsv {config.out_dir}/GenomeBinning/QC/
"""

[rules.resources]
threads = 1
memory = "1G"
time_limit = "4h"

[rules.environment]
conda = "envs/qsv.yaml"

# ---------------------------------------------------------------------------
# MAG_DEPTHS_SUMMARY: combine the per-group binDepths tables into one
# bin_depths_summary.tsv (upstream MAG_DEPTHS_SUMMARY)
# ---------------------------------------------------------------------------
[[rules]]
name = "mag_depths_summary"
input = [
    "intermediates/binning/depths/bins",
    # the helper ships in the repo, not on the env PATH (live: bare
    # `get_mag_depths_summary.py` -> command not found; upstream had
    # it in the container's bin/)
    "scripts/get_mag_depths_summary.py",
]
output = ["{config.out_dir}/GenomeBinning/depths/bins/bin_depths_summary.tsv"]
depends_on = [
    "mag_depths_spades_metabat2",
    "mag_depths_spades_maxbin2",
    "mag_depths_spades_concoct",
    "mag_depths_spades_comebin",
    "mag_depths_spades_metabinner",
    "mag_depths_spades_semibin2",
    "mag_depths_megahit_metabat2",
    "mag_depths_megahit_maxbin2",
    "mag_depths_megahit_concoct",
    "mag_depths_megahit_comebin",
    "mag_depths_megahit_metabinner",
    "mag_depths_megahit_semibin2"
]
description = "Combine all per-group bin depth tables (upstream MAG_DEPTHS_SUMMARY)"
shell = """
mkdir -p {config.out_dir}/GenomeBinning/depths/bins
if ls intermediates/binning/depths/bins/*-binDepths.tsv >/dev/null 2>&1; then
    python scripts/get_mag_depths_summary.py --depths intermediates/binning/depths/bins/*-binDepths.tsv \
        --out bin_depths_summary.tsv
else
    touch bin_depths_summary.tsv
fi
mv bin_depths_summary.tsv {config.out_dir}/GenomeBinning/depths/bins/
"""

[rules.resources]
threads = 1
memory = "7G"
time_limit = "4h"

[rules.environment]
conda = "envs/mag_depths_summary.yaml"

# ---------------------------------------------------------------------------
# CONCAT_QUAST: qsv cat rowskey over every per-group QUAST bin summary
# (upstream CONCAT_QUAST_SUMMARY with meta.id='quast_bin_summary')
# ---------------------------------------------------------------------------
[[rules]]
name = "concat_quast"
input = ["{config.out_dir}/GenomeBinning/QC"]
output = ["{config.out_dir}/GenomeBinning/QC/quast_bin_summary.tsv"]
depends_on = [
    "quast_bins_spades_metabat2",
    "quast_bins_spades_maxbin2",
    "quast_bins_spades_concoct",
    "quast_bins_spades_comebin",
    "quast_bins_spades_metabinner",
    "quast_bins_spades_semibin2",
    "quast_bins_megahit_metabat2",
    "quast_bins_megahit_maxbin2",
    "quast_bins_megahit_concoct",
    "quast_bins_megahit_comebin",
    "quast_bins_megahit_metabinner",
    "quast_bins_megahit_semibin2"
]
description = "Concatenate all per-group QUAST bin summaries (upstream CONCAT_QUAST_SUMMARY, qsv cat rowskey)"
shell = """
export QSV_SKIP_FORMAT_CHECK=1
mkdir -p {config.out_dir}/GenomeBinning/QC
if ls {config.out_dir}/GenomeBinning/QC/*-quast_summary.tsv >/dev/null 2>&1; then
    qsv cat rowskey --delimiter '\t' -o quast_bin_summary.tsv {config.out_dir}/GenomeBinning/QC/*-quast_summary.tsv
else
    touch quast_bin_summary.tsv
fi
mv quast_bin_summary.tsv {config.out_dir}/GenomeBinning/QC/
"""

[rules.resources]
threads = 1
memory = "1G"
time_limit = "4h"

[rules.environment]
conda = "envs/qsv.yaml"

# ---------------------------------------------------------------------------
# ALE (nf-core ALE module; ext.prefix {id}-{assembler}, ext.args
# '--metagenome --nout' at default; publish results/Assembly/{assembler}/QC/{id}/ALE)
# ---------------------------------------------------------------------------
[[rules]]
name = "ale_spades"
input = [
    # the own-readset bam as a FILE input: the dir alone forms no DAG
    # edge and no per-file manifest, so ALE could run against a stale
    # bam next to a fresh assembly and die on its mismatch check (live)
    "intermediates/binning/alignments/SPAdes/SPAdes-{sample}-{sample}.bam",
    "intermediates/assembly/SPAdes/SPAdes-{sample}.scaffolds.fa.gz",
]
output = ["{config.out_dir}/Assembly/SPAdes/QC/{sample}/ALE/{sample}-SPAdes_ALEoutput.txt"]
depends_on = ["bowtie2_align_spades", "spades"]
description = "Assembly Likelihood Evaluation of the SPAdes assembly (upstream ALE on the own-readset alignment)"
shell = """
mkdir -p {config.out_dir}/Assembly/SPAdes/QC/{sample}/ALE
# upstream picks the alignment whose reads match the assembly sample
# (bam.name.endsWith('-{meta.id}.bam')); with group binning the loop above
# produced exactly one such file
own_bam=$(LC_ALL=C ls intermediates/binning/alignments/SPAdes/SPAdes-{sample}-{sample}.bam)
ALE --metagenome --nout "$own_bam" intermediates/assembly/SPAdes/SPAdes-{sample}.scaffolds.fa.gz \
    {sample}-SPAdes_ALEoutput.txt
mv {sample}-SPAdes_ALEoutput.txt {config.out_dir}/Assembly/SPAdes/QC/{sample}/ALE/
"""

[rules.resources]
threads = 1
memory = "18G"
time_limit = "4h"

[rules.environment]
conda = "envs/ale.yaml"

[[rules]]
name = "ale_megahit"
input = [
    # the own-readset bam as a FILE input: the dir alone forms no DAG
    # edge and no per-file manifest, so ALE could run against a stale
    # bam next to a fresh assembly and die on its mismatch check (live)
    "intermediates/binning/alignments/MEGAHIT/MEGAHIT-{sample}-{sample}.bam",
    "intermediates/assembly/MEGAHIT/MEGAHIT-{sample}.contigs.fa.gz",
]
output = ["{config.out_dir}/Assembly/MEGAHIT/QC/{sample}/ALE/{sample}-MEGAHIT_ALEoutput.txt"]
depends_on = ["bowtie2_align_megahit", "megahit"]
description = "Assembly Likelihood Evaluation of the MEGAHIT assembly (upstream ALE on the own-readset alignment)"
shell = """
mkdir -p {config.out_dir}/Assembly/MEGAHIT/QC/{sample}/ALE
own_bam=$(LC_ALL=C ls intermediates/binning/alignments/MEGAHIT/MEGAHIT-{sample}-{sample}.bam)
ALE --metagenome --nout "$own_bam" intermediates/assembly/MEGAHIT/MEGAHIT-{sample}.contigs.fa.gz \
    {sample}-MEGAHIT_ALEoutput.txt
mv {sample}-MEGAHIT_ALEoutput.txt {config.out_dir}/Assembly/MEGAHIT/QC/{sample}/ALE/
"""

[rules.resources]
threads = 1
memory = "18G"
time_limit = "4h"

[rules.environment]
conda = "envs/ale.yaml"
