    "{config.out_dir}/GenomeBinning/QC/GUNC/raw/MEGAHIT-CONCOCT-unclassified-unrefined_unbinned-{sample}/MEGAHIT-CONCOCT-unclassified-unrefined_unbinned-{sample}_maxCSS_level.tsv",
    "{config.out_dir}/GenomeBinning/QC/CheckM/MEGAHIT-CONCOCT-unclassified-unrefined-{sample}_qa.txt",
    "{config.out_dir}/GenomeBinning/QC/CheckM/MEGAHIT-CONCOCT-unclassified-unrefined_unbinned-{sample}_qa.txt",
]
output = [
    "{config.out_dir}/GenomeBinning/QC/GUNC/checkmmerged/MEGAHIT-CONCOCT-unclassified-unrefined-{sample}/gunc_merge_checkm.tsv",
    "{config.out_dir}/GenomeBinning/QC/GUNC/checkmmerged/MEGAHIT-CONCOCT-unclassified-unrefined_unbinned-{sample}/gunc_merge_checkm.tsv",
]
depends_on = ["gunc_megahit_concoct", "checkm_qa_megahit_concoct"]
description = "GUNC merge_checkm of the MEGAHIT CONCOCT groups (upstream GUNC_MERGECHECKM)"
shell = """
wd=$(pwd)
run_merge() {
    # $1 = gunc maxCSS tsv, $2 = checkm qa txt, $3 = publish dir
    mkdir -p "$3"
    if [ -s "$1" ] && [ -s "$2" ]; then
        gunc \\
            merge_checkm \\
            -g "$1" \\
            -c "$2" \\
            -o .
        mv gunc_merge_checkm.tsv "$3/"
    else
        touch "$3/gunc_merge_checkm.tsv"
    fi
}
mkdir -p {config.out_dir}/GenomeBinning/QC/GUNC/checkmmerged
run_merge "$wd/{input[0]}" "$wd/{input[2]}" "$wd/{config.out_dir}/GenomeBinning/QC/GUNC/checkmmerged/MEGAHIT-CONCOCT-unclassified-unrefined-{sample}"
run_merge "$wd/{input[1]}" "$wd/{input[3]}" "$wd/{config.out_dir}/GenomeBinning/QC/GUNC/checkmmerged/MEGAHIT-CONCOCT-unclassified-unrefined_unbinned-{sample}"
"""

