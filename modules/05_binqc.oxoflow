[rules.resources]
threads = 1
memory = "4G"
time_limit = "4h"

[rules.environment]
conda = "envs/gunc.yaml"

[[rules]]
name = "concat_gunc_checkm_tsv"
when = "config.run_gunc && config.run_checkm"
input = ["{config.out_dir}/GenomeBinning/QC/GUNC/checkmmerged"]
output = ["{config.out_dir}/GenomeBinning/QC/gunc_checkm_summary.tsv"]
depends_on = [
    "gunc_mergecheckm_spades_metabat2",
    "gunc_mergecheckm_spades_maxbin2",
    "gunc_mergecheckm_spades_concoct",
    "gunc_mergecheckm_spades_comebin",
    "gunc_mergecheckm_spades_metabinner",
    "gunc_mergecheckm_spades_semibin2",
    "gunc_mergecheckm_megahit_metabat2",
    "gunc_mergecheckm_megahit_maxbin2",
    "gunc_mergecheckm_megahit_concoct",
    "gunc_mergecheckm_megahit_comebin",
    "gunc_mergecheckm_megahit_metabinner",
    "gunc_mergecheckm_megahit_semibin2",
]
description = "Concatenate all GUNC merge_checkm tables (upstream CONCAT_GUNC_CHECKM_TSV, qsv cat rowskey)"
shell = """
export QSV_SKIP_FORMAT_CHECK=1
mkdir -p {config.out_dir}/GenomeBinning/QC
if ls {config.out_dir}/GenomeBinning/QC/GUNC/checkmmerged/*/gunc_merge_checkm.tsv >/dev/null 2>&1; then
    qsv cat rowskey --delimiter '\\t' -o gunc_checkm_summary.tsv {config.out_dir}/GenomeBinning/QC/GUNC/checkmmerged/*/gunc_merge_checkm.tsv
else
    touch gunc_checkm_summary.tsv
fi
mv gunc_checkm_summary.tsv {config.out_dir}/GenomeBinning/QC/
"""

[rules.resources]
threads = 1
memory = "6G"
time_limit = "4h"

[rules.environment]
conda = "envs/qsv.yaml"


