# upstream: BUSCO_BBTOOLS_MEMORY export + augustus config fix (both no-ops
# when the variables are unset; kept verbatim for fidelity)
export BUSCO_BBTOOLS_MEMORY=4g
ENV_AUGUSTUS=/opt/conda/etc/conda/activate.d/augustus.sh
set +u
if [ -z "${AUGUSTUS_CONFIG_PATH}" ] && [ -f "${ENV_AUGUSTUS}" ]; then
    source "${ENV_AUGUSTUS}"
fi
set -u
if [ ! -w "${AUGUSTUS_CONFIG_PATH}" ]; then
    AUG_CONF_DIR=$( mktemp -d -p $PWD )
    cp -r ${AUGUSTUS_CONFIG_PATH}/* $AUG_CONF_DIR
    export AUGUSTUS_CONFIG_PATH=$AUG_CONF_DIR
fi
run_busco() {
    # $1 = input glob pattern, $2 = publish dir (results)
    mkdir -p input_seqs
    for f in $1; do
        [ -e "$f" ] || continue
        gzip -cdf "$f" > input_seqs/$(basename "$f" .gz)
    done
    if ls input_seqs/* >/dev/null 2>&1; then
        busco --cpu {threads} --in input_seqs --out {sample}-auto-busco --mode genome --auto-lineage
        if [ -f {sample}-auto-busco/batch_summary.txt ]; then
            grep -v 'Run failed; check logs' {sample}-auto-busco/batch_summary.txt > {sample}-auto-busco.batch_summary.txt
        else
            touch {sample}-auto-busco.batch_summary.txt
        fi
        mv {sample}-auto-busco/*/short_summary.*.txt . 2>/dev/null || true
        mv {sample}-auto-busco/*/short_summary.*.json . 2>/dev/null || true
        mv {sample}-auto-busco/logs/busco.log {sample}-auto-busco.log 2>/dev/null || true
    else
        touch {sample}-auto-busco.batch_summary.txt
        # upstream BUSCO_BUSCO: a run that never produced a batch summary
        # leaves the *.batch_summary.failed.txt error artifact (and exits
        # non-zero at the process level; here the empty summary is the
        # failure marker consumers already handle).
        cp {sample}-auto-busco.batch_summary.txt {sample}-auto-busco.batch_summary.failed.txt
    fi
    mkdir -p "$wd/$2"
    mv {sample}-auto-busco.batch_summary.txt "$wd/$2/"
    [ -f {sample}-auto-busco.batch_summary.failed.txt ] && mv {sample}-auto-busco.batch_summary.failed.txt "$wd/$2/" || true
    mv {sample}-auto-busco.log "$wd/$2/" 2>/dev/null || true
    mv short_summary.* "$wd/$2/" 2>/dev/null || true
}
mkdir -p {config.out_dir}/GenomeBinning/QC/BUSCO
mkdir -p .tmp/busco_megahit_concoct_{sample} && cd .tmp/busco_megahit_concoct_{sample}
# bins (meta.refinement='unrefined')
run_busco "$wd/{config.out_dir}/GenomeBinning/CONCOCT/bins/MEGAHIT-CONCOCT-{sample}*.fa.gz" "{config.out_dir}/GenomeBinning/QC/BUSCO/MEGAHIT-CONCOCT-unclassified-unrefined-{sample}"
rm -rf input_seqs {sample}-auto-busco
# unbinned chunks (meta.refinement='unrefined_unbinned')
run_busco "$wd/{config.out_dir}/GenomeBinning/CONCOCT/unbinned/MEGAHIT-CONCOCT-{sample}*[0-9].fa.gz" "{config.out_dir}/GenomeBinning/QC/BUSCO/MEGAHIT-CONCOCT-unclassified-unrefined_unbinned-{sample}"
cd "$wd"
rm -rf .tmp/busco_megahit_concoct_{sample}
"""

[rules.resources]
threads = 6
memory = "16G"
time_limit = "12h"

[rules.environment]
conda = "envs/busco.yaml"

[[rules]]
name = "mag_depths_megahit_concoct"
input = [
    "{config.out_dir}/GenomeBinning/CONCOCT/bins",
    "{config.out_dir}/GenomeBinning/CONCOCT/unbinned",
    "intermediates/binning/depths/MEGAHIT-{sample}-depth.txt.gz",
]
output = ["intermediates/binning/depths/bins/MEGAHIT-CONCOCT-{sample}-binDepths.tsv"]
depends_on = ["depths_megahit", "concoct_extract_megahit"]
description = "Per-bin median coverage of the MEGAHIT CONCOCT bins (upstream MAG_DEPTHS)"
shell = """
mkdir -p intermediates/binning/depths/bins
bins_list=""
for f in {config.out_dir}/GenomeBinning/CONCOCT/bins/MEGAHIT-CONCOCT-{sample}*.fa.gz \
         {config.out_dir}/GenomeBinning/CONCOCT/unbinned/MEGAHIT-CONCOCT-{sample}*[0-9].fa.gz; do
    [ -e "$f" ] && bins_list="$bins_list $f"
done
if [ -n "$bins_list" ]; then
    python scripts/get_mag_depths.py --bins $bins_list \
        --depths intermediates/binning/depths/MEGAHIT-{sample}-depth.txt.gz \
        --assembler MEGAHIT \
        --id {sample} \
        --binner CONCOCT
else
    touch MEGAHIT-CONCOCT-{sample}-binDepths.tsv
fi
mv MEGAHIT-CONCOCT-{sample}-binDepths.tsv intermediates/binning/depths/bins/
"""

[rules.resources]
threads = 1
memory = "16G"
time_limit = "4h"

[rules.environment]
conda = "envs/mag_depths.yaml"

[[rules]]
name = "quast_bins_megahit_concoct"
input = [
    "{config.out_dir}/GenomeBinning/CONCOCT/bins",
    "{config.out_dir}/GenomeBinning/CONCOCT/unbinned",
]
output = [
    "{config.out_dir}/GenomeBinning/QC/MEGAHIT-CONCOCT-unclassified-unrefined-{sample}-quast_summary.tsv",
    "{config.out_dir}/GenomeBinning/QC/MEGAHIT-CONCOCT-unclassified-unrefined_unbinned-{sample}-quast_summary.tsv",
]
depends_on = ["concoct_extract_megahit"]
description = "Per-bin metaQUAST QC of the MEGAHIT CONCOCT bins and chunks (upstream QUAST_BINS)"
shell = """
wd=$(pwd)
mkdir -p .tmp/quast_megahit_concoct_{sample} && cd .tmp/quast_megahit_concoct_{sample}
run_quast() {
    # $1 = input glob pattern, $2 = summary prefix, $3 = output dir name
    mkdir -p "$3"
    n=0
    for f in $1; do
        [ -e "$f" ] || continue
        bin=$(basename "$f")
        metaquast.py --threads {threads} --max-ref-number 0 --rna-finding --gene-finding -l "$bin" "$f" -o "$3/$bin"
        n=$((n+1))
    done
    if [ "$n" -gt 0 ]; then
        for d in $3/*; do
            if ! [ -f "$2-quast_summary.tsv" ]; then
                cp "$d/transposed_report.tsv" "$2-quast_summary.tsv"
            else
                tail -n +2 "$d/transposed_report.tsv" >> "$2-quast_summary.tsv"
            fi
        done
    else
        touch "$2-quast_summary.tsv"
    fi
}
mkdir -p "$wd/{config.out_dir}/GenomeBinning/QC/QUAST"
# bins (meta.refinement='unrefined')
run_quast "$wd/{config.out_dir}/GenomeBinning/CONCOCT/bins/MEGAHIT-CONCOCT-{sample}*.fa.gz" "MEGAHIT-CONCOCT-unclassified-unrefined-{sample}" QUAST_bins
# unbinned chunks (meta.refinement='unrefined_unbinned')
run_quast "$wd/{config.out_dir}/GenomeBinning/CONCOCT/unbinned/MEGAHIT-CONCOCT-{sample}*[0-9].fa.gz" "MEGAHIT-CONCOCT-unclassified-unrefined_unbinned-{sample}" QUAST_chunks
mv QUAST_bins/* "$wd/{config.out_dir}/GenomeBinning/QC/QUAST/" 2>/dev/null || true
mv QUAST_chunks/* "$wd/{config.out_dir}/GenomeBinning/QC/QUAST/" 2>/dev/null || true
mv *-quast_summary.tsv "$wd/{config.out_dir}/GenomeBinning/QC/"
cd "$wd"
rm -rf .tmp/quast_megahit_concoct_{sample}
"""

