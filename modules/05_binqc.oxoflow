mkdir -p .tmp/busco_spades_concoct_{sample} && cd .tmp/busco_spades_concoct_{sample}
# bins (meta.refinement='unrefined')
run_busco "$wd/{config.out_dir}/GenomeBinning/CONCOCT/bins/SPAdes-CONCOCT-{sample}*.fa.gz" "{config.out_dir}/GenomeBinning/QC/BUSCO/SPAdes-CONCOCT-unclassified-unrefined-{sample}"
rm -rf input_seqs {sample}-auto-busco
# unbinned chunks (meta.refinement='unrefined_unbinned')
run_busco "$wd/{config.out_dir}/GenomeBinning/CONCOCT/unbinned/SPAdes-CONCOCT-{sample}*[0-9].fa.gz" "{config.out_dir}/GenomeBinning/QC/BUSCO/SPAdes-CONCOCT-unclassified-unrefined_unbinned-{sample}"
