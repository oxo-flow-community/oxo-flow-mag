run_checkm2 "$wd/{config.out_dir}/GenomeBinning/MetaBinner/bins/MEGAHIT-MetaBinner-{sample}*.fa.gz" MEGAHIT-MetaBinner-unclassified-unrefined-{sample}
rm -rf input_bins
# unbinned chunks (meta.refinement='unrefined_unbinned')
run_checkm2 "$wd/{config.out_dir}/GenomeBinning/MetaBinner/unbinned/MEGAHIT-MetaBinner-{sample}*[0-9].fa.gz" MEGAHIT-MetaBinner-unclassified-unrefined_unbinned-{sample}
mv MEGAHIT-MetaBinner-unclassified-unrefined-{sample}_checkm2_report.tsv "$wd/{config.out_dir}/GenomeBinning/QC/CheckM2/"
mv MEGAHIT-MetaBinner-unclassified-unrefined_unbinned-{sample}_checkm2_report.tsv "$wd/{config.out_dir}/GenomeBinning/QC/CheckM2/"
cd "$wd"
rm -rf .tmp/checkm2_megahit_metabinner_{sample}
"""

[rules.resources]
threads = 4
memory = "16G"
time_limit = "12h"

[rules.environment]
conda = "envs/checkm2.yaml"

[[rules]]
name = "checkm2_megahit_semibin2"
when = "config.run_checkm2"
input = [
    "{config.out_dir}/GenomeBinning/SemiBin2/bins",
    "{config.out_dir}/GenomeBinning/SemiBin2/unbinned",
]
output = [
    "{config.out_dir}/GenomeBinning/QC/CheckM2/MEGAHIT-SemiBin2-unclassified-unrefined-{sample}_checkm2_report.tsv",
    "{config.out_dir}/GenomeBinning/QC/CheckM2/MEGAHIT-SemiBin2-unclassified-unrefined_unbinned-{sample}_checkm2_report.tsv",
]
depends_on = ["semibin_megahit"]
description = "CheckM2 predict of the MEGAHIT SemiBin2 bins and chunks (upstream CHECKM2_PREDICT)"
shell = """
wd=$(pwd)
if [ -z "{config.checkm2_db}" ]; then
    echo "checkm2: config.checkm2_db must point to a local CheckM2 database (.dmnd) when run_checkm2=true" 1>&2
    exit 1
fi
run_checkm2() {
    # $1 = input glob pattern, $2 = prefix (predict output basename)
    mkdir -p input_bins
    for f in $1; do
        [ -e "$f" ] || continue
        gzip -cdf "$f" > input_bins/$(basename "$f" .gz)
    done
    if ls input_bins/* >/dev/null 2>&1; then
        checkm2 \\
            predict \\
            --input input_bins/* \\
            --output-directory "$2" \\
            --threads {threads} \\
            --database_path "$wd/{config.checkm2_db}"
        cp "$2/quality_report.tsv" "$2_checkm2_report.tsv"
    else
        # zero-bin group: emit the empty artifact so the declared-output
        # contract holds
        echo "checkm2: no bins matched for {sample} ($2)" 1>&2
        mkdir -p "$2"
        touch "$2_checkm2_report.tsv"
    fi
}
mkdir -p {config.out_dir}/GenomeBinning/QC/CheckM2
mkdir -p .tmp/checkm2_megahit_semibin2_{sample} && cd .tmp/checkm2_megahit_semibin2_{sample}
# bins (meta.refinement='unrefined')
run_checkm2 "$wd/{config.out_dir}/GenomeBinning/SemiBin2/bins/MEGAHIT-SemiBin2-{sample}*.fa.gz" MEGAHIT-SemiBin2-unclassified-unrefined-{sample}
rm -rf input_bins
# unbinned chunks (meta.refinement='unrefined_unbinned')
run_checkm2 "$wd/{config.out_dir}/GenomeBinning/SemiBin2/unbinned/MEGAHIT-SemiBin2-{sample}*[0-9].fa.gz" MEGAHIT-SemiBin2-unclassified-unrefined_unbinned-{sample}
mv MEGAHIT-SemiBin2-unclassified-unrefined-{sample}_checkm2_report.tsv "$wd/{config.out_dir}/GenomeBinning/QC/CheckM2/"
mv MEGAHIT-SemiBin2-unclassified-unrefined_unbinned-{sample}_checkm2_report.tsv "$wd/{config.out_dir}/GenomeBinning/QC/CheckM2/"
cd "$wd"
rm -rf .tmp/checkm2_megahit_semibin2_{sample}
"""

[rules.resources]
threads = 4
memory = "16G"
time_limit = "12h"

[rules.environment]
conda = "envs/checkm2.yaml"

[[rules]]
name = "concat_checkm2_tsv"
when = "config.run_checkm2"
input = ["{config.out_dir}/GenomeBinning/QC/CheckM2"]
output = ["{config.out_dir}/GenomeBinning/QC/checkm2_summary.tsv"]
depends_on = [
    "checkm2_spades_metabat2",
    "checkm2_spades_maxbin2",
    "checkm2_spades_concoct",
    "checkm2_spades_comebin",
    "checkm2_spades_metabinner",
    "checkm2_spades_semibin2",
    "checkm2_megahit_metabat2",
    "checkm2_megahit_maxbin2",
    "checkm2_megahit_concoct",
    "checkm2_megahit_comebin",
    "checkm2_megahit_metabinner",
    "checkm2_megahit_semibin2",
]
description = "Concatenate all CheckM2 report tables (upstream CONCAT_CHECKM2_TSV, qsv cat rowskey)"
shell = """
export QSV_SKIP_FORMAT_CHECK=1
mkdir -p {config.out_dir}/GenomeBinning/QC
if ls {config.out_dir}/GenomeBinning/QC/CheckM2/*_checkm2_report.tsv >/dev/null 2>&1; then
    qsv cat rowskey --delimiter '\\t' -o checkm2_summary.tsv {config.out_dir}/GenomeBinning/QC/CheckM2/*_checkm2_report.tsv
else
    touch checkm2_summary.tsv
fi
mv checkm2_summary.tsv {config.out_dir}/GenomeBinning/QC/
"""

[rules.resources]
threads = 1
memory = "6G"
time_limit = "4h"

[rules.environment]
conda = "envs/qsv.yaml"


# ---------------------------------------------------------------------------
# GUNC contamination QC (upstream BIN_QC gunc section: GUNC_RUN ->
# CONCAT_GUNC_TSV, plus GUNC_MERGECHECKM -> CONCAT_GUNC_CHECKM_TSV when
# run_checkm is also on). The reference database is user-provided
# (config.gunc_db).
# ---------------------------------------------------------------------------
[[rules]]
name = "gunc_spades_metabat2"
when = "config.run_gunc"
input = [
    "{config.out_dir}/GenomeBinning/MetaBAT2/bins",
    "{config.out_dir}/GenomeBinning/MetaBAT2/unbinned",
]
output = [
    "{config.out_dir}/GenomeBinning/QC/GUNC/raw/SPAdes-MetaBAT2-unclassified-unrefined-{sample}/SPAdes-MetaBAT2-unclassified-unrefined-{sample}_maxCSS_level.tsv",
    "{config.out_dir}/GenomeBinning/QC/GUNC/raw/SPAdes-MetaBAT2-unclassified-unrefined-{sample}/SPAdes-MetaBAT2-unclassified-unrefined-{sample}_all_levels.tsv",
    "{config.out_dir}/GenomeBinning/QC/GUNC/raw/SPAdes-MetaBAT2-unclassified-unrefined_unbinned-{sample}/SPAdes-MetaBAT2-unclassified-unrefined_unbinned-{sample}_maxCSS_level.tsv",
    "{config.out_dir}/GenomeBinning/QC/GUNC/raw/SPAdes-MetaBAT2-unclassified-unrefined_unbinned-{sample}/SPAdes-MetaBAT2-unclassified-unrefined_unbinned-{sample}_all_levels.tsv",
]
depends_on = ["metabat2_spades", "split_fasta_metabat2_spades"]
description = "GUNC run of the SPAdes MetaBAT2 bins and chunks (upstream GUNC_RUN)"
shell = """
wd=$(pwd)
if [ -z "{config.gunc_db}" ]; then
    echo "gunc: config.gunc_db must point to a local GUNC database when run_gunc=true" 1>&2
    exit 1
fi
run_gunc() {
    # $1 = input glob pattern, $2 = prefix (output basename)
    mkdir -p input_files
    for f in $1; do
        [ -e "$f" ] || continue
        ln -sf "$f" input_files/$(basename "$f")
    done
    if ls input_files/* >/dev/null 2>&1; then
        ls input_files/* > input_files.txt
        gunc \\
            run \\
            --input_file input_files.txt \\
            --db_file "$wd/{config.gunc_db}" \\
            --threads {threads}
        # gunc names the tables after the database file; rename to the group
        # prefix so raw/<prefix>/ holds exactly one group's tables
        mv *maxCSS_level.tsv "$2_maxCSS_level.tsv"
        mv *all_levels.tsv "$2_all_levels.tsv" 2>/dev/null || touch "$2_all_levels.tsv"
    else
        # zero-bin group: emit the empty artifacts so the declared-output
        # contract holds
        echo "gunc: no bins matched for {sample} ($2)" 1>&2
        touch "$2_maxCSS_level.tsv"
        touch "$2_all_levels.tsv"
    fi
    mkdir -p "$wd/{config.out_dir}/GenomeBinning/QC/GUNC/raw/$2"
    mv "$2_maxCSS_level.tsv" "$wd/{config.out_dir}/GenomeBinning/QC/GUNC/raw/$2/"
    mv "$2_all_levels.tsv" "$wd/{config.out_dir}/GenomeBinning/QC/GUNC/raw/$2/"
}
mkdir -p {config.out_dir}/GenomeBinning/QC/GUNC/raw
mkdir -p .tmp/gunc_spades_metabat2_{sample} && cd .tmp/gunc_spades_metabat2_{sample}
# bins (meta.refinement='unrefined')
run_gunc "$wd/{config.out_dir}/GenomeBinning/MetaBAT2/bins/SPAdes-MetaBAT2-{sample}*.fa.gz" SPAdes-MetaBAT2-unclassified-unrefined-{sample}
rm -rf input_files
# unbinned chunks (meta.refinement='unrefined_unbinned')
run_gunc "$wd/{config.out_dir}/GenomeBinning/MetaBAT2/unbinned/SPAdes-MetaBAT2-{sample}*[0-9].fa.gz" SPAdes-MetaBAT2-unclassified-unrefined_unbinned-{sample}
cd "$wd"
rm -rf .tmp/gunc_spades_metabat2_{sample}
"""

