        cp "$2/quality_report.tsv" "$2_checkm2_report.tsv"
    else
        # zero-bin group: emit the empty artifact so the declared-output
        # contract holds
        echo "checkm2: no bins matched for {sample} ($2)" 1>&2
        mkdir -p "$2"
        touch "$2_checkm2_report.tsv"
    fi
}
mkdir -p {config.out_dir}/GenomeBinning/QC/CheckM2
mkdir -p .tmp/checkm2_spades_maxbin2_{sample} && cd .tmp/checkm2_spades_maxbin2_{sample}
# bins (meta.refinement='unrefined')
run_checkm2 "$wd/{config.out_dir}/GenomeBinning/MaxBin2/bins/SPAdes-MaxBin2-{sample}*.fa.gz" SPAdes-MaxBin2-unclassified-unrefined-{sample}
rm -rf input_bins
# unbinned chunks (meta.refinement='unrefined_unbinned')
run_checkm2 "$wd/{config.out_dir}/GenomeBinning/MaxBin2/unbinned/SPAdes-MaxBin2-{sample}*[0-9].fa.gz" SPAdes-MaxBin2-unclassified-unrefined_unbinned-{sample}
mv SPAdes-MaxBin2-unclassified-unrefined-{sample}_checkm2_report.tsv "$wd/{config.out_dir}/GenomeBinning/QC/CheckM2/"
mv SPAdes-MaxBin2-unclassified-unrefined_unbinned-{sample}_checkm2_report.tsv "$wd/{config.out_dir}/GenomeBinning/QC/CheckM2/"
cd "$wd"
rm -rf .tmp/checkm2_spades_maxbin2_{sample}
"""

