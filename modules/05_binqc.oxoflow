    "intermediates/binning/depths/MEGAHIT-{sample}-depth.txt.gz",
]
output = ["intermediates/binning/depths/bins/MEGAHIT-COMEBin-{sample}-binDepths.tsv"]
depends_on = ["depths_megahit", "comebin_megahit"]
description = "Per-bin median coverage of the MEGAHIT COMEBin bins (upstream MAG_DEPTHS)"
shell = """
mkdir -p intermediates/binning/depths/bins
bins_list=""
for f in {config.out_dir}/GenomeBinning/COMEBin/bins/MEGAHIT-COMEBin-{sample}*.fa.gz \
         {config.out_dir}/GenomeBinning/COMEBin/unbinned/MEGAHIT-COMEBin-{sample}*[0-9].fa.gz; do
    [ -e "$f" ] && bins_list="$bins_list $f"
done
if [ -n "$bins_list" ]; then
    get_mag_depths.py --bins $bins_list \
        --depths intermediates/binning/depths/MEGAHIT-{sample}-depth.txt.gz \
        --assembler MEGAHIT \
        --id {sample} \
        --binner COMEBin
else
    touch MEGAHIT-COMEBin-{sample}-binDepths.tsv
fi
mv MEGAHIT-COMEBin-{sample}-binDepths.tsv intermediates/binning/depths/bins/
"""

