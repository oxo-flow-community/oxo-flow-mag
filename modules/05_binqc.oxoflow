conda = "envs/mag_depths.yaml"

[[rules]]
name = "quast_bins_megahit_comebin"
input = [
    "{config.out_dir}/GenomeBinning/COMEBin/bins",
    "{config.out_dir}/GenomeBinning/COMEBin/unbinned",
]
output = [
    "{config.out_dir}/GenomeBinning/QC/MEGAHIT-COMEBin-unclassified-unrefined-{sample}-quast_summary.tsv",
    "{config.out_dir}/GenomeBinning/QC/MEGAHIT-COMEBin-unclassified-unrefined_unbinned-{sample}-quast_summary.tsv",
]
depends_on = ["comebin_megahit"]
description = "Per-bin metaQUAST QC of the MEGAHIT COMEBin bins and chunks (upstream QUAST_BINS)"
shell = """
wd=$(pwd)
mkdir -p .tmp/quast_megahit_comebin_{sample} && cd .tmp/quast_megahit_comebin_{sample}
run_quast() {
    # $1 = input glob pattern, $2 = summary prefix, $3 = output dir name
    mkdir -p "$3"
    n=0
    for f in $1; do
        [ -e "$f" ] || continue
        bin=$(basename "$f")
        metaquast.py --threads {threads} --max-ref-number 0 --rna-finding --gene-finding -l "$bin" "$f" -o "$3/$bin"
        n=$((n+1))
    done
    if [ "$n" -gt 0 ]; then
        for d in $3/*; do
            if ! [ -f "$2-quast_summary.tsv" ]; then
                cp "$d/transposed_report.tsv" "$2-quast_summary.tsv"
            else
                tail -n +2 "$d/transposed_report.tsv" >> "$2-quast_summary.tsv"
            fi
        done
    else
        touch "$2-quast_summary.tsv"
    fi
}
mkdir -p "$wd/{config.out_dir}/GenomeBinning/QC/QUAST"
# bins (meta.refinement='unrefined')
run_quast "$wd/{config.out_dir}/GenomeBinning/COMEBin/bins/MEGAHIT-COMEBin-{sample}*.fa.gz" "MEGAHIT-COMEBin-unclassified-unrefined-{sample}" QUAST_bins
# unbinned chunks (meta.refinement='unrefined_unbinned')
run_quast "$wd/{config.out_dir}/GenomeBinning/COMEBin/unbinned/MEGAHIT-COMEBin-{sample}*[0-9].fa.gz" "MEGAHIT-COMEBin-unclassified-unrefined_unbinned-{sample}" QUAST_chunks
mv QUAST_bins/* "$wd/{config.out_dir}/GenomeBinning/QC/QUAST/" 2>/dev/null || true
mv QUAST_chunks/* "$wd/{config.out_dir}/GenomeBinning/QC/QUAST/" 2>/dev/null || true
mv *-quast_summary.tsv "$wd/{config.out_dir}/GenomeBinning/QC/"
cd "$wd"
rm -rf .tmp/quast_megahit_comebin_{sample}
"""

