[rules.resources]
threads = 1
memory = "2G"
time_limit = "4h"

[rules.environment]
conda = "envs/quast.yaml"

[[rules]]
name = "busco_spades_concoct"
input = [
    "{config.out_dir}/GenomeBinning/CONCOCT/bins",
    "{config.out_dir}/GenomeBinning/CONCOCT/unbinned",
]
output = [
    "{config.out_dir}/GenomeBinning/QC/BUSCO/SPAdes-CONCOCT-unclassified-unrefined-{sample}/{sample}-auto-busco.batch_summary.txt",
    "{config.out_dir}/GenomeBinning/QC/BUSCO/SPAdes-CONCOCT-unclassified-unrefined_unbinned-{sample}/{sample}-auto-busco.batch_summary.txt",
]
depends_on = ["concoct_extract_spades"]
description = "BUSCO completeness of the SPAdes CONCOCT bins and unbinned chunks (upstream BUSCO_BUSCO, --auto-lineage)"
shell = """
wd=$(pwd)
# upstream: BUSCO_BBTOOLS_MEMORY export + augustus config fix (both no-ops
# when the variables are unset; kept verbatim for fidelity)
export BUSCO_BBTOOLS_MEMORY=4g
