run_quast "$wd/{config.out_dir}/GenomeBinning/MetaBinner/bins/MEGAHIT-MetaBinner-{sample}*.fa.gz" "MEGAHIT-MetaBinner-unclassified-unrefined-{sample}" QUAST_bins
# unbinned chunks (meta.refinement='unrefined_unbinned')
run_quast "$wd/{config.out_dir}/GenomeBinning/MetaBinner/unbinned/MEGAHIT-MetaBinner-{sample}*[0-9].fa.gz" "MEGAHIT-MetaBinner-unclassified-unrefined_unbinned-{sample}" QUAST_chunks
mv QUAST_bins/* "$wd/{config.out_dir}/GenomeBinning/QC/QUAST/" 2>/dev/null || true
mv QUAST_chunks/* "$wd/{config.out_dir}/GenomeBinning/QC/QUAST/" 2>/dev/null || true
mv *-quast_summary.tsv "$wd/{config.out_dir}/GenomeBinning/QC/"
cd "$wd"
rm -rf .tmp/quast_megahit_metabinner_{sample}
"""

[rules.resources]
threads = 1
memory = "2G"
time_limit = "4h"

[rules.environment]
conda = "envs/quast.yaml"

[[rules]]
name = "busco_megahit_semibin2"
input = [
    "{config.out_dir}/GenomeBinning/SemiBin2/bins",
    "{config.out_dir}/GenomeBinning/SemiBin2/unbinned",
]
output = [
    "{config.out_dir}/GenomeBinning/QC/BUSCO/MEGAHIT-SemiBin2-unclassified-unrefined-{sample}/{sample}-auto-busco.batch_summary.txt",
    "{config.out_dir}/GenomeBinning/QC/BUSCO/MEGAHIT-SemiBin2-unclassified-unrefined_unbinned-{sample}/{sample}-auto-busco.batch_summary.txt",
]
depends_on = ["semibin_megahit"]
description = "BUSCO completeness of the MEGAHIT SemiBin2 bins and unbinned chunks (upstream BUSCO_BUSCO, --auto-lineage)"
shell = """
wd=$(pwd)
# upstream: BUSCO_BBTOOLS_MEMORY export + augustus config fix (both no-ops
# when the variables are unset; kept verbatim for fidelity)
export BUSCO_BBTOOLS_MEMORY=4g
ENV_AUGUSTUS=/opt/conda/etc/conda/activate.d/augustus.sh
set +u
if [ -z "${AUGUSTUS_CONFIG_PATH}" ] && [ -f "${ENV_AUGUSTUS}" ]; then
    source "${ENV_AUGUSTUS}"
fi
set -u
if [ ! -w "${AUGUSTUS_CONFIG_PATH}" ]; then
    AUG_CONF_DIR=$( mktemp -d -p $PWD )
    cp -r ${AUGUSTUS_CONFIG_PATH}/* $AUG_CONF_DIR
    export AUGUSTUS_CONFIG_PATH=$AUG_CONF_DIR
fi
run_busco() {
    # $1 = input glob pattern, $2 = publish dir (results)
    mkdir -p input_seqs
    for f in $1; do
        [ -e "$f" ] || continue
        gzip -cdf "$f" > input_seqs/$(basename "$f" .gz)
    done
    if ls input_seqs/* >/dev/null 2>&1; then
        busco --cpu {threads} --in input_seqs --out {sample}-auto-busco --mode genome --auto-lineage
        if [ -f {sample}-auto-busco/batch_summary.txt ]; then
            grep -v 'Run failed; check logs' {sample}-auto-busco/batch_summary.txt > {sample}-auto-busco.batch_summary.txt
        else
            touch {sample}-auto-busco.batch_summary.txt
        fi
        mv {sample}-auto-busco/*/short_summary.*.txt . 2>/dev/null || true
        mv {sample}-auto-busco/*/short_summary.*.json . 2>/dev/null || true
        mv {sample}-auto-busco/logs/busco.log {sample}-auto-busco.log 2>/dev/null || true
    else
        touch {sample}-auto-busco.batch_summary.txt
        # upstream BUSCO_BUSCO: a run that never produced a batch summary
        # leaves the *.batch_summary.failed.txt error artifact (and exits
        # non-zero at the process level; here the empty summary is the
        # failure marker consumers already handle).
        cp {sample}-auto-busco.batch_summary.txt {sample}-auto-busco.batch_summary.failed.txt
    fi
    mkdir -p "$wd/$2"
    mv {sample}-auto-busco.batch_summary.txt "$wd/$2/"
    [ -f {sample}-auto-busco.batch_summary.failed.txt ] && mv {sample}-auto-busco.batch_summary.failed.txt "$wd/$2/" || true
    mv {sample}-auto-busco.log "$wd/$2/" 2>/dev/null || true
    mv short_summary.* "$wd/$2/" 2>/dev/null || true
}
mkdir -p {config.out_dir}/GenomeBinning/QC/BUSCO
mkdir -p .tmp/busco_megahit_semibin2_{sample} && cd .tmp/busco_megahit_semibin2_{sample}
# bins (meta.refinement='unrefined')
run_busco "$wd/{config.out_dir}/GenomeBinning/SemiBin2/bins/MEGAHIT-SemiBin2-{sample}*.fa.gz" "{config.out_dir}/GenomeBinning/QC/BUSCO/MEGAHIT-SemiBin2-unclassified-unrefined-{sample}"
rm -rf input_seqs {sample}-auto-busco
# unbinned chunks (meta.refinement='unrefined_unbinned')
run_busco "$wd/{config.out_dir}/GenomeBinning/SemiBin2/unbinned/MEGAHIT-SemiBin2-{sample}*[0-9].fa.gz" "{config.out_dir}/GenomeBinning/QC/BUSCO/MEGAHIT-SemiBin2-unclassified-unrefined_unbinned-{sample}"
cd "$wd"
rm -rf .tmp/busco_megahit_semibin2_{sample}
"""

[rules.resources]
threads = 6
memory = "16G"
time_limit = "12h"

[rules.environment]
conda = "envs/busco.yaml"

[[rules]]
name = "mag_depths_megahit_semibin2"
input = [
    "{config.out_dir}/GenomeBinning/SemiBin2/bins",
    "{config.out_dir}/GenomeBinning/SemiBin2/unbinned",
    "intermediates/binning/depths/MEGAHIT-{sample}-depth.txt.gz",
]
output = ["intermediates/binning/depths/bins/MEGAHIT-SemiBin2-{sample}-binDepths.tsv"]
depends_on = ["depths_megahit", "semibin_megahit"]
description = "Per-bin median coverage of the MEGAHIT SemiBin2 bins (upstream MAG_DEPTHS)"
shell = """
mkdir -p intermediates/binning/depths/bins
bins_list=""
for f in {config.out_dir}/GenomeBinning/SemiBin2/bins/MEGAHIT-SemiBin2-{sample}*.fa.gz \
         {config.out_dir}/GenomeBinning/SemiBin2/unbinned/MEGAHIT-SemiBin2-{sample}*[0-9].fa.gz; do
    [ -e "$f" ] && bins_list="$bins_list $f"
done
if [ -n "$bins_list" ]; then
    python scripts/get_mag_depths.py --bins $bins_list \
        --depths intermediates/binning/depths/MEGAHIT-{sample}-depth.txt.gz \
        --assembler MEGAHIT \
        --id {sample} \
        --binner SemiBin2
else
    touch MEGAHIT-SemiBin2-{sample}-binDepths.tsv
fi
mv MEGAHIT-SemiBin2-{sample}-binDepths.tsv intermediates/binning/depths/bins/
"""

[rules.resources]
threads = 1
memory = "16G"
time_limit = "4h"

[rules.environment]
conda = "envs/mag_depths.yaml"

[[rules]]
name = "quast_bins_megahit_semibin2"
input = [
    "{config.out_dir}/GenomeBinning/SemiBin2/bins",
    "{config.out_dir}/GenomeBinning/SemiBin2/unbinned",
]
output = [
    "{config.out_dir}/GenomeBinning/QC/MEGAHIT-SemiBin2-unclassified-unrefined-{sample}-quast_summary.tsv",
    "{config.out_dir}/GenomeBinning/QC/MEGAHIT-SemiBin2-unclassified-unrefined_unbinned-{sample}-quast_summary.tsv",
]
depends_on = ["semibin_megahit"]
description = "Per-bin metaQUAST QC of the MEGAHIT SemiBin2 bins and chunks (upstream QUAST_BINS)"
shell = """
wd=$(pwd)
mkdir -p .tmp/quast_megahit_semibin2_{sample} && cd .tmp/quast_megahit_semibin2_{sample}
run_quast() {
    # $1 = input glob pattern, $2 = summary prefix, $3 = output dir name
    mkdir -p "$3"
    n=0
    for f in $1; do
        [ -e "$f" ] || continue
        bin=$(basename "$f")
        metaquast.py --threads {threads} --max-ref-number 0 --rna-finding --gene-finding -l "$bin" "$f" -o "$3/$bin"
        n=$((n+1))
    done
    if [ "$n" -gt 0 ]; then
        for d in $3/*; do
            if ! [ -f "$2-quast_summary.tsv" ]; then
                cp "$d/transposed_report.tsv" "$2-quast_summary.tsv"
            else
                tail -n +2 "$d/transposed_report.tsv" >> "$2-quast_summary.tsv"
            fi
        done
    else
        touch "$2-quast_summary.tsv"
    fi
}
mkdir -p "$wd/{config.out_dir}/GenomeBinning/QC/QUAST"
# bins (meta.refinement='unrefined')
run_quast "$wd/{config.out_dir}/GenomeBinning/SemiBin2/bins/MEGAHIT-SemiBin2-{sample}*.fa.gz" "MEGAHIT-SemiBin2-unclassified-unrefined-{sample}" QUAST_bins
# unbinned chunks (meta.refinement='unrefined_unbinned')
run_quast "$wd/{config.out_dir}/GenomeBinning/SemiBin2/unbinned/MEGAHIT-SemiBin2-{sample}*[0-9].fa.gz" "MEGAHIT-SemiBin2-unclassified-unrefined_unbinned-{sample}" QUAST_chunks
mv QUAST_bins/* "$wd/{config.out_dir}/GenomeBinning/QC/QUAST/" 2>/dev/null || true
mv QUAST_chunks/* "$wd/{config.out_dir}/GenomeBinning/QC/QUAST/" 2>/dev/null || true
mv *-quast_summary.tsv "$wd/{config.out_dir}/GenomeBinning/QC/"
cd "$wd"
rm -rf .tmp/quast_megahit_semibin2_{sample}
"""

[rules.resources]
threads = 1
memory = "2G"
time_limit = "4h"

[rules.environment]
conda = "envs/quast.yaml"

# ---------------------------------------------------------------------------
# CONCAT_BUSCO: qsv cat rowskey over every BUSCO batch summary (upstream
# CONCAT_BUSCO_TSV with meta.id='busco' -> busco_summary.tsv)
# ---------------------------------------------------------------------------
[[rules]]
name = "concat_busco"
input = ["{config.out_dir}/GenomeBinning/QC/BUSCO"]
output = ["{config.out_dir}/GenomeBinning/QC/busco_summary.tsv"]
depends_on = [
    "busco_spades_metabat2",
    "busco_spades_maxbin2",
    "busco_spades_concoct",
    "busco_spades_comebin",
    "busco_spades_metabinner",
    "busco_spades_semibin2",
    "busco_megahit_metabat2",
    "busco_megahit_maxbin2",
    "busco_megahit_concoct",
    "busco_megahit_comebin",
    "busco_megahit_metabinner",
    "busco_megahit_semibin2"
]
description = "Concatenate all BUSCO batch summaries (upstream CONCAT_BUSCO_TSV, qsv cat rowskey)"
shell = """
export QSV_SKIP_FORMAT_CHECK=1
mkdir -p {config.out_dir}/GenomeBinning/QC
if ls {config.out_dir}/GenomeBinning/QC/BUSCO/*/*.batch_summary.txt >/dev/null 2>&1; then
    qsv cat rowskey --delimiter '\t' -o busco_summary.tsv {config.out_dir}/GenomeBinning/QC/BUSCO/*/*.batch_summary.txt
else
    touch busco_summary.tsv
fi
mv busco_summary.tsv {config.out_dir}/GenomeBinning/QC/
"""

[rules.resources]
threads = 1
memory = "1G"
time_limit = "4h"

[rules.environment]
conda = "envs/qsv.yaml"

# ---------------------------------------------------------------------------
# MAG_DEPTHS_SUMMARY: combine the per-group binDepths tables into one
# bin_depths_summary.tsv (upstream MAG_DEPTHS_SUMMARY)
# ---------------------------------------------------------------------------
[[rules]]
name = "mag_depths_summary"
input = [
    "intermediates/binning/depths/bins",
    # the helper ships in the repo, not on the env PATH (live: bare
    # `get_mag_depths_summary.py` -> command not found; upstream had
    # it in the container's bin/)
    "scripts/get_mag_depths_summary.py",
]
output = ["{config.out_dir}/GenomeBinning/depths/bins/bin_depths_summary.tsv"]
depends_on = [
    "mag_depths_spades_metabat2",
    "mag_depths_spades_maxbin2",
    "mag_depths_spades_concoct",
    "mag_depths_spades_comebin",
    "mag_depths_spades_metabinner",
    "mag_depths_spades_semibin2",
    "mag_depths_megahit_metabat2",
    "mag_depths_megahit_maxbin2",
    "mag_depths_megahit_concoct",
    "mag_depths_megahit_comebin",
    "mag_depths_megahit_metabinner",
    "mag_depths_megahit_semibin2"
]
description = "Combine all per-group bin depth tables (upstream MAG_DEPTHS_SUMMARY)"
shell = """
mkdir -p {config.out_dir}/GenomeBinning/depths/bins
if ls intermediates/binning/depths/bins/*-binDepths.tsv >/dev/null 2>&1; then
    python scripts/get_mag_depths_summary.py --depths intermediates/binning/depths/bins/*-binDepths.tsv \
        --out bin_depths_summary.tsv
else
    touch bin_depths_summary.tsv
fi
mv bin_depths_summary.tsv {config.out_dir}/GenomeBinning/depths/bins/
"""

[rules.resources]
threads = 1
memory = "7G"
time_limit = "4h"

[rules.environment]
conda = "envs/mag_depths_summary.yaml"

# ---------------------------------------------------------------------------
# CONCAT_QUAST: qsv cat rowskey over every per-group QUAST bin summary
# (upstream CONCAT_QUAST_SUMMARY with meta.id='quast_bin_summary')
# ---------------------------------------------------------------------------
[[rules]]
name = "concat_quast"
input = ["{config.out_dir}/GenomeBinning/QC"]
output = ["{config.out_dir}/GenomeBinning/QC/quast_bin_summary.tsv"]
depends_on = [
    "quast_bins_spades_metabat2",
    "quast_bins_spades_maxbin2",
    "quast_bins_spades_concoct",
    "quast_bins_spades_comebin",
    "quast_bins_spades_metabinner",
    "quast_bins_spades_semibin2",
    "quast_bins_megahit_metabat2",
    "quast_bins_megahit_maxbin2",
    "quast_bins_megahit_concoct",
    "quast_bins_megahit_comebin",
    "quast_bins_megahit_metabinner",
    "quast_bins_megahit_semibin2"
]
description = "Concatenate all per-group QUAST bin summaries (upstream CONCAT_QUAST_SUMMARY, qsv cat rowskey)"
shell = """
export QSV_SKIP_FORMAT_CHECK=1
mkdir -p {config.out_dir}/GenomeBinning/QC
if ls {config.out_dir}/GenomeBinning/QC/*-quast_summary.tsv >/dev/null 2>&1; then
    qsv cat rowskey --delimiter '\t' -o quast_bin_summary.tsv {config.out_dir}/GenomeBinning/QC/*-quast_summary.tsv
else
    touch quast_bin_summary.tsv
fi
mv quast_bin_summary.tsv {config.out_dir}/GenomeBinning/QC/
"""

[rules.resources]
threads = 1
memory = "1G"
time_limit = "4h"

[rules.environment]
conda = "envs/qsv.yaml"

# ---------------------------------------------------------------------------
# ALE (nf-core ALE module; ext.prefix {id}-{assembler}, ext.args
# '--metagenome --nout' at default; publish results/Assembly/{assembler}/QC/{id}/ALE)
# ---------------------------------------------------------------------------
[[rules]]
name = "ale_spades"
when = "config.reads_sheet == '' || {meta.reads_2} != '' || {meta.reads_layout} == 'interleaved'"
input = [
    # the own-readset bam as a FILE input: the dir alone forms no DAG
    # edge and no per-file manifest, so ALE could run against a stale
    # bam next to a fresh assembly and die on its mismatch check (live)
    "intermediates/binning/alignments/SPAdes/SPAdes-{sample}-{sample}.bam",
    "intermediates/assembly/SPAdes/SPAdes-{sample}.scaffolds.fa.gz",
]
output = ["{config.out_dir}/Assembly/SPAdes/QC/{sample}/ALE/{sample}-SPAdes_ALEoutput.txt"]
depends_on = ["bowtie2_align_spades", "spades"]
description = "Assembly Likelihood Evaluation of the SPAdes assembly (upstream ALE on the own-readset alignment)"
shell = """
mkdir -p {config.out_dir}/Assembly/SPAdes/QC/{sample}/ALE
# upstream picks the alignment whose reads match the assembly sample
# (bam.name.endsWith('-{meta.id}.bam')); with group binning the loop above
# produced exactly one such file
own_bam=$(LC_ALL=C ls intermediates/binning/alignments/SPAdes/SPAdes-{sample}-{sample}.bam)
ALE --metagenome --nout "$own_bam" intermediates/assembly/SPAdes/SPAdes-{sample}.scaffolds.fa.gz \
    {sample}-SPAdes_ALEoutput.txt
mv {sample}-SPAdes_ALEoutput.txt {config.out_dir}/Assembly/SPAdes/QC/{sample}/ALE/
"""

[rules.resources]
threads = 1
memory = "18G"
time_limit = "4h"

[rules.environment]
conda = "envs/ale.yaml"

[[rules]]
name = "ale_megahit"
input = [
    # the own-readset bam as a FILE input: the dir alone forms no DAG
    # edge and no per-file manifest, so ALE could run against a stale
    # bam next to a fresh assembly and die on its mismatch check (live)
    "intermediates/binning/alignments/MEGAHIT/MEGAHIT-{sample}-{sample}.bam",
    "intermediates/assembly/MEGAHIT/MEGAHIT-{sample}.contigs.fa.gz",
]
output = ["{config.out_dir}/Assembly/MEGAHIT/QC/{sample}/ALE/{sample}-MEGAHIT_ALEoutput.txt"]
depends_on = ["bowtie2_align_megahit", "megahit"]
description = "Assembly Likelihood Evaluation of the MEGAHIT assembly (upstream ALE on the own-readset alignment)"
shell = """
mkdir -p {config.out_dir}/Assembly/MEGAHIT/QC/{sample}/ALE
own_bam=$(LC_ALL=C ls intermediates/binning/alignments/MEGAHIT/MEGAHIT-{sample}-{sample}.bam)
ALE --metagenome --nout "$own_bam" intermediates/assembly/MEGAHIT/MEGAHIT-{sample}.contigs.fa.gz \
    {sample}-MEGAHIT_ALEoutput.txt
mv {sample}-MEGAHIT_ALEoutput.txt {config.out_dir}/Assembly/MEGAHIT/QC/{sample}/ALE/
"""

[rules.resources]
threads = 1
memory = "18G"
time_limit = "4h"

[rules.environment]
conda = "envs/ale.yaml"

# ---------------------------------------------------------------------------
# CHECKM (--run_checkm; off by default, matching the upstream
# params.run_checkm=false). CHECKM_LINEAGEWF runs per (assembler, binner,
# sample) on the bins and the unbinned chunks (the same globs the BUSCO and
# GTDB-Tk rules use), then CHECKM_QA summarizes each run into the
# {assembler}-{binner}-unclassified-unrefined[-_unbinned]-{sample}_qa.txt
# table that the gtdbtk filter consumes via --checkm-qa-file. Bins are
# decompressed into a scratch input_bins/ (CheckM -x fa), mirroring the
# port's busco rules. Zero-bin groups emit touched artifacts, like the
# upstream empty-group behaviour. The ~1.1GB lineage database is downloaded
# by checkm itself on first use unless checkm_db points at a local unpacked
# copy.
# ---------------------------------------------------------------------------
[[rules]]
name = "checkm_lineagewf_spades_metabat2"
when = "config.run_checkm"
input = [
    "{config.out_dir}/GenomeBinning/MetaBAT2/bins",
    "{config.out_dir}/GenomeBinning/MetaBAT2/unbinned",
]
output = [
    "{config.out_dir}/GenomeBinning/QC/CheckM/SPAdes-MetaBAT2-unclassified-unrefined-{sample}_wf",
    "{config.out_dir}/GenomeBinning/QC/CheckM/SPAdes-MetaBAT2-unclassified-unrefined-{sample}_wf.tsv",
    "{config.out_dir}/GenomeBinning/QC/CheckM/SPAdes-MetaBAT2-unclassified-unrefined_unbinned-{sample}_wf",
    "{config.out_dir}/GenomeBinning/QC/CheckM/SPAdes-MetaBAT2-unclassified-unrefined_unbinned-{sample}_wf.tsv",
]
depends_on = ["metabat2_spades", "split_fasta_metabat2_spades"]
description = "CheckM lineage_wf of the SPAdes MetaBAT2 bins and chunks (upstream CHECKM_LINEAGEWF)"
shell = """
wd=$(pwd)
if [ -n "{config.checkm_db}" ]; then
    export CHECKM_DATA_PATH="$wd/{config.checkm_db}"
fi
run_checkm() {
    # $1 = input glob pattern, $2 = prefix (lineage_wf output basename)
    mkdir -p input_bins
    for f in $1; do
        [ -e "$f" ] || continue
        gzip -cdf "$f" > input_bins/$(basename "$f" .gz)
    done
    if ls input_bins/* >/dev/null 2>&1; then
        checkm \\
            lineage_wf \\
            -t {threads} \\
            -f "$2.tsv" \\
            --tab_table \\
            --pplacer_threads {threads} \\
            -x fa \\
            input_bins/ \\
            "$2"
    else
        # zero-bin group: emit the empty artifacts so the declared-output
        # contract holds; the qa rule guards on the missing lineage.ms
        echo "checkm: no bins matched for {sample} ($2)" 1>&2
        touch "$2.tsv"
        mkdir -p "$2"
    fi
}
mkdir -p {config.out_dir}/GenomeBinning/QC/CheckM
mkdir -p .tmp/checkm_lw_spades_metabat2_{sample} && cd .tmp/checkm_lw_spades_metabat2_{sample}
# bins (meta.refinement='unrefined')
run_checkm "$wd/{config.out_dir}/GenomeBinning/MetaBAT2/bins/SPAdes-MetaBAT2-{sample}*.fa.gz" SPAdes-MetaBAT2-unclassified-unrefined-{sample}_wf
rm -rf input_bins
# unbinned chunks (meta.refinement='unrefined_unbinned')
run_checkm "$wd/{config.out_dir}/GenomeBinning/MetaBAT2/unbinned/SPAdes-MetaBAT2-{sample}*[0-9].fa.gz" SPAdes-MetaBAT2-unclassified-unrefined_unbinned-{sample}_wf
mv SPAdes-MetaBAT2-unclassified-unrefined-{sample}_wf* "$wd/{config.out_dir}/GenomeBinning/QC/CheckM/"
mv SPAdes-MetaBAT2-unclassified-unrefined_unbinned-{sample}_wf* "$wd/{config.out_dir}/GenomeBinning/QC/CheckM/"
cd "$wd"
rm -rf .tmp/checkm_lw_spades_metabat2_{sample}
"""

[rules.resources]
threads = 4
memory = "16G"
time_limit = "12h"

[rules.environment]
conda = "envs/checkm.yaml"

[[rules]]
name = "checkm_qa_spades_metabat2"
when = "config.run_checkm"
input = [
    "{config.out_dir}/GenomeBinning/QC/CheckM/SPAdes-MetaBAT2-unclassified-unrefined-{sample}_wf",
    "{config.out_dir}/GenomeBinning/QC/CheckM/SPAdes-MetaBAT2-unclassified-unrefined_unbinned-{sample}_wf",
]
output = [
    "{config.out_dir}/GenomeBinning/QC/CheckM/SPAdes-MetaBAT2-unclassified-unrefined-{sample}_qa.txt",
    "{config.out_dir}/GenomeBinning/QC/CheckM/SPAdes-MetaBAT2-unclassified-unrefined_unbinned-{sample}_qa.txt",
]
depends_on = ["checkm_lineagewf_spades_metabat2"]
description = "CheckM qa of the SPAdes MetaBAT2 lineage_wf runs (upstream CHECKM_QA)"
shell = """
wd=$(pwd)
if [ -n "{config.checkm_db}" ]; then
    export CHECKM_DATA_PATH="$wd/{config.checkm_db}"
fi
run_qa() {
    # $1 = lineage_wf output dir, $2 = qa output basename
    if [ -f "$1/lineage.ms" ]; then
        checkm \\
            qa \\
            --threads {threads} \\
            --file "$2_qa.txt" \\
            "$1/lineage.ms" \\
            "$1" \\
            -o 2 \\
            --tab_table
    else
        touch "$2_qa.txt"
    fi
}
mkdir -p {config.out_dir}/GenomeBinning/QC/CheckM
mkdir -p .tmp/checkm_qa_spades_metabat2_{sample} && cd .tmp/checkm_qa_spades_metabat2_{sample}
run_qa "$wd/{config.out_dir}/GenomeBinning/QC/CheckM/SPAdes-MetaBAT2-unclassified-unrefined-{sample}_wf" SPAdes-MetaBAT2-unclassified-unrefined-{sample}
run_qa "$wd/{config.out_dir}/GenomeBinning/QC/CheckM/SPAdes-MetaBAT2-unclassified-unrefined_unbinned-{sample}_wf" SPAdes-MetaBAT2-unclassified-unrefined_unbinned-{sample}
mv SPAdes-MetaBAT2-unclassified-unrefined-{sample}_qa.txt "$wd/{config.out_dir}/GenomeBinning/QC/CheckM/"
mv SPAdes-MetaBAT2-unclassified-unrefined_unbinned-{sample}_qa.txt "$wd/{config.out_dir}/GenomeBinning/QC/CheckM/"
cd "$wd"
rm -rf .tmp/checkm_qa_spades_metabat2_{sample}
"""

[rules.resources]
threads = 4
memory = "8G"
time_limit = "6h"

[rules.environment]
conda = "envs/checkm.yaml"

[[rules]]
name = "checkm_lineagewf_spades_maxbin2"
when = "config.run_checkm"
input = [
    "{config.out_dir}/GenomeBinning/MaxBin2/bins",
    "{config.out_dir}/GenomeBinning/MaxBin2/unbinned",
]
output = [
    "{config.out_dir}/GenomeBinning/QC/CheckM/SPAdes-MaxBin2-unclassified-unrefined-{sample}_wf",
    "{config.out_dir}/GenomeBinning/QC/CheckM/SPAdes-MaxBin2-unclassified-unrefined-{sample}_wf.tsv",
    "{config.out_dir}/GenomeBinning/QC/CheckM/SPAdes-MaxBin2-unclassified-unrefined_unbinned-{sample}_wf",
    "{config.out_dir}/GenomeBinning/QC/CheckM/SPAdes-MaxBin2-unclassified-unrefined_unbinned-{sample}_wf.tsv",
]
depends_on = ["maxbin2_spades", "split_fasta_maxbin2_spades"]
description = "CheckM lineage_wf of the SPAdes MaxBin2 bins and chunks (upstream CHECKM_LINEAGEWF)"
shell = """
wd=$(pwd)
if [ -n "{config.checkm_db}" ]; then
    export CHECKM_DATA_PATH="$wd/{config.checkm_db}"
fi
run_checkm() {
    # $1 = input glob pattern, $2 = prefix (lineage_wf output basename)
    mkdir -p input_bins
    for f in $1; do
        [ -e "$f" ] || continue
        gzip -cdf "$f" > input_bins/$(basename "$f" .gz)
    done
    if ls input_bins/* >/dev/null 2>&1; then
        checkm \\
            lineage_wf \\
            -t {threads} \\
            -f "$2.tsv" \\
            --tab_table \\
            --pplacer_threads {threads} \\
            -x fa \\
            input_bins/ \\
            "$2"
    else
        # zero-bin group: emit the empty artifacts so the declared-output
        # contract holds; the qa rule guards on the missing lineage.ms
        echo "checkm: no bins matched for {sample} ($2)" 1>&2
        touch "$2.tsv"
        mkdir -p "$2"
    fi
}
mkdir -p {config.out_dir}/GenomeBinning/QC/CheckM
mkdir -p .tmp/checkm_lw_spades_maxbin2_{sample} && cd .tmp/checkm_lw_spades_maxbin2_{sample}
# bins (meta.refinement='unrefined')
run_checkm "$wd/{config.out_dir}/GenomeBinning/MaxBin2/bins/SPAdes-MaxBin2-{sample}*.fa.gz" SPAdes-MaxBin2-unclassified-unrefined-{sample}_wf
rm -rf input_bins
# unbinned chunks (meta.refinement='unrefined_unbinned')
run_checkm "$wd/{config.out_dir}/GenomeBinning/MaxBin2/unbinned/SPAdes-MaxBin2-{sample}*[0-9].fa.gz" SPAdes-MaxBin2-unclassified-unrefined_unbinned-{sample}_wf
