[rules.resources]
threads = 4
memory = "8G"
time_limit = "6h"

[rules.environment]
conda = "envs/checkm.yaml"

[[rules]]
name = "concat_checkm_tsv"
when = "config.run_checkm"
input = ["{config.out_dir}/GenomeBinning/QC/CheckM"]
output = ["{config.out_dir}/GenomeBinning/QC/checkm_summary.tsv"]
depends_on = [
    "checkm_qa_spades_metabat2",
    "checkm_qa_spades_maxbin2",
    "checkm_qa_spades_concoct",
    "checkm_qa_spades_comebin",
    "checkm_qa_spades_metabinner",
    "checkm_qa_spades_semibin2",
    "checkm_qa_megahit_metabat2",
    "checkm_qa_megahit_maxbin2",
    "checkm_qa_megahit_concoct",
    "checkm_qa_megahit_comebin",
    "checkm_qa_megahit_metabinner",
    "checkm_qa_megahit_semibin2",
]
description = "Concatenate all CheckM qa tables (upstream CONCAT_CHECKM_TSV, qsv cat rowskey)"
shell = """
export QSV_SKIP_FORMAT_CHECK=1
mkdir -p {config.out_dir}/GenomeBinning/QC
if ls {config.out_dir}/GenomeBinning/QC/CheckM/*_qa.txt >/dev/null 2>&1; then
    qsv cat rowskey --delimiter '\\t' -o checkm_summary.tsv {config.out_dir}/GenomeBinning/QC/CheckM/*_qa.txt
else
    touch checkm_summary.tsv
fi
mv checkm_summary.tsv {config.out_dir}/GenomeBinning/QC/
"""

[rules.resources]
threads = 1
memory = "6G"
time_limit = "4h"

[rules.environment]
conda = "envs/qsv.yaml"

# ---------------------------------------------------------------------------
# CheckM2 bin QC (upstream BIN_QC checkm2 section: CHECKM2_PREDICT ->
# CONCAT_CHECKM2_TSV). The .dmnd database is user-provided
# (config.checkm2_db).
# ---------------------------------------------------------------------------
[[rules]]
name = "checkm2_spades_metabat2"
when = "config.run_checkm2"
input = [
    "{config.out_dir}/GenomeBinning/MetaBAT2/bins",
    "{config.out_dir}/GenomeBinning/MetaBAT2/unbinned",
]
output = [
    "{config.out_dir}/GenomeBinning/QC/CheckM2/SPAdes-MetaBAT2-unclassified-unrefined-{sample}_checkm2_report.tsv",
    "{config.out_dir}/GenomeBinning/QC/CheckM2/SPAdes-MetaBAT2-unclassified-unrefined_unbinned-{sample}_checkm2_report.tsv",
]
depends_on = ["metabat2_spades", "split_fasta_metabat2_spades"]
description = "CheckM2 predict of the SPAdes MetaBAT2 bins and chunks (upstream CHECKM2_PREDICT)"
shell = """
wd=$(pwd)
if [ -z "{config.checkm2_db}" ]; then
    echo "checkm2: config.checkm2_db must point to a local CheckM2 database (.dmnd) when run_checkm2=true" 1>&2
    exit 1
fi
run_checkm2() {
    # $1 = input glob pattern, $2 = prefix (predict output basename)
    mkdir -p input_bins
    for f in $1; do
        [ -e "$f" ] || continue
        gzip -cdf "$f" > input_bins/$(basename "$f" .gz)
    done
    if ls input_bins/* >/dev/null 2>&1; then
        checkm2 \\
            predict \\
            --input input_bins/* \\
            --output-directory "$2" \\
            --threads {threads} \\
            --database_path "$wd/{config.checkm2_db}"
        cp "$2/quality_report.tsv" "$2_checkm2_report.tsv"
    else
        # zero-bin group: emit the empty artifact so the declared-output
        # contract holds
        echo "checkm2: no bins matched for {sample} ($2)" 1>&2
        mkdir -p "$2"
        touch "$2_checkm2_report.tsv"
    fi
}
mkdir -p {config.out_dir}/GenomeBinning/QC/CheckM2
mkdir -p .tmp/checkm2_spades_metabat2_{sample} && cd .tmp/checkm2_spades_metabat2_{sample}
# bins (meta.refinement='unrefined')
run_checkm2 "$wd/{config.out_dir}/GenomeBinning/MetaBAT2/bins/SPAdes-MetaBAT2-{sample}*.fa.gz" SPAdes-MetaBAT2-unclassified-unrefined-{sample}
rm -rf input_bins
# unbinned chunks (meta.refinement='unrefined_unbinned')
run_checkm2 "$wd/{config.out_dir}/GenomeBinning/MetaBAT2/unbinned/SPAdes-MetaBAT2-{sample}*[0-9].fa.gz" SPAdes-MetaBAT2-unclassified-unrefined_unbinned-{sample}
mv SPAdes-MetaBAT2-unclassified-unrefined-{sample}_checkm2_report.tsv "$wd/{config.out_dir}/GenomeBinning/QC/CheckM2/"
mv SPAdes-MetaBAT2-unclassified-unrefined_unbinned-{sample}_checkm2_report.tsv "$wd/{config.out_dir}/GenomeBinning/QC/CheckM2/"
cd "$wd"
rm -rf .tmp/checkm2_spades_metabat2_{sample}
"""

[rules.resources]
threads = 4
memory = "16G"
time_limit = "12h"

[rules.environment]
conda = "envs/checkm2.yaml"

[[rules]]
name = "checkm2_spades_maxbin2"
when = "config.run_checkm2"
input = [
    "{config.out_dir}/GenomeBinning/MaxBin2/bins",
    "{config.out_dir}/GenomeBinning/MaxBin2/unbinned",
