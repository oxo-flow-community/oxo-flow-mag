mv MEGAHIT-SemiBin2-unclassified-unrefined-{sample}_qa.txt "$wd/{config.out_dir}/GenomeBinning/QC/CheckM/"
mv MEGAHIT-SemiBin2-unclassified-unrefined_unbinned-{sample}_qa.txt "$wd/{config.out_dir}/GenomeBinning/QC/CheckM/"
