[workflow]
name = "08_domain"
description = "nf-core/mag 5.5.0 tiara fragment (--bin_domain_classification; off by default)"
# ---------------------------------------------------------------------------
# DOMAIN CLASSIFICATION (nf-core/mag 5.5.0, gated on
# config.bin_domain_classification): TIARA_TIARA classifies the contigs of
# each assembly, DASTOOL_FASTATOCONTIG2BIN builds the contig-to-bin tables
# for the bins and the unbinned chunks (upstream SPLIT_FASTA unbins only for
# MetaBAT2/MaxBin2/MetaBinner), TIARA_CLASSIFY splits each bin set into the
# six domain dirs with bin/domain_classification.R, and CONCAT_TIARA_TSV
# fuses all classification tables into tiara_summary.tsv. Everything is
# when-gated on config.bin_domain_classification (upstream
# params.bin_domain_classification=false), so the default plan is untouched.
# The domain-classified bins themselves stay as work intermediates (upstream
# publishes nothing for TIARA_CLASSIFY either; the classification tables are
# the published outputs).
# ---------------------------------------------------------------------------

# TIARA_TIARA (label process_medium; upstream ext.args
# "--min_len ${params.tiara_min_length} --probabilities", prefix
# {assembler}-{id}.tiara -> {assembler}-{sample}.tiara.txt)
[[rules]]
name = "tiara_tiara_spades"
when = "config.bin_domain_classification"
input = ["intermediates/assembly/SPAdes/SPAdes-{sample}.scaffolds.fa.gz"]
output = ["{config.out_dir}/Taxonomy/Tiara/SPAdes-{sample}.tiara.txt"]
depends_on = ["spades"]
description = "Per-contig domain classification of the SPAdes assembly (upstream TIARA_TIARA)"
shell = """
wd=$(pwd)
mkdir -p {config.out_dir}/Taxonomy/Tiara
mkdir -p .tmp/tiara_spades_{sample} && cd .tmp/tiara_spades_{sample}
ln -sf "$wd/{input[0]}" assembly.fa.gz
tiara \\
    -i assembly.fa.gz \\
    -o SPAdes-{sample}.tiara.txt \\
    --threads {threads} \\
    --min_len {config.tiara_min_length} \\
    --probabilities
[ $? -eq 0 ] || { echo "tiara failed for SPAdes-{sample}" 1>&2; exit 1; }
mv SPAdes-{sample}.tiara.txt "$wd/{config.out_dir}/Taxonomy/Tiara/"
cd "$wd"
rm -rf .tmp/tiara_spades_{sample}
"""

[rules.resources]
threads = 8
memory = "14G"
time_limit = "4h"

[rules.environment]
conda = "envs/tiara.yaml"

[[rules]]
name = "tiara_tiara_megahit"
when = "config.bin_domain_classification"
input = ["intermediates/assembly/MEGAHIT/MEGAHIT-{sample}.contigs.fa.gz"]
output = ["{config.out_dir}/Taxonomy/Tiara/MEGAHIT-{sample}.tiara.txt"]
depends_on = ["megahit"]
description = "Per-contig domain classification of the MEGAHIT assembly (upstream TIARA_TIARA)"
shell = """
wd=$(pwd)
mkdir -p {config.out_dir}/Taxonomy/Tiara
mkdir -p .tmp/tiara_megahit_{sample} && cd .tmp/tiara_megahit_{sample}
ln -sf "$wd/{input[0]}" assembly.fa.gz
tiara \\
    -i assembly.fa.gz \\
    -o MEGAHIT-{sample}.tiara.txt \\
    --threads {threads} \\
    --min_len {config.tiara_min_length} \\
    --probabilities
[ $? -eq 0 ] || { echo "tiara failed for MEGAHIT-{sample}" 1>&2; exit 1; }
mv MEGAHIT-{sample}.tiara.txt "$wd/{config.out_dir}/Taxonomy/Tiara/"
cd "$wd"
rm -rf .tmp/tiara_megahit_{sample}
"""

[rules.resources]
threads = 8
memory = "14G"
time_limit = "4h"

[rules.environment]
conda = "envs/tiara.yaml"

# DASTOOL_FASTATOCONTIG2BIN_TIARA (label process_single; upstream prefix
# {assembler}-{binner}-{id}). One rule per (assembler, binner, bins|unbins).
# Zero-bin groups emit an empty tsv; the classify rules skip empty tables.
[[rules]]
name = "fastatocontig2bin_tiara_spades_metabat2_bins"
when = "config.bin_domain_classification"
input = ["{config.out_dir}/GenomeBinning/MetaBAT2/bins"]
output = ["intermediates/domain/contig2bin/SPAdes-MetaBAT2-bins-{sample}.tsv"]
depends_on = ["metabat2_spades"]
description = "Contig-to-bin table of the SPAdes MetaBAT2 bins for domain classification (upstream DASTOOL_FASTATOCONTIG2BIN_TIARA)"
shell = """
wd=$(pwd)
mkdir -p intermediates/domain/contig2bin
mkdir -p .tmp/f2c2b_tiara_spades_metabat2_bins_{sample} && cd .tmp/f2c2b_tiara_spades_metabat2_bins_{sample}
for f in "$wd/{config.out_dir}/GenomeBinning/MetaBAT2/bins/SPAdes-MetaBAT2-{sample}"*.fa.gz; do
    [ -e "$f" ] || continue
    ln -sf "$f" .
done
if ls *.fa.gz >/dev/null 2>&1; then
    gunzip -f *.fa.gz
    Fasta_to_Contig2Bin.sh -i . -e fa > "$wd/intermediates/domain/contig2bin/SPAdes-MetaBAT2-bins-{sample}.tsv"
else
    touch "$wd/intermediates/domain/contig2bin/SPAdes-MetaBAT2-bins-{sample}.tsv"
fi
cd "$wd"
rm -rf .tmp/f2c2b_tiara_spades_metabat2_bins_{sample}
"""

[rules.resources]
threads = 1
memory = "4G"
time_limit = "4h"

[rules.environment]
conda = "envs/dastool.yaml"

[[rules]]
name = "fastatocontig2bin_tiara_spades_maxbin2_bins"
when = "config.bin_domain_classification"
input = ["{config.out_dir}/GenomeBinning/MaxBin2/bins"]
output = ["intermediates/domain/contig2bin/SPAdes-MaxBin2-bins-{sample}.tsv"]
depends_on = ["maxbin2_spades"]
description = "Contig-to-bin table of the SPAdes MaxBin2 bins for domain classification (upstream DASTOOL_FASTATOCONTIG2BIN_TIARA)"
shell = """
wd=$(pwd)
mkdir -p intermediates/domain/contig2bin
mkdir -p .tmp/f2c2b_tiara_spades_maxbin2_bins_{sample} && cd .tmp/f2c2b_tiara_spades_maxbin2_bins_{sample}
for f in "$wd/{config.out_dir}/GenomeBinning/MaxBin2/bins/SPAdes-MaxBin2-{sample}"*.fa.gz; do
    [ -e "$f" ] || continue
    ln -sf "$f" .
done
if ls *.fa.gz >/dev/null 2>&1; then
    gunzip -f *.fa.gz
    Fasta_to_Contig2Bin.sh -i . -e fa > "$wd/intermediates/domain/contig2bin/SPAdes-MaxBin2-bins-{sample}.tsv"
else
    touch "$wd/intermediates/domain/contig2bin/SPAdes-MaxBin2-bins-{sample}.tsv"
fi
cd "$wd"
rm -rf .tmp/f2c2b_tiara_spades_maxbin2_bins_{sample}
"""

[rules.resources]
threads = 1
memory = "4G"
time_limit = "4h"

[rules.environment]
conda = "envs/dastool.yaml"

[[rules]]
name = "fastatocontig2bin_tiara_spades_concoct_bins"
