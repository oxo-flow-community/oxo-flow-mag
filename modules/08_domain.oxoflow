        --contig_to_bin "$wd/intermediates/domain/contig2bin/MEGAHIT-MetaBAT2-unbins-{sample}.tsv" \\
        --join_prokaryotes \\
        --output_prefix MEGAHIT-MetaBAT2-unbins-{sample}
    mkdir eukarya
    # zero-classified runs produce no output file (live: MetaBinner unbins)
    [ -s MEGAHIT-MetaBAT2-unbins-{sample}.binclassification.tsv ] || touch MEGAHIT-MetaBAT2-unbins-{sample}.binclassification.tsv
    mkdir prokarya
    mkdir bacteria
    mkdir archaea
    mkdir organelle
    mkdir unknown
    while IFS=$'\\t' read bin domain; do
        find -L . -maxdepth 1 -name "${bin}.fa.gz" -exec cp {} ${domain}/ \\;
    done < bin2classification.tsv
else
    touch MEGAHIT-MetaBAT2-unbins-{sample}.binclassification.tsv
fi
mv MEGAHIT-MetaBAT2-unbins-{sample}.binclassification.tsv "$wd/{config.out_dir}/GenomeBinning/Tiara/"
cd "$wd"
rm -rf .tmp/tiara_classify_megahit_metabat2_unbins_{sample}
"""

[rules.resources]
threads = 1
memory = "4G"
time_limit = "4h"

[rules.environment]
conda = "envs/tiara_classify.yaml"

[[rules]]
name = "tiara_classify_megahit_maxbin2_unbins"
when = "config.bin_domain_classification"
input = [
    "{config.out_dir}/Taxonomy/Tiara/MEGAHIT-{sample}.tiara.txt",
    "intermediates/domain/contig2bin/MEGAHIT-MaxBin2-unbins-{sample}.tsv",
    "{config.out_dir}/GenomeBinning/MaxBin2/unbinned",
]
output = ["{config.out_dir}/GenomeBinning/Tiara/MEGAHIT-MaxBin2-unbins-{sample}.binclassification.tsv"]
depends_on = ["tiara_tiara_megahit", "fastatocontig2bin_tiara_megahit_maxbin2_unbins"]
description = "Domain classification of the MEGAHIT MaxBin2 unbinned chunks (upstream TIARA_CLASSIFY)"
shell = """
wd=$(pwd)
mkdir -p {config.out_dir}/GenomeBinning/Tiara
mkdir -p .tmp/tiara_classify_megahit_maxbin2_unbins_{sample} && cd .tmp/tiara_classify_megahit_maxbin2_unbins_{sample}
# chunks for the copy loop (the classification names match the published .fa.gz basenames)
for f in "$wd/{config.out_dir}/GenomeBinning/MaxBin2/unbinned/MEGAHIT-MaxBin2-{sample}"*.fa.gz; do
    [ -e "$f" ] || continue
    ln -sf "$f" .
done
if [ -s "$wd/intermediates/domain/contig2bin/MEGAHIT-MaxBin2-unbins-{sample}.tsv" ]; then
    domain_classification.R \\
        --classification_file "$wd/{config.out_dir}/Taxonomy/Tiara/MEGAHIT-{sample}.tiara.txt" \\
        --contig_to_bin "$wd/intermediates/domain/contig2bin/MEGAHIT-MaxBin2-unbins-{sample}.tsv" \\
        --join_prokaryotes \\
        --output_prefix MEGAHIT-MaxBin2-unbins-{sample}
    mkdir eukarya
    # zero-classified runs produce no output file (live: MetaBinner unbins)
    [ -s MEGAHIT-MaxBin2-unbins-{sample}.binclassification.tsv ] || touch MEGAHIT-MaxBin2-unbins-{sample}.binclassification.tsv
    mkdir prokarya
    mkdir bacteria
    mkdir archaea
    mkdir organelle
    mkdir unknown
    while IFS=$'\\t' read bin domain; do
        find -L . -maxdepth 1 -name "${bin}.fa.gz" -exec cp {} ${domain}/ \\;
    done < bin2classification.tsv
else
    touch MEGAHIT-MaxBin2-unbins-{sample}.binclassification.tsv
fi
mv MEGAHIT-MaxBin2-unbins-{sample}.binclassification.tsv "$wd/{config.out_dir}/GenomeBinning/Tiara/"
cd "$wd"
rm -rf .tmp/tiara_classify_megahit_maxbin2_unbins_{sample}
"""

[rules.resources]
threads = 1
memory = "4G"
time_limit = "4h"

[rules.environment]
conda = "envs/tiara_classify.yaml"

[[rules]]
name = "tiara_classify_megahit_metabinner_unbins"
when = "config.bin_domain_classification"
input = [
    "{config.out_dir}/Taxonomy/Tiara/MEGAHIT-{sample}.tiara.txt",
    "intermediates/domain/contig2bin/MEGAHIT-MetaBinner-unbins-{sample}.tsv",
    "{config.out_dir}/GenomeBinning/MetaBinner/unbinned",
]
output = ["{config.out_dir}/GenomeBinning/Tiara/MEGAHIT-MetaBinner-unbins-{sample}.binclassification.tsv"]
depends_on = ["tiara_tiara_megahit", "fastatocontig2bin_tiara_megahit_metabinner_unbins"]
description = "Domain classification of the MEGAHIT MetaBinner unbinned chunks (upstream TIARA_CLASSIFY)"
shell = """
wd=$(pwd)
mkdir -p {config.out_dir}/GenomeBinning/Tiara
mkdir -p .tmp/tiara_classify_megahit_metabinner_unbins_{sample} && cd .tmp/tiara_classify_megahit_metabinner_unbins_{sample}
# chunks for the copy loop (the classification names match the published .fa.gz basenames)
for f in "$wd/{config.out_dir}/GenomeBinning/MetaBinner/unbinned/MEGAHIT-MetaBinner-{sample}"*.fa.gz; do
    [ -e "$f" ] || continue
    ln -sf "$f" .
done
if [ -s "$wd/intermediates/domain/contig2bin/MEGAHIT-MetaBinner-unbins-{sample}.tsv" ]; then
    domain_classification.R \\
        --classification_file "$wd/{config.out_dir}/Taxonomy/Tiara/MEGAHIT-{sample}.tiara.txt" \\
        --contig_to_bin "$wd/intermediates/domain/contig2bin/MEGAHIT-MetaBinner-unbins-{sample}.tsv" \\
        --join_prokaryotes \\
        --output_prefix MEGAHIT-MetaBinner-unbins-{sample}
    mkdir eukarya
    # zero-classified runs produce no output file (live: MetaBinner unbins)
    [ -s MEGAHIT-MetaBinner-unbins-{sample}.binclassification.tsv ] || touch MEGAHIT-MetaBinner-unbins-{sample}.binclassification.tsv
    mkdir prokarya
    mkdir bacteria
    mkdir archaea
    mkdir organelle
    mkdir unknown
    while IFS=$'\\t' read bin domain; do
        find -L . -maxdepth 1 -name "${bin}.fa.gz" -exec cp {} ${domain}/ \\;
    done < bin2classification.tsv
else
    touch MEGAHIT-MetaBinner-unbins-{sample}.binclassification.tsv
fi
mv MEGAHIT-MetaBinner-unbins-{sample}.binclassification.tsv "$wd/{config.out_dir}/GenomeBinning/Tiara/"
cd "$wd"
rm -rf .tmp/tiara_classify_megahit_metabinner_unbins_{sample}
"""

[rules.resources]
threads = 1
memory = "4G"
time_limit = "4h"

[rules.environment]
conda = "envs/tiara_classify.yaml"

# CONCAT_TIARA_TSV (upstream QSV_CAT mode=rowskey; prefix tiara_summary,
# published to results/GenomeBinning/Tiara/tiara_summary.tsv)
[[rules]]
name = "concat_tiara_tsv"
when = "config.bin_domain_classification"
input = ["{config.out_dir}/GenomeBinning/Tiara"]
output = ["{config.out_dir}/GenomeBinning/Tiara/tiara_summary.tsv"]
depends_on = [
    "tiara_classify_spades_metabat2_bins",
    "tiara_classify_spades_maxbin2_bins",
    "tiara_classify_spades_concoct_bins",
    "tiara_classify_spades_comebin_bins",
    "tiara_classify_spades_metabinner_bins",
    "tiara_classify_spades_semibin2_bins",
    "tiara_classify_megahit_metabat2_bins",
    "tiara_classify_megahit_maxbin2_bins",
    "tiara_classify_megahit_concoct_bins",
    "tiara_classify_megahit_comebin_bins",
    "tiara_classify_megahit_metabinner_bins",
    "tiara_classify_megahit_semibin2_bins",
    "tiara_classify_spades_metabat2_unbins",
    "tiara_classify_spades_maxbin2_unbins",
    "tiara_classify_spades_metabinner_unbins",
    "tiara_classify_megahit_metabat2_unbins",
    "tiara_classify_megahit_maxbin2_unbins",
    "tiara_classify_megahit_metabinner_unbins",
]
description = "Concatenate all Tiara bin classifications (upstream CONCAT_TIARA_TSV, qsv cat rowskey)"
shell = """
export QSV_SKIP_FORMAT_CHECK=1
mkdir -p {config.out_dir}/GenomeBinning/Tiara
if ls {config.out_dir}/GenomeBinning/Tiara/*.binclassification.tsv >/dev/null 2>&1; then
    qsv cat rowskey --delimiter '\\t' -o tiara_summary.tsv {config.out_dir}/GenomeBinning/Tiara/*.binclassification.tsv
else
    touch tiara_summary.tsv
fi
mv tiara_summary.tsv {config.out_dir}/GenomeBinning/Tiara/
"""

[rules.resources]
threads = 1
memory = "6G"
time_limit = "4h"

[rules.environment]
conda = "envs/qsv.yaml"
