# bins for the copy loop (the classification names match the published .fa.gz basenames)
for f in "$wd/{config.out_dir}/GenomeBinning/MetaBAT2/bins/MEGAHIT-MetaBAT2-{sample}"*.fa.gz; do
    [ -e "$f" ] || continue
    ln -sf "$f" .
done
if [ -s "$wd/intermediates/domain/contig2bin/MEGAHIT-MetaBAT2-bins-{sample}.tsv" ]; then
    domain_classification.R \\
        --classification_file "$wd/{config.out_dir}/Taxonomy/Tiara/MEGAHIT-{sample}.tiara.txt" \\
        --contig_to_bin "$wd/intermediates/domain/contig2bin/MEGAHIT-MetaBAT2-bins-{sample}.tsv" \\
        --join_prokaryotes \\
        --output_prefix MEGAHIT-MetaBAT2-bins-{sample}
    mkdir eukarya
    # zero-classified runs produce no output file (live: MetaBinner unbins)
    [ -s MEGAHIT-MetaBAT2-bins-{sample}.binclassification.tsv ] || touch MEGAHIT-MetaBAT2-bins-{sample}.binclassification.tsv
    mkdir prokarya
    mkdir bacteria
    mkdir archaea
    mkdir organelle
    mkdir unknown
    while IFS=$'\\t' read bin domain; do
        find -L . -maxdepth 1 -name "${bin}.fa.gz" -exec cp {} ${domain}/ \\;
    done < bin2classification.tsv
else
    touch MEGAHIT-MetaBAT2-bins-{sample}.binclassification.tsv
fi
mv MEGAHIT-MetaBAT2-bins-{sample}.binclassification.tsv "$wd/{config.out_dir}/GenomeBinning/Tiara/"
cd "$wd"
rm -rf .tmp/tiara_classify_megahit_metabat2_bins_{sample}
"""

