    gunzip -f *.fa.gz
    Fasta_to_Contig2Bin.sh -i . -e fa > "$wd/intermediates/domain/contig2bin/SPAdes-MetaBAT2-unbins-{sample}.tsv"
else
    touch "$wd/intermediates/domain/contig2bin/SPAdes-MetaBAT2-unbins-{sample}.tsv"
fi
cd "$wd"
rm -rf .tmp/f2c2b_tiara_spades_metabat2_unbins_{sample}
"""

