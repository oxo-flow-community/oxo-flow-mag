# unbinned chunks (upstream SPLIT_FASTA.out.unbinned only feeds
# MetaBAT2/MaxBin2/MetaBinner; CONCOCT/COMEBin/SemiBin2 have no chunk dir in
# the port, so their rules are omitted entirely — the upstream channel for
# them is empty too)
[[rules]]
name = "fastatocontig2bin_tiara_spades_metabat2_unbins"
when = "config.bin_domain_classification"
input = ["{config.out_dir}/GenomeBinning/MetaBAT2/unbinned"]
