output = ["intermediates/domain/contig2bin/SPAdes-MaxBin2-unbins-{sample}.tsv"]
depends_on = ["split_fasta_maxbin2_spades"]
description = "Contig-to-bin table of the SPAdes MaxBin2 unbinned chunks for domain classification (upstream DASTOOL_FASTATOCONTIG2BIN_TIARA)"
shell = """
wd=$(pwd)
mkdir -p intermediates/domain/contig2bin
mkdir -p .tmp/f2c2b_tiara_spades_maxbin2_unbins_{sample} && cd .tmp/f2c2b_tiara_spades_maxbin2_unbins_{sample}
for f in "$wd/{config.out_dir}/GenomeBinning/MaxBin2/unbinned/SPAdes-MaxBin2-{sample}"*.fa.gz; do
    [ -e "$f" ] || continue
    ln -sf "$f" .
done
if ls *.fa.gz >/dev/null 2>&1; then
    gunzip -f *.fa.gz
    Fasta_to_Contig2Bin.sh -i . -e fa > "$wd/intermediates/domain/contig2bin/SPAdes-MaxBin2-unbins-{sample}.tsv"
else
    touch "$wd/intermediates/domain/contig2bin/SPAdes-MaxBin2-unbins-{sample}.tsv"
fi
cd "$wd"
rm -rf .tmp/f2c2b_tiara_spades_maxbin2_unbins_{sample}
"""

