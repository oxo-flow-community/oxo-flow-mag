[rules.resources]
threads = 1
memory = "4G"
time_limit = "4h"

[rules.environment]
conda = "envs/dastool.yaml"

# TIARA_CLASSIFY (label process_single; upstream ext.args
# --join_prokaryotes, prefix {assembler}-{binner}-{bin}-{id}). The R script
# is copied verbatim from upstream bin/domain_classification.R. Deviation:
# the upstream while-loop uses IFS=$"\t" which does not split on tabs in
# bash; the port uses IFS=$'\t' so the bin->domain copy actually works.
[[rules]]
name = "tiara_classify_spades_metabat2_bins"
when = "config.bin_domain_classification"
input = [
    "{config.out_dir}/Taxonomy/Tiara/SPAdes-{sample}.tiara.txt",
    "intermediates/domain/contig2bin/SPAdes-MetaBAT2-bins-{sample}.tsv",
    "{config.out_dir}/GenomeBinning/MetaBAT2/bins",
]
output = ["{config.out_dir}/GenomeBinning/Tiara/SPAdes-MetaBAT2-bins-{sample}.binclassification.tsv"]
depends_on = ["tiara_tiara_spades", "fastatocontig2bin_tiara_spades_metabat2_bins"]
description = "Domain classification of the SPAdes MetaBAT2 bins (upstream TIARA_CLASSIFY)"
shell = """
wd=$(pwd)
mkdir -p {config.out_dir}/GenomeBinning/Tiara
mkdir -p .tmp/tiara_classify_spades_metabat2_bins_{sample} && cd .tmp/tiara_classify_spades_metabat2_bins_{sample}
# bins for the copy loop (the classification names match the published .fa.gz basenames)
for f in "$wd/{config.out_dir}/GenomeBinning/MetaBAT2/bins/SPAdes-MetaBAT2-{sample}"*.fa.gz; do
    [ -e "$f" ] || continue
    ln -sf "$f" .
done
if [ -s "$wd/intermediates/domain/contig2bin/SPAdes-MetaBAT2-bins-{sample}.tsv" ]; then
    domain_classification.R \\
        --classification_file "$wd/{config.out_dir}/Taxonomy/Tiara/SPAdes-{sample}.tiara.txt" \\
        --contig_to_bin "$wd/intermediates/domain/contig2bin/SPAdes-MetaBAT2-bins-{sample}.tsv" \\
        --join_prokaryotes \\
        --output_prefix SPAdes-MetaBAT2-bins-{sample}
    mkdir eukarya
    # zero-classified runs produce no output file (live: MetaBinner unbins)
    [ -s SPAdes-MetaBAT2-bins-{sample}.binclassification.tsv ] || touch SPAdes-MetaBAT2-bins-{sample}.binclassification.tsv
    mkdir prokarya
    mkdir bacteria
    mkdir archaea
    mkdir organelle
    mkdir unknown
    while IFS=$'\\t' read bin domain; do
        find -L . -maxdepth 1 -name "${bin}.fa.gz" -exec cp {} ${domain}/ \\;
    done < bin2classification.tsv
else
    touch SPAdes-MetaBAT2-bins-{sample}.binclassification.tsv
fi
mv SPAdes-MetaBAT2-bins-{sample}.binclassification.tsv "$wd/{config.out_dir}/GenomeBinning/Tiara/"
cd "$wd"
rm -rf .tmp/tiara_classify_spades_metabat2_bins_{sample}
"""

[rules.resources]
threads = 1
memory = "4G"
time_limit = "4h"

