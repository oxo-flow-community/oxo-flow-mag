mkdir -p .tmp/semibin_megahit_{sample} && cd .tmp/semibin_megahit_{sample}
ln -sf "$wd/{input[0]}" assembly.fa
bams=$(LC_ALL=C ls "$wd"/intermediates/binning/alignments/MEGAHIT/MEGAHIT-{sample}-*.bam)
