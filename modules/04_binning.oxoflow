shell = """
wd=$(pwd)
mkdir -p .tmp/split_mxb2_megahit_{sample} && cd .tmp/split_mxb2_megahit_{sample}
ln -sf "$wd/{input[0]}" MEGAHIT-MaxBin2-{sample}.noclass.gz
python "$wd/scripts/split_fasta.py" \\
    MEGAHIT-MaxBin2-{sample}.noclass.gz \\
    {config.min_length_unbinned_contigs} \\
    {config.max_unbinned_contigs} \\
    {config.min_contig_size}
gzip *.fa
mkdir -p "$wd/{config.out_dir}/GenomeBinning/MaxBin2/unbinned/discarded"
for f in *.pooled.fa.gz *.remaining.fa.gz; do
    [ -e "$f" ] && mv "$f" "$wd/{config.out_dir}/GenomeBinning/MaxBin2/unbinned/discarded/"
done
mv MEGAHIT-MaxBin2-{sample}.noclass.*.fa.gz "$wd/{config.out_dir}/GenomeBinning/MaxBin2/unbinned/"
cd "$wd"
rm -rf .tmp/split_mxb2_megahit_{sample}
"""

[rules.resources]
threads = 2
memory = "12G"
time_limit = "4h"

[rules.environment]
conda = "envs/split_fasta.yaml"

[[rules]]
name = "split_fasta_metabinner_spades"
input = ["intermediates/binning/metabinner/{sample}/SPAdes-MetaBinner-{sample}.unbinned.fa.gz"]
output = [
    "{config.out_dir}/GenomeBinning/MetaBinner/unbinned",
    "{config.out_dir}/GenomeBinning/MetaBinner/unbinned/discarded",
]
depends_on = ["metabinner_bins_spades"]
description = "Split the SPAdes MetaBinner unbinned contigs into chunks (upstream SPLIT_FASTA)"
shell = """
wd=$(pwd)
mkdir -p .tmp/split_mbin_spades_{sample} && cd .tmp/split_mbin_spades_{sample}
ln -sf "$wd/{input[0]}" SPAdes-MetaBinner-{sample}.unbinned.fa.gz
python "$wd/scripts/split_fasta.py" \\
    SPAdes-MetaBinner-{sample}.unbinned.fa.gz \\
    {config.min_length_unbinned_contigs} \\
    {config.max_unbinned_contigs} \\
    {config.min_contig_size}
gzip *.fa
mkdir -p "$wd/{config.out_dir}/GenomeBinning/MetaBinner/unbinned/discarded"
for f in *.pooled.fa.gz *.remaining.fa.gz; do
    [ -e "$f" ] && mv "$f" "$wd/{config.out_dir}/GenomeBinning/MetaBinner/unbinned/discarded/"
done
mv SPAdes-MetaBinner-{sample}.unbinned.*.fa.gz "$wd/{config.out_dir}/GenomeBinning/MetaBinner/unbinned/"
cd "$wd"
rm -rf .tmp/split_mbin_spades_{sample}
"""

