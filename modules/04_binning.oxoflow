# upstream passes --environment only for single-sample cohorts
env_args=""
if [ "$(echo {config.cohort_samples} | wc -w)" -eq 1 ]; then
    env_args="--environment {config.semibin_environment}"
fi
SemiBin2 \\
    single_easy_bin \\
    --input-fasta assembly.fa \\
    --input-bam $bams \\
    --tag-output $prefix \\
    --output $prefix \\
    -t {threads} \\
    --random-seed {config.semibin_rng_seed} \\
    --min-len {config.min_contig_size} \\
    --compression gz \\
    --engine cpu \\
    --sequencing-type short_reads \\
    $env_args
mv ./$prefix/output_bins/ bins/
mv ./$prefix/SemiBinRun.log $prefix.SemiBinRun.log
mkdir -p "$wd/{config.out_dir}/GenomeBinning/SemiBin2/bins" "$wd/{config.out_dir}/GenomeBinning/SemiBin2/log"
if ls bins/*.fa.gz >/dev/null 2>&1; then
    mv bins/*.fa.gz "$wd/{config.out_dir}/GenomeBinning/SemiBin2/bins/"
fi
mv $prefix.SemiBinRun.log "$wd/{config.out_dir}/GenomeBinning/SemiBin2/log/"
cd "$wd"
rm -rf .tmp/semibin_megahit_{sample}
"""

[rules.resources]
threads = 6
memory = "36G"
time_limit = "8h"

[rules.environment]
conda = "envs/semibin.yaml"

# ---------------------------------------------------------------------------
# SEQKIT_STATS (label process_single + 1 cpu/1GB override, ext.args='').
# Bin length stats per (assembler, binner, sample); upstream publishes
# nothing, the table feeds the bin_min_size/bin_max_size filter which is a
# no-op at defaults (not ported). Empty globs (binner found no bins) are
# guarded: the table is touched empty instead of failing.
# ---------------------------------------------------------------------------
[[rules]]
name = "seqkit_spades_metabat2"
input = ["{config.out_dir}/GenomeBinning/MetaBAT2/bins"]
output = ["intermediates/binning/seqkit/SPAdes-MetaBAT2-{sample}.tsv"]
depends_on = ["metabat2_spades"]
description = "Bin length stats of the SPAdes MetaBAT2 bins (upstream SEQKIT_STATS)"
shell = """
mkdir -p intermediates/binning/seqkit
if ls {config.out_dir}/GenomeBinning/MetaBAT2/bins/SPAdes-MetaBAT2-{sample}*.fa.gz >/dev/null 2>&1; then
    seqkit stats --tabular --threads {threads} \\
        {config.out_dir}/GenomeBinning/MetaBAT2/bins/SPAdes-MetaBAT2-{sample}*.fa.gz \\
        > SPAdes-MetaBAT2-{sample}.tsv
else
    touch SPAdes-MetaBAT2-{sample}.tsv
fi
mv SPAdes-MetaBAT2-{sample}.tsv intermediates/binning/seqkit/
"""

