description = "Binning of the MEGAHIT assembly with COMEBin (upstream COMEBIN_RUNCOMEBIN)"
shell = """
wd=$(pwd)
mkdir -p .tmp/comebin_megahit_{sample} && cd .tmp/comebin_megahit_{sample}
cat "$wd/{input[0]}" > local_assembly.fasta
mkdir bam/
for b in "$wd"/intermediates/binning/alignments/MEGAHIT/MEGAHIT-{sample}-*.bam; do
