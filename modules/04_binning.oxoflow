"""

[rules.resources]
threads = 1
memory = "6G"
time_limit = "4h"

[rules.environment]
conda = "envs/concoct.yaml"

# ---------------------------------------------------------------------------
# COMEBIN (label process_high; prefix {assembler}-COMEBin-{id})
# ---------------------------------------------------------------------------
[[rules]]
name = "comebin_spades"
input = [
    "intermediates/assembly/SPAdes/SPAdes-{sample}.scaffolds.fa",
    "intermediates/binning/alignments/SPAdes",
]
output = [
    "{config.out_dir}/GenomeBinning/COMEBin/bins",
    "{config.out_dir}/GenomeBinning/COMEBin/stats",
]
depends_on = ["bowtie2_align_spades"]
description = "Binning of the SPAdes assembly with COMEBin (upstream COMEBIN_RUNCOMEBIN)"
shell = """
wd=$(pwd)
mkdir -p .tmp/comebin_spades_{sample} && cd .tmp/comebin_spades_{sample}
cat "$wd/{input[0]}" > local_assembly.fasta
mkdir bam/
for b in "$wd"/intermediates/binning/alignments/SPAdes/SPAdes-{sample}-*.bam; do
    ln -sf "$b" bam/$(basename "$b")
done
prefix=SPAdes-COMEBin-{sample}
run_comebin.sh \\
    -t {threads} \\
    -a local_assembly.fasta \\
    -p bam/ \\
    -o .
mv comebin_res $prefix
find $prefix/comebin_res_bins/*.fa -exec gzip {} +
for filename in $prefix/comebin_res_bins/*.fa.gz; do
    mv "$filename" "$prefix/comebin_res_bins/$prefix.$(basename "$filename")"
done
rm local_assembly.fasta
mkdir -p "$wd/{config.out_dir}/GenomeBinning/COMEBin/bins" "$wd/{config.out_dir}/GenomeBinning/COMEBin/stats"
mv $prefix/comebin_res_bins/*.fa.gz "$wd/{config.out_dir}/GenomeBinning/COMEBin/bins/"
mv $prefix/comebin_res.tsv $prefix/comebin.log "$wd/{config.out_dir}/GenomeBinning/COMEBin/stats/"
cd "$wd"
rm -rf .tmp/comebin_spades_{sample}
"""

[rules.resources]
threads = 12
memory = "72G"
time_limit = "16h"

