[workflow]
name = "04_binning"
description = "nf-core/mag 5.5.0 04_binning fragment"
# ---------------------------------------------------------------------------
# BINNING (nf-core/mag 5.5.0 default path): JGI depths per assembly ->
# convert (bioawk .abund files for MaxBin2) -> six binners (MetaBAT2,
# MaxBin2, CONCOCT, COMEBin, MetaBinner, SemiBin2) per assembly ->
# seqkit stats (bin length QC; the bin_min_size/bin_max_size filter is a
# no-op at defaults and not ported) -> split_fasta (unbinned contig chunks
# of MetaBAT2/MaxBin2/MetaBinner, published to {binner}/unbinned/).
#
# Bins are published into results/GenomeBinning/{binner}/bins/ with the
# upstream bin name prefixes {assembler}-{binner}-{sample}; downstream QC
# rules glob these paths. oxo-flow has no {assembler} wildcard, so every
# per-assembler process is one rule per assembler (_spades/_megahit).
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# DEPTHS: JGI summarize per assembly (label process_medium)
# ---------------------------------------------------------------------------
[[rules]]
name = "depths_spades"
input = [
    # the bam files, not the dir: exact-string edges from the align
    # rule + per-file manifests propagate re-runs (live: a dir-only
    # input picked up stale cross-sample bams and MetaBAT2 spun on
    # the zero-column depth matrix)
    "intermediates/binning/alignments/SPAdes/SPAdes-{sample}-S1.bam",
    "intermediates/binning/alignments/SPAdes/SPAdes-{sample}-S2.bam",
]
output = [
    "intermediates/binning/depths/SPAdes-{sample}-depth.txt.gz",
    "{config.out_dir}/GenomeBinning/depths/contigs/SPAdes-{sample}-depth.txt.gz",
]
depends_on = ["bowtie2_align_spades"]
description = "Per-contig depths of the cohort bams against the SPAdes assembly (upstream METABAT2_JGISUMMARIZEBAMCONTIGDEPTHS_SHORTREAD)"
shell = """
export OMP_NUM_THREADS={threads}
mkdir -p intermediates/binning/depths {config.out_dir}/GenomeBinning/depths/contigs
# bams are globbed in sorted order so depth column order is deterministic
bams=$(LC_ALL=C ls intermediates/binning/alignments/SPAdes/SPAdes-{sample}-*.bam)
jgi_summarize_bam_contig_depths --outputDepth SPAdes-{sample}-depth.txt $bams
bgzip --threads {threads} SPAdes-{sample}-depth.txt
mv SPAdes-{sample}-depth.txt.gz intermediates/binning/depths/
cp intermediates/binning/depths/SPAdes-{sample}-depth.txt.gz {config.out_dir}/GenomeBinning/depths/contigs/
"""

[rules.resources]
threads = 6
memory = "36G"
time_limit = "8h"

[rules.environment]
conda = "envs/mag_depths.yaml"

[[rules]]
name = "depths_megahit"
input = [
    # the bam files, not the dir: exact-string edges from the align
    # rule + per-file manifests propagate re-runs (live: a dir-only
    # input picked up stale cross-sample bams and MetaBAT2 spun on
    # the zero-column depth matrix)
    "intermediates/binning/alignments/MEGAHIT/MEGAHIT-{sample}-S1.bam",
    "intermediates/binning/alignments/MEGAHIT/MEGAHIT-{sample}-S2.bam",
]
output = [
    "intermediates/binning/depths/MEGAHIT-{sample}-depth.txt.gz",
    "{config.out_dir}/GenomeBinning/depths/contigs/MEGAHIT-{sample}-depth.txt.gz",
]
depends_on = ["bowtie2_align_megahit"]
description = "Per-contig depths of the cohort bams against the MEGAHIT assembly (upstream METABAT2_JGISUMMARIZEBAMCONTIGDEPTHS_SHORTREAD)"
shell = """
export OMP_NUM_THREADS={threads}
mkdir -p intermediates/binning/depths {config.out_dir}/GenomeBinning/depths/contigs
bams=$(LC_ALL=C ls intermediates/binning/alignments/MEGAHIT/MEGAHIT-{sample}-*.bam)
jgi_summarize_bam_contig_depths --outputDepth MEGAHIT-{sample}-depth.txt $bams
bgzip --threads {threads} MEGAHIT-{sample}-depth.txt
mv MEGAHIT-{sample}-depth.txt.gz intermediates/binning/depths/
cp intermediates/binning/depths/MEGAHIT-{sample}-depth.txt.gz {config.out_dir}/GenomeBinning/depths/contigs/
"""

[rules.resources]
threads = 6
memory = "36G"
time_limit = "8h"

[rules.environment]
conda = "envs/mag_depths.yaml"

# ---------------------------------------------------------------------------
# CONVERT_DEPTHS: one .abund file per read set (input for MaxBin2)
# ---------------------------------------------------------------------------
[[rules]]
name = "convert_depths_spades"
input = ["intermediates/binning/depths/SPAdes-{sample}-depth.txt.gz"]
output = ["intermediates/binning/maxbin2_abund/SPAdes"]
depends_on = ["depths_spades"]
description = "Split the SPAdes depth table into per-read-set abundance files for MaxBin2 (upstream CONVERT_DEPTHS)"
shell = """
wd=$(pwd)
# run in a per-sample scratch dir: the bioawk one-pass split writes generic
# *.abund names, and with a shared working directory concurrent samples
# would race on the unguarded `mv *.abund` (move each other's files / fail)
mkdir -p .tmp/convert_depths_spades_{sample} && cd .tmp/convert_depths_spades_{sample}
mkdir -p "$wd/intermediates/binning/maxbin2_abund/SPAdes"
# upstream bioawk one-pass split; column headers are <assembler>-<id>-<readset>.bam
gzip -cd "$wd/{input[0]}" | bioawk -t '
NR == 1 {
    n_abund = int((NF - 3) / 2)
    for (i = 1; i <= n_abund; i++) {
        name = $(i * 2 + 2)
        sub(/\\.bam$/, "", name)
        abund[i] = name ".abund"
    }
    next
}
{
    for (i = 1; i <= n_abund; i++) {
        print $1, $(i * 2 + 2) > (abund[i])
    }
}
'
for f in SPAdes-{sample}-*.abund; do
    [ -e "$f" ] && mv "$f" "$wd/intermediates/binning/maxbin2_abund/SPAdes/"
done
cd "$wd"
rm -rf .tmp/convert_depths_spades_{sample}
"""

[rules.resources]
threads = 1
memory = "7G"
time_limit = "4h"

[rules.environment]
conda = "envs/bioawk.yaml"

[[rules]]
name = "convert_depths_megahit"
input = ["intermediates/binning/depths/MEGAHIT-{sample}-depth.txt.gz"]
output = ["intermediates/binning/maxbin2_abund/MEGAHIT"]
depends_on = ["depths_megahit"]
description = "Split the MEGAHIT depth table into per-read-set abundance files for MaxBin2 (upstream CONVERT_DEPTHS)"
shell = """
wd=$(pwd)
# see convert_depths_spades
mkdir -p .tmp/convert_depths_megahit_{sample} && cd .tmp/convert_depths_megahit_{sample}
mkdir -p "$wd/intermediates/binning/maxbin2_abund/MEGAHIT"
gzip -cd "$wd/{input[0]}" | bioawk -t '
NR == 1 {
    n_abund = int((NF - 3) / 2)
    for (i = 1; i <= n_abund; i++) {
        name = $(i * 2 + 2)
        sub(/\\.bam$/, "", name)
        abund[i] = name ".abund"
    }
    next
}
{
    for (i = 1; i <= n_abund; i++) {
        print $1, $(i * 2 + 2) > (abund[i])
    }
}
'
for f in MEGAHIT-{sample}-*.abund; do
    [ -e "$f" ] && mv "$f" "$wd/intermediates/binning/maxbin2_abund/MEGAHIT/"
done
cd "$wd"
rm -rf .tmp/convert_depths_megahit_{sample}
"""

[rules.resources]
threads = 1
memory = "7G"
time_limit = "4h"

[rules.environment]
conda = "envs/bioawk.yaml"

# ---------------------------------------------------------------------------
# METABAT2 (label process_medium + 8 cpu/20GB/8h override)
# ---------------------------------------------------------------------------
[[rules]]
name = "metabat2_spades"
input = [
    "intermediates/assembly/SPAdes/SPAdes-{sample}.scaffolds.fa",
    "intermediates/binning/depths/SPAdes-{sample}-depth.txt.gz",
]
output = [
    "intermediates/binning/metabat2/{sample}/SPAdes-MetaBAT2-{sample}.unbinned.fa.gz",
    "{config.out_dir}/GenomeBinning/MetaBAT2/bins",
    "{config.out_dir}/GenomeBinning/MetaBAT2/discarded",
]
depends_on = ["depths_spades"]
description = "Binning of the SPAdes assembly with MetaBAT2 (upstream METABAT2_METABAT2)"
shell = """
wd=$(pwd)
mkdir -p .tmp/metabat2_spades_{sample} && cd .tmp/metabat2_spades_{sample}
mkdir input_bins
ln -sf "$wd/{input[0]}" input_bins/SPAdes-{sample}.scaffolds.fa
ln -sf "$wd/{input[1]}" depth.txt.gz
gzip -d -f depth.txt.gz
prefix=SPAdes-MetaBAT2-{sample}
# upstream clamps -m to 1500 (conf/modules.config METABAT2_METABAT2 ext.args)
mcs=$([ "{config.min_contig_size}" -lt 1500 ] && echo 1500 || echo "{config.min_contig_size}")
metabat2 \\
    -m $mcs \\
    --unbinned \\
    --seed {config.metabat_rng_seed} \\
    -i input_bins \\
    -a depth.txt \\
    -t {threads} \\
    --saveCls \\
    -o $prefix
gzip -cn $prefix > $prefix.tsv.gz
find . -maxdepth 1 -name "*.fa" -type f | xargs -t -n 1 bgzip -@ {threads}
mkdir -p "$wd/intermediates/binning/metabat2/{sample}" \\
         "$wd/{config.out_dir}/GenomeBinning/MetaBAT2/bins" \\
         "$wd/{config.out_dir}/GenomeBinning/MetaBAT2/discarded"
# upstream publishes tooShort/lowDepth to MetaBAT2/discarded/
for f in $prefix.tooShort.fa.gz $prefix.lowDepth.fa.gz; do
    [ -e "$f" ] && mv "$f" "$wd/{config.out_dir}/GenomeBinning/MetaBAT2/discarded/"
done
mv $prefix.unbinned.fa.gz "$wd/intermediates/binning/metabat2/{sample}/"
mv $prefix.tsv.gz "$wd/intermediates/binning/metabat2/{sample}/"
for f in $prefix.*.fa.gz; do
    [ -e "$f" ] && mv "$f" "$wd/{config.out_dir}/GenomeBinning/MetaBAT2/bins/"
done
cd "$wd"
rm -rf .tmp/metabat2_spades_{sample}
"""

[rules.resources]
threads = 8
memory = "20G"
time_limit = "8h"

[rules.environment]
conda = "envs/metabat2.yaml"

[[rules]]
name = "metabat2_megahit"
input = [
    "intermediates/assembly/MEGAHIT/MEGAHIT-{sample}.contigs.fa",
    "intermediates/binning/depths/MEGAHIT-{sample}-depth.txt.gz",
]
output = [
    "intermediates/binning/metabat2/{sample}/MEGAHIT-MetaBAT2-{sample}.unbinned.fa.gz",
    "{config.out_dir}/GenomeBinning/MetaBAT2/bins",
    "{config.out_dir}/GenomeBinning/MetaBAT2/discarded",
]
depends_on = ["depths_megahit"]
description = "Binning of the MEGAHIT assembly with MetaBAT2 (upstream METABAT2_METABAT2)"
shell = """
wd=$(pwd)
mkdir -p .tmp/metabat2_megahit_{sample} && cd .tmp/metabat2_megahit_{sample}
mkdir input_bins
ln -sf "$wd/{input[0]}" input_bins/MEGAHIT-{sample}.contigs.fa
ln -sf "$wd/{input[1]}" depth.txt.gz
gzip -d -f depth.txt.gz
prefix=MEGAHIT-MetaBAT2-{sample}
# upstream clamps -m to 1500 (conf/modules.config METABAT2_METABAT2 ext.args)
mcs=$([ "{config.min_contig_size}" -lt 1500 ] && echo 1500 || echo "{config.min_contig_size}")
metabat2 \\
    -m $mcs \\
    --unbinned \\
    --seed {config.metabat_rng_seed} \\
    -i input_bins \\
    -a depth.txt \\
    -t {threads} \\
    --saveCls \\
    -o $prefix
gzip -cn $prefix > $prefix.tsv.gz
find . -maxdepth 1 -name "*.fa" -type f | xargs -t -n 1 bgzip -@ {threads}
mkdir -p "$wd/intermediates/binning/metabat2/{sample}" \\
         "$wd/{config.out_dir}/GenomeBinning/MetaBAT2/bins" \\
         "$wd/{config.out_dir}/GenomeBinning/MetaBAT2/discarded"
# upstream publishes tooShort/lowDepth to MetaBAT2/discarded/
for f in $prefix.tooShort.fa.gz $prefix.lowDepth.fa.gz; do
    [ -e "$f" ] && mv "$f" "$wd/{config.out_dir}/GenomeBinning/MetaBAT2/discarded/"
done
mv $prefix.unbinned.fa.gz "$wd/intermediates/binning/metabat2/{sample}/"
mv $prefix.tsv.gz "$wd/intermediates/binning/metabat2/{sample}/"
for f in $prefix.*.fa.gz; do
    [ -e "$f" ] && mv "$f" "$wd/{config.out_dir}/GenomeBinning/MetaBAT2/bins/"
done
cd "$wd"
rm -rf .tmp/metabat2_megahit_{sample}
"""

[rules.resources]
threads = 8
memory = "20G"
time_limit = "8h"

[rules.environment]
conda = "envs/metabat2.yaml"

# ---------------------------------------------------------------------------
# MAXBIN2 (label process_medium; prefix {assembler}-MaxBin2-{id})
# ---------------------------------------------------------------------------
[[rules]]
name = "maxbin2_spades"
input = [
    "intermediates/assembly/SPAdes/SPAdes-{sample}.scaffolds.fa",
    "intermediates/binning/maxbin2_abund/SPAdes",
]
output = [
    "intermediates/binning/maxbin2/{sample}/SPAdes-MaxBin2-{sample}.noclass.gz",
    "{config.out_dir}/GenomeBinning/MaxBin2/bins",
    "{config.out_dir}/GenomeBinning/MaxBin2/discarded",
]
depends_on = ["convert_depths_spades"]
description = "Binning of the SPAdes assembly with MaxBin2 (upstream MAXBIN2)"
shell = """
wd=$(pwd)
mkdir -p .tmp/maxbin2_spades_{sample} && cd .tmp/maxbin2_spades_{sample}
mkdir input/
ln -sf "$wd/{input[0]}" input/SPAdes-{sample}.scaffolds.fa
prefix=SPAdes-MaxBin2-{sample}
# one -abund{n} arg per read set, in sorted (deterministic) order; the first
# gets the bare -abund form (upstream builds 1..n)
abund_args=""
n=0
for f in $(LC_ALL=C ls "$wd/intermediates/binning/maxbin2_abund/SPAdes/SPAdes-{sample}-"*.abund); do
    n=$((n + 1))
    if [ "$n" -eq 1 ]; then
        abund_args="-abund $f"
    else
        abund_args="$abund_args -abund${n} $f"
    fi
done
run_MaxBin.pl \\
    -contig input/SPAdes-{sample}.scaffolds.fa \\
    $abund_args \\
    -thread {threads} \\
    -out $prefix
gzip *.fasta *.noclass *.tooshort *log *.marker
for file in *.fasta.gz; do
    mv "$file" "${file%.fasta.gz}.fa.gz"
done
mkdir -p "$wd/intermediates/binning/maxbin2/{sample}" \\
         "$wd/{config.out_dir}/GenomeBinning/MaxBin2/bins" \\
         "$wd/{config.out_dir}/GenomeBinning/MaxBin2/discarded"
mv $prefix.noclass.gz "$wd/intermediates/binning/maxbin2/{sample}/"
mv $prefix.tooshort.gz "$wd/{config.out_dir}/GenomeBinning/MaxBin2/discarded/"
mv $prefix.summary "$wd/{config.out_dir}/GenomeBinning/MaxBin2/"
for f in $prefix.*.fa.gz; do
    [ -e "$f" ] && mv "$f" "$wd/{config.out_dir}/GenomeBinning/MaxBin2/bins/"
done
cd "$wd"
rm -rf .tmp/maxbin2_spades_{sample}
"""

[rules.resources]
threads = 6
memory = "36G"
time_limit = "8h"

[rules.environment]
conda = "envs/maxbin2.yaml"

[[rules]]
name = "maxbin2_megahit"
input = [
    "intermediates/assembly/MEGAHIT/MEGAHIT-{sample}.contigs.fa",
    "intermediates/binning/maxbin2_abund/MEGAHIT",
]
output = [
    "intermediates/binning/maxbin2/{sample}/MEGAHIT-MaxBin2-{sample}.noclass.gz",
    "{config.out_dir}/GenomeBinning/MaxBin2/bins",
    "{config.out_dir}/GenomeBinning/MaxBin2/discarded",
]
depends_on = ["convert_depths_megahit"]
description = "Binning of the MEGAHIT assembly with MaxBin2 (upstream MAXBIN2)"
shell = """
wd=$(pwd)
mkdir -p .tmp/maxbin2_megahit_{sample} && cd .tmp/maxbin2_megahit_{sample}
mkdir input/
ln -sf "$wd/{input[0]}" input/MEGAHIT-{sample}.contigs.fa
prefix=MEGAHIT-MaxBin2-{sample}
abund_args=""
n=0
for f in $(LC_ALL=C ls "$wd/intermediates/binning/maxbin2_abund/MEGAHIT/MEGAHIT-{sample}-"*.abund); do
    n=$((n + 1))
    if [ "$n" -eq 1 ]; then
        abund_args="-abund $f"
    else
        abund_args="$abund_args -abund${n} $f"
    fi
done
run_MaxBin.pl \\
    -contig input/MEGAHIT-{sample}.contigs.fa \\
    $abund_args \\
    -thread {threads} \\
    -out $prefix
gzip *.fasta *.noclass *.tooshort *log *.marker
for file in *.fasta.gz; do
    mv "$file" "${file%.fasta.gz}.fa.gz"
done
mkdir -p "$wd/intermediates/binning/maxbin2/{sample}" \\
         "$wd/{config.out_dir}/GenomeBinning/MaxBin2/bins" \\
         "$wd/{config.out_dir}/GenomeBinning/MaxBin2/discarded"
mv $prefix.noclass.gz "$wd/intermediates/binning/maxbin2/{sample}/"
mv $prefix.tooshort.gz "$wd/{config.out_dir}/GenomeBinning/MaxBin2/discarded/"
mv $prefix.summary "$wd/{config.out_dir}/GenomeBinning/MaxBin2/"
for f in $prefix.*.fa.gz; do
    [ -e "$f" ] && mv "$f" "$wd/{config.out_dir}/GenomeBinning/MaxBin2/bins/"
done
cd "$wd"
rm -rf .tmp/maxbin2_megahit_{sample}
"""

[rules.resources]
threads = 6
memory = "36G"
time_limit = "8h"

[rules.environment]
conda = "envs/maxbin2.yaml"

# ---------------------------------------------------------------------------
# CONCOCT (5 upstream processes per assembly; prefix {assembler}-CONCOCT-{id})
# ---------------------------------------------------------------------------
[[rules]]
name = "concoct_cutup_spades"
input = ["intermediates/assembly/SPAdes/SPAdes-{sample}.scaffolds.fa"]
output = [
    "intermediates/binning/concoct/{sample}/SPAdes-CONCOCT-{sample}.fasta",
    "intermediates/binning/concoct/{sample}/SPAdes-CONCOCT-{sample}.bed",
]
description = "Cut the SPAdes assembly into chunks (upstream CONCOCT_CUTUPFASTA)"
shell = """
mkdir -p intermediates/binning/concoct/{sample}
cut_up_fasta.py \\
    {input[0]} \\
    -c {config.bin_concoct_chunksize} \\
    -o {config.bin_concoct_overlap} \\
    --merge_last \\
    -b SPAdes-CONCOCT-{sample}.bed \\
    > SPAdes-CONCOCT-{sample}.fasta
mv SPAdes-CONCOCT-{sample}.fasta SPAdes-CONCOCT-{sample}.bed intermediates/binning/concoct/{sample}/
"""

[rules.resources]
threads = 1
memory = "6G"
time_limit = "4h"

[rules.environment]
conda = "envs/concoct.yaml"

[[rules]]
name = "concoct_cutup_megahit"
input = ["intermediates/assembly/MEGAHIT/MEGAHIT-{sample}.contigs.fa"]
output = [
    "intermediates/binning/concoct/{sample}/MEGAHIT-CONCOCT-{sample}.fasta",
    "intermediates/binning/concoct/{sample}/MEGAHIT-CONCOCT-{sample}.bed",
]
description = "Cut the MEGAHIT assembly into chunks (upstream CONCOCT_CUTUPFASTA)"
shell = """
mkdir -p intermediates/binning/concoct/{sample}
cut_up_fasta.py \\
    {input[0]} \\
    -c {config.bin_concoct_chunksize} \\
    -o {config.bin_concoct_overlap} \\
    --merge_last \\
    -b MEGAHIT-CONCOCT-{sample}.bed \\
    > MEGAHIT-CONCOCT-{sample}.fasta
mv MEGAHIT-CONCOCT-{sample}.fasta MEGAHIT-CONCOCT-{sample}.bed intermediates/binning/concoct/{sample}/
"""

[rules.resources]
threads = 1
memory = "6G"
time_limit = "4h"

[rules.environment]
conda = "envs/concoct.yaml"

[[rules]]
name = "concoct_table_spades"
input = [
    "intermediates/binning/concoct/{sample}/SPAdes-CONCOCT-{sample}.bed",
    "intermediates/binning/alignments/SPAdes",
]
output = ["intermediates/binning/concoct/{sample}/SPAdes-CONCOCT-{sample}.tsv"]
depends_on = ["concoct_cutup_spades", "bowtie2_align_spades"]
description = "Coverage table of the cohort bams on the cut SPAdes contigs (upstream CONCOCT_CONCOCTCOVERAGETABLE)"
shell = """
bams=$(LC_ALL=C ls intermediates/binning/alignments/SPAdes/SPAdes-{sample}-*.bam)
concoct_coverage_table.py \\
    intermediates/binning/concoct/{sample}/SPAdes-CONCOCT-{sample}.bed \\
    $bams \\
    > SPAdes-CONCOCT-{sample}.tsv
mv SPAdes-CONCOCT-{sample}.tsv intermediates/binning/concoct/{sample}/
"""

[rules.resources]
threads = 1
memory = "6G"
time_limit = "4h"

[rules.environment]
conda = "envs/concoct.yaml"

[[rules]]
name = "concoct_table_megahit"
input = [
    "intermediates/binning/concoct/{sample}/MEGAHIT-CONCOCT-{sample}.bed",
    "intermediates/binning/alignments/MEGAHIT",
]
output = ["intermediates/binning/concoct/{sample}/MEGAHIT-CONCOCT-{sample}.tsv"]
depends_on = ["concoct_cutup_megahit", "bowtie2_align_megahit"]
description = "Coverage table of the cohort bams on the cut MEGAHIT contigs (upstream CONCOCT_CONCOCTCOVERAGETABLE)"
shell = """
bams=$(LC_ALL=C ls intermediates/binning/alignments/MEGAHIT/MEGAHIT-{sample}-*.bam)
concoct_coverage_table.py \\
    intermediates/binning/concoct/{sample}/MEGAHIT-CONCOCT-{sample}.bed \\
    $bams \\
    > MEGAHIT-CONCOCT-{sample}.tsv
mv MEGAHIT-CONCOCT-{sample}.tsv intermediates/binning/concoct/{sample}/
"""

[rules.resources]
threads = 1
memory = "6G"
time_limit = "4h"

[rules.environment]
conda = "envs/concoct.yaml"

[[rules]]
name = "concoct_spades"
input = [
    "intermediates/binning/concoct/{sample}/SPAdes-CONCOCT-{sample}.tsv",
    "intermediates/binning/concoct/{sample}/SPAdes-CONCOCT-{sample}.fasta",
]
output = ["intermediates/binning/concoct/{sample}/SPAdes-CONCOCT-{sample}_clustering_gt1000.csv"]
depends_on = ["concoct_table_spades"]
description = "Clustering of the cut SPAdes contigs (upstream CONCOCT_CONCOCT)"
shell = """
concoct \\
    --threads {threads} \\
    --coverage_file intermediates/binning/concoct/{sample}/SPAdes-CONCOCT-{sample}.tsv \\
    --composition_file intermediates/binning/concoct/{sample}/SPAdes-CONCOCT-{sample}.fasta \\
    -b SPAdes-CONCOCT-{sample}
mv SPAdes-CONCOCT-{sample}_clustering_gt1000.csv intermediates/binning/concoct/{sample}/
"""

[rules.resources]
threads = 12
memory = "24G"
time_limit = "16h"

[rules.environment]
conda = "envs/concoct.yaml"

[[rules]]
name = "concoct_megahit"
input = [
    "intermediates/binning/concoct/{sample}/MEGAHIT-CONCOCT-{sample}.tsv",
    "intermediates/binning/concoct/{sample}/MEGAHIT-CONCOCT-{sample}.fasta",
]
output = ["intermediates/binning/concoct/{sample}/MEGAHIT-CONCOCT-{sample}_clustering_gt1000.csv"]
depends_on = ["concoct_table_megahit"]
description = "Clustering of the cut MEGAHIT contigs (upstream CONCOCT_CONCOCT)"
shell = """
concoct \\
    --threads {threads} \\
    --coverage_file intermediates/binning/concoct/{sample}/MEGAHIT-CONCOCT-{sample}.tsv \\
    --composition_file intermediates/binning/concoct/{sample}/MEGAHIT-CONCOCT-{sample}.fasta \\
    -b MEGAHIT-CONCOCT-{sample}
mv MEGAHIT-CONCOCT-{sample}_clustering_gt1000.csv intermediates/binning/concoct/{sample}/
"""

[rules.resources]
threads = 12
memory = "24G"
time_limit = "16h"

[rules.environment]
conda = "envs/concoct.yaml"

[[rules]]
name = "concoct_merge_spades"
input = ["intermediates/binning/concoct/{sample}/SPAdes-CONCOCT-{sample}_clustering_gt1000.csv"]
output = [
    "intermediates/binning/concoct/{sample}/SPAdes-CONCOCT-{sample}.csv",
    "{config.out_dir}/GenomeBinning/CONCOCT/stats",
]
depends_on = ["concoct_spades"]
description = "Merge the cut-up SPAdes clustering (upstream CONCOCT_MERGECUTUPCLUSTERING)"
shell = """
wd=$(pwd)
merge_cutup_clustering.py \\
    intermediates/binning/concoct/{sample}/SPAdes-CONCOCT-{sample}_clustering_gt1000.csv \\
    > SPAdes-CONCOCT-{sample}.csv
mv SPAdes-CONCOCT-{sample}.csv intermediates/binning/concoct/{sample}/
# upstream publishes every CONCOCT *.{txt,csv,tsv} artifact to CONCOCT/stats/
mkdir -p "$wd/{config.out_dir}/GenomeBinning/CONCOCT/stats"
for s in SPAdes-CONCOCT-{sample}_clustering_gt1000.csv SPAdes-CONCOCT-{sample}.csv SPAdes-CONCOCT-{sample}.tsv; do
    [ -e "intermediates/binning/concoct/{sample}/$s" ] && cp "intermediates/binning/concoct/{sample}/$s" "$wd/{config.out_dir}/GenomeBinning/CONCOCT/stats/"
done
"""

[rules.resources]
threads = 1
memory = "6G"
time_limit = "4h"

[rules.environment]
conda = "envs/concoct.yaml"

[[rules]]
name = "concoct_merge_megahit"
input = ["intermediates/binning/concoct/{sample}/MEGAHIT-CONCOCT-{sample}_clustering_gt1000.csv"]
output = [
    "intermediates/binning/concoct/{sample}/MEGAHIT-CONCOCT-{sample}.csv",
    "{config.out_dir}/GenomeBinning/CONCOCT/stats",
]
depends_on = ["concoct_megahit"]
description = "Merge the cut-up MEGAHIT clustering (upstream CONCOCT_MERGECUTUPCLUSTERING)"
shell = """
wd=$(pwd)
merge_cutup_clustering.py \\
    intermediates/binning/concoct/{sample}/MEGAHIT-CONCOCT-{sample}_clustering_gt1000.csv \\
    > MEGAHIT-CONCOCT-{sample}.csv
mv MEGAHIT-CONCOCT-{sample}.csv intermediates/binning/concoct/{sample}/
# upstream publishes every CONCOCT *.{txt,csv,tsv} artifact to CONCOCT/stats/
mkdir -p "$wd/{config.out_dir}/GenomeBinning/CONCOCT/stats"
for s in MEGAHIT-CONCOCT-{sample}_clustering_gt1000.csv MEGAHIT-CONCOCT-{sample}.csv MEGAHIT-CONCOCT-{sample}.tsv; do
    [ -e "intermediates/binning/concoct/{sample}/$s" ] && cp "intermediates/binning/concoct/{sample}/$s" "$wd/{config.out_dir}/GenomeBinning/CONCOCT/stats/"
done
"""

[rules.resources]
threads = 1
memory = "6G"
time_limit = "4h"

[rules.environment]
conda = "envs/concoct.yaml"

[[rules]]
name = "concoct_extract_spades"
input = [
    "intermediates/assembly/SPAdes/SPAdes-{sample}.scaffolds.fa",
    "intermediates/binning/concoct/{sample}/SPAdes-CONCOCT-{sample}.csv",
]
output = ["{config.out_dir}/GenomeBinning/CONCOCT/bins"]
depends_on = ["concoct_merge_spades"]
description = "Extract the SPAdes CONCOCT bins (upstream CONCOCT_EXTRACTFASTABINS)"
shell = """
wd=$(pwd)
mkdir -p .tmp/concoct_spades_{sample} && cd .tmp/concoct_spades_{sample}
ln -sf "$wd/{input[0]}" assembly.fa
prefix=SPAdes-CONCOCT-{sample}
extract_fasta_bins.py \\
    assembly.fa \\
    "$wd/intermediates/binning/concoct/{sample}/$prefix.csv" \\
    --output_path $prefix
for i in $prefix/*.fa; do
    mv "$i" "$(basename "$i")"
    gzip "$(basename "$i")"
done
mkdir -p "$wd/{config.out_dir}/GenomeBinning/CONCOCT/bins"
mv ${prefix}_*.fa.gz "$wd/{config.out_dir}/GenomeBinning/CONCOCT/bins/"
cd "$wd"
rm -rf .tmp/concoct_spades_{sample}
"""

[rules.resources]
threads = 1
memory = "6G"
time_limit = "4h"

[rules.environment]
conda = "envs/concoct.yaml"

[[rules]]
name = "concoct_extract_megahit"
