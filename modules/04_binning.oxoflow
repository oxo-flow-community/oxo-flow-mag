for f in *.pooled.fa.gz *.remaining.fa.gz; do
    [ -e "$f" ] && mv "$f" "$wd/{config.out_dir}/GenomeBinning/MetaBAT2/unbinned/discarded/"
done
mv MEGAHIT-MetaBAT2-{sample}.unbinned.*.fa.gz "$wd/{config.out_dir}/GenomeBinning/MetaBAT2/unbinned/"
cd "$wd"
rm -rf .tmp/split_mb2_megahit_{sample}
"""

