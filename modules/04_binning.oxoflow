python $metabinner_path/scripts/gen_kmer.py assembly.fa {config.min_contig_size} 4
gzip -cn assembly_kmer_4_f{config.min_contig_size}.csv > MEGAHIT-MetaBinner-{sample}_kmer_4_f{config.min_contig_size}.csv.gz
mv MEGAHIT-MetaBinner-{sample}_kmer_4_f{config.min_contig_size}.csv.gz "$wd/intermediates/binning/metabinner/{sample}/"
cd "$wd"
rm -rf .tmp/mb_kmer_megahit_{sample}
"""

[rules.resources]
threads = 2
memory = "12G"
time_limit = "4h"

[rules.environment]
conda = "envs/metabinner.yaml"

[[rules]]
name = "metabinner_tooshort_spades"
input = ["intermediates/assembly/SPAdes/SPAdes-{sample}.scaffolds.fa"]
output = ["intermediates/binning/metabinner/{sample}/SPAdes-MetaBinner-{sample}.{config.min_contig_size}.fa"]
description = "Remove too-short contigs from the SPAdes assembly (upstream METABINNER_TOOSHORT)"
shell = """
mkdir -p intermediates/binning/metabinner/{sample}
wd=$(pwd)
mkdir -p .tmp/mb_tooshort_spades_{sample} && cd .tmp/mb_tooshort_spades_{sample}
ln -sf "$wd/{input[0]}" assembly.fa
metabinner_path=$(dirname $(which run_metabinner.sh))
python $metabinner_path/scripts/Filter_tooshort.py assembly.fa {config.min_contig_size}
mv assembly_{config.min_contig_size}.fa SPAdes-MetaBinner-{sample}.{config.min_contig_size}.fa
mv SPAdes-MetaBinner-{sample}.{config.min_contig_size}.fa "$wd/intermediates/binning/metabinner/{sample}/"
cd "$wd"
rm -rf .tmp/mb_tooshort_spades_{sample}
"""

[rules.resources]
threads = 2
memory = "12G"
time_limit = "4h"

[rules.environment]
conda = "envs/metabinner.yaml"

[[rules]]
name = "metabinner_tooshort_megahit"
input = ["intermediates/assembly/MEGAHIT/MEGAHIT-{sample}.contigs.fa"]
output = ["intermediates/binning/metabinner/{sample}/MEGAHIT-MetaBinner-{sample}.{config.min_contig_size}.fa"]
description = "Remove too-short contigs from the MEGAHIT assembly (upstream METABINNER_TOOSHORT)"
shell = """
mkdir -p intermediates/binning/metabinner/{sample}
wd=$(pwd)
mkdir -p .tmp/mb_tooshort_megahit_{sample} && cd .tmp/mb_tooshort_megahit_{sample}
ln -sf "$wd/{input[0]}" assembly.fa
metabinner_path=$(dirname $(which run_metabinner.sh))
python $metabinner_path/scripts/Filter_tooshort.py assembly.fa {config.min_contig_size}
mv assembly_{config.min_contig_size}.fa MEGAHIT-MetaBinner-{sample}.{config.min_contig_size}.fa
mv MEGAHIT-MetaBinner-{sample}.{config.min_contig_size}.fa "$wd/intermediates/binning/metabinner/{sample}/"
cd "$wd"
rm -rf .tmp/mb_tooshort_megahit_{sample}
"""

[rules.resources]
threads = 2
memory = "12G"
time_limit = "4h"

[rules.environment]
conda = "envs/metabinner.yaml"

[[rules]]
name = "metabinner_run_spades"
input = [
    "intermediates/binning/metabinner/{sample}/SPAdes-MetaBinner-{sample}.{config.min_contig_size}.fa",
    "intermediates/binning/metabinner/{sample}/SPAdes-MetaBinner-{sample}_kmer_4_f{config.min_contig_size}.csv.gz",
    "intermediates/binning/depths/SPAdes-{sample}-depth.txt.gz",
]
output = [
    "intermediates/binning/metabinner/{sample}/SPAdes-MetaBinner-{sample}.tsv.gz",
    "intermediates/binning/metabinner/{sample}/SPAdes-MetaBinner-{sample}.metabinner.log.gz",
]
depends_on = ["metabinner_kmer_spades", "metabinner_tooshort_spades", "depths_spades"]
description = "Run MetaBinner on the SPAdes assembly (upstream METABINNER_METABINNER)"
shell = """
wd=$(pwd)
mkdir -p intermediates/binning/metabinner/{sample}
mkdir -p .tmp/mb_run_spades_{sample} && cd .tmp/mb_run_spades_{sample}
ln -sf "$wd/{input[0]}" filtered.fa
ln -sf "$wd/{input[1]}" kmer.csv.gz
ln -sf "$wd/{input[2]}" depth.txt.gz
# unzip kmer file
zcat kmer.csv.gz > kmer_profile.csv
# create coverage profile in MetaBinner format (contigs >= min_contig_size)
zcat depth.txt.gz | awk '{if ($2>{config.min_contig_size}) print $0 }' | cut -f -1,4- > coverage_profile.tsv
# requires absolute paths
metabinner_path=$(dirname $(which run_metabinner.sh))
prefix=SPAdes-MetaBinner-{sample}
bash run_metabinner.sh \\
    -a "$wd/{input[0]}" \\
    -o "$wd/.tmp/mb_run_spades_{sample}/$prefix" \\
    -d "$wd/.tmp/mb_run_spades_{sample}/coverage_profile.tsv" \\
    -k "$wd/.tmp/mb_run_spades_{sample}/kmer_profile.csv" \\
    -t {threads} \\
    -p $metabinner_path \\
    -s {config.bin_metabinner_scale}
rm kmer_profile.csv
gzip -cn $prefix/metabinner_res/metabinner_result.tsv > $prefix.tsv.gz
gzip -cn $prefix/metabinner_res/result.log > $prefix.metabinner.log.gz
mv $prefix.tsv.gz $prefix.metabinner.log.gz "$wd/intermediates/binning/metabinner/{sample}/"
cd "$wd"
rm -rf .tmp/mb_run_spades_{sample}
"""

[rules.resources]
threads = 6
memory = "36G"
time_limit = "8h"

[rules.environment]
conda = "envs/metabinner.yaml"

[[rules]]
name = "metabinner_run_megahit"
input = [
    "intermediates/binning/metabinner/{sample}/MEGAHIT-MetaBinner-{sample}.{config.min_contig_size}.fa",
    "intermediates/binning/metabinner/{sample}/MEGAHIT-MetaBinner-{sample}_kmer_4_f{config.min_contig_size}.csv.gz",
    "intermediates/binning/depths/MEGAHIT-{sample}-depth.txt.gz",
]
output = [
    "intermediates/binning/metabinner/{sample}/MEGAHIT-MetaBinner-{sample}.tsv.gz",
    "intermediates/binning/metabinner/{sample}/MEGAHIT-MetaBinner-{sample}.metabinner.log.gz",
]
depends_on = ["metabinner_kmer_megahit", "metabinner_tooshort_megahit", "depths_megahit"]
description = "Run MetaBinner on the MEGAHIT assembly (upstream METABINNER_METABINNER)"
shell = """
wd=$(pwd)
mkdir -p intermediates/binning/metabinner/{sample}
mkdir -p .tmp/mb_run_megahit_{sample} && cd .tmp/mb_run_megahit_{sample}
ln -sf "$wd/{input[0]}" filtered.fa
ln -sf "$wd/{input[1]}" kmer.csv.gz
ln -sf "$wd/{input[2]}" depth.txt.gz
zcat kmer.csv.gz > kmer_profile.csv
zcat depth.txt.gz | awk '{if ($2>{config.min_contig_size}) print $0 }' | cut -f -1,4- > coverage_profile.tsv
metabinner_path=$(dirname $(which run_metabinner.sh))
prefix=MEGAHIT-MetaBinner-{sample}
bash run_metabinner.sh \\
    -a "$wd/{input[0]}" \\
    -o "$wd/.tmp/mb_run_megahit_{sample}/$prefix" \\
    -d "$wd/.tmp/mb_run_megahit_{sample}/coverage_profile.tsv" \\
    -k "$wd/.tmp/mb_run_megahit_{sample}/kmer_profile.csv" \\
    -t {threads} \\
    -p $metabinner_path \\
    -s {config.bin_metabinner_scale}
rm kmer_profile.csv
gzip -cn $prefix/metabinner_res/metabinner_result.tsv > $prefix.tsv.gz
gzip -cn $prefix/metabinner_res/result.log > $prefix.metabinner.log.gz
mv $prefix.tsv.gz $prefix.metabinner.log.gz "$wd/intermediates/binning/metabinner/{sample}/"
cd "$wd"
rm -rf .tmp/mb_run_megahit_{sample}
"""

[rules.resources]
threads = 6
memory = "36G"
time_limit = "8h"

[rules.environment]
conda = "envs/metabinner.yaml"

[[rules]]
name = "metabinner_bins_spades"
input = [
    "intermediates/assembly/SPAdes/SPAdes-{sample}.scaffolds.fa",
    "intermediates/binning/metabinner/{sample}/SPAdes-MetaBinner-{sample}.tsv.gz",
]
output = [
    "{config.out_dir}/GenomeBinning/MetaBinner/bins",
    "{config.out_dir}/GenomeBinning/MetaBinner/unbinned",
    "{config.out_dir}/GenomeBinning/MetaBinner/discarded",
    "intermediates/binning/metabinner/{sample}/SPAdes-MetaBinner-{sample}.unbinned.fa.gz",
]
depends_on = ["metabinner_run_spades"]
description = "Extract the SPAdes MetaBinner bins (upstream METABINNER_BINS)"
shell = """
wd=$(pwd)
mkdir -p .tmp/mb_bins_spades_{sample} && cd .tmp/mb_bins_spades_{sample}
ln -sf "$wd/{input[0]}" assembly.fa
zcat "$wd/{input[1]}" > membership.tsv
prefix=SPAdes-MetaBinner-{sample}
python "$wd/scripts/create_metabinner_bins.py" membership.tsv assembly.fa ./bins $prefix {config.min_contig_size}
mkdir -p "$wd/{config.out_dir}/GenomeBinning/MetaBinner/bins" \\
         "$wd/{config.out_dir}/GenomeBinning/MetaBinner/unbinned" \\
         "$wd/{config.out_dir}/GenomeBinning/MetaBinner/discarded" \\
         "$wd/intermediates/binning/metabinner/{sample}"
# upstream METABINNER_BINS publishes tooShort/lowDepth to MetaBinner/discarded
# and unbinned to MetaBinner/unbinned; create_metabinner_bins.py never emits a
# lowDepth file, so that move is guarded
[ -e $prefix.tooShort.fa.gz ] && mv $prefix.tooShort.fa.gz "$wd/{config.out_dir}/GenomeBinning/MetaBinner/discarded/"
[ -e $prefix.lowDepth.fa.gz ] && mv $prefix.lowDepth.fa.gz "$wd/{config.out_dir}/GenomeBinning/MetaBinner/discarded/"
mv $prefix.unbinned.fa.gz "$wd/intermediates/binning/metabinner/{sample}/"
cp "$wd/intermediates/binning/metabinner/{sample}/$prefix.unbinned.fa.gz" "$wd/{config.out_dir}/GenomeBinning/MetaBinner/unbinned/"
if ls bins/*.fa.gz >/dev/null 2>&1; then
    mv bins/*.fa.gz "$wd/{config.out_dir}/GenomeBinning/MetaBinner/bins/"
fi
cd "$wd"
rm -rf .tmp/mb_bins_spades_{sample}
"""

[rules.resources]
threads = 2
memory = "12G"
time_limit = "4h"

[rules.environment]
conda = "envs/metabinner.yaml"

[[rules]]
name = "metabinner_bins_megahit"
