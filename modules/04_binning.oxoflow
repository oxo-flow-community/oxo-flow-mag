# ---------------------------------------------------------------------------
# SPLIT_FASTA (label process_low; one per unbinned source: MetaBAT2, MaxBin2,
# MetaBinner). split_fasta.py names the chunks after the input basename
# (minus .gz and the fasta extension), so the rule symlinks the input into
# the scratch dir first. Chunks go to results/GenomeBinning/{binner}/unbinned/,
# pooled/remaining contigs to .../unbinned/discarded/ (upstream publishDir
# intent; Nextflow's globs would actually match both).
# ---------------------------------------------------------------------------
[[rules]]
name = "split_fasta_metabat2_spades"
input = ["intermediates/binning/metabat2/{sample}/SPAdes-MetaBAT2-{sample}.unbinned.fa.gz"]
output = [
    "{config.out_dir}/GenomeBinning/MetaBAT2/unbinned",
    "{config.out_dir}/GenomeBinning/MetaBAT2/unbinned/discarded",
]
depends_on = ["metabat2_spades"]
description = "Split the SPAdes MetaBAT2 unbinned contigs into chunks (upstream SPLIT_FASTA)"
shell = """
wd=$(pwd)
mkdir -p .tmp/split_mb2_spades_{sample} && cd .tmp/split_mb2_spades_{sample}
ln -sf "$wd/{input[0]}" SPAdes-MetaBAT2-{sample}.unbinned.fa.gz
python "$wd/scripts/split_fasta.py" \\
    SPAdes-MetaBAT2-{sample}.unbinned.fa.gz \\
    {config.min_length_unbinned_contigs} \\
    {config.max_unbinned_contigs} \\
    {config.min_contig_size}
gzip *.fa
mkdir -p "$wd/{config.out_dir}/GenomeBinning/MetaBAT2/unbinned/discarded"
for f in *.pooled.fa.gz *.remaining.fa.gz; do
    [ -e "$f" ] && mv "$f" "$wd/{config.out_dir}/GenomeBinning/MetaBAT2/unbinned/discarded/"
done
mv SPAdes-MetaBAT2-{sample}.unbinned.*.fa.gz "$wd/{config.out_dir}/GenomeBinning/MetaBAT2/unbinned/"
cd "$wd"
rm -rf .tmp/split_mb2_spades_{sample}
"""

[rules.resources]
threads = 2
memory = "12G"
time_limit = "4h"

[rules.environment]
conda = "envs/split_fasta.yaml"

[[rules]]
name = "split_fasta_metabat2_megahit"
input = ["intermediates/binning/metabat2/{sample}/MEGAHIT-MetaBAT2-{sample}.unbinned.fa.gz"]
output = [
    "{config.out_dir}/GenomeBinning/MetaBAT2/unbinned",
    "{config.out_dir}/GenomeBinning/MetaBAT2/unbinned/discarded",
]
