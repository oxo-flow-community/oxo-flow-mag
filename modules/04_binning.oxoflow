mkdir -p .tmp/mb_bins_megahit_{sample} && cd .tmp/mb_bins_megahit_{sample}
ln -sf "$wd/{input[0]}" assembly.fa
zcat "$wd/{input[1]}" > membership.tsv
prefix=MEGAHIT-MetaBinner-{sample}
python "$wd/scripts/create_metabinner_bins.py" membership.tsv assembly.fa ./bins $prefix {config.min_contig_size}
mkdir -p "$wd/{config.out_dir}/GenomeBinning/MetaBinner/bins" \\
         "$wd/{config.out_dir}/GenomeBinning/MetaBinner/unbinned" \\
         "$wd/{config.out_dir}/GenomeBinning/MetaBinner/discarded" \\
         "$wd/intermediates/binning/metabinner/{sample}"
# upstream METABINNER_BINS publishes tooShort/lowDepth to MetaBinner/discarded
# and unbinned to MetaBinner/unbinned; create_metabinner_bins.py never emits a
# lowDepth file, so that move is guarded
[ -e $prefix.tooShort.fa.gz ] && mv $prefix.tooShort.fa.gz "$wd/{config.out_dir}/GenomeBinning/MetaBinner/discarded/"
[ -e $prefix.lowDepth.fa.gz ] && mv $prefix.lowDepth.fa.gz "$wd/{config.out_dir}/GenomeBinning/MetaBinner/discarded/"
mv $prefix.unbinned.fa.gz "$wd/intermediates/binning/metabinner/{sample}/"
cp "$wd/intermediates/binning/metabinner/{sample}/$prefix.unbinned.fa.gz" "$wd/{config.out_dir}/GenomeBinning/MetaBinner/unbinned/"
if ls bins/*.fa.gz >/dev/null 2>&1; then
    mv bins/*.fa.gz "$wd/{config.out_dir}/GenomeBinning/MetaBinner/bins/"
fi
cd "$wd"
rm -rf .tmp/mb_bins_megahit_{sample}
"""

[rules.resources]
threads = 2
memory = "12G"
time_limit = "4h"

[rules.environment]
conda = "envs/metabinner.yaml"

# ---------------------------------------------------------------------------
# SEMIBIN (label process_medium; prefix {assembler}-SemiBin2-{id})
# ---------------------------------------------------------------------------
[[rules]]
name = "semibin_spades"
input = [
    "intermediates/assembly/SPAdes/SPAdes-{sample}.scaffolds.fa",
    "intermediates/binning/alignments/SPAdes",
]
output = [
    "{config.out_dir}/GenomeBinning/SemiBin2/bins",
    "{config.out_dir}/GenomeBinning/SemiBin2/log",
]
depends_on = ["bowtie2_align_spades"]
description = "Binning of the SPAdes assembly with SemiBin2 (upstream SEMIBIN_SINGLEEASYBIN)"
shell = """
wd=$(pwd)
mkdir -p .tmp/semibin_spades_{sample} && cd .tmp/semibin_spades_{sample}
ln -sf "$wd/{input[0]}" assembly.fa
bams=$(LC_ALL=C ls "$wd"/intermediates/binning/alignments/SPAdes/SPAdes-{sample}-*.bam)
prefix=SPAdes-SemiBin2-{sample}
# upstream passes --environment only for single-sample cohorts
env_args=""
if [ "$(echo {config.cohort_samples} | wc -w)" -eq 1 ]; then
    env_args="--environment {config.semibin_environment}"
fi
SemiBin2 \\
    single_easy_bin \\
    --input-fasta assembly.fa \\
    --input-bam $bams \\
    --tag-output $prefix \\
    --output $prefix \\
    -t {threads} \\
    --random-seed {config.semibin_rng_seed} \\
    --min-len {config.min_contig_size} \\
    --compression gz \\
    --engine cpu \\
    --sequencing-type short_reads \\
    $env_args
mv ./$prefix/output_bins/ bins/
mv ./$prefix/SemiBinRun.log $prefix.SemiBinRun.log
mkdir -p "$wd/{config.out_dir}/GenomeBinning/SemiBin2/bins" "$wd/{config.out_dir}/GenomeBinning/SemiBin2/log"
if ls bins/*.fa.gz >/dev/null 2>&1; then
    mv bins/*.fa.gz "$wd/{config.out_dir}/GenomeBinning/SemiBin2/bins/"
fi
mv $prefix.SemiBinRun.log "$wd/{config.out_dir}/GenomeBinning/SemiBin2/log/"
cd "$wd"
rm -rf .tmp/semibin_spades_{sample}
"""

[rules.resources]
threads = 6
memory = "36G"
time_limit = "8h"

[rules.environment]
conda = "envs/semibin.yaml"

[[rules]]
name = "semibin_megahit"
input = [
    "intermediates/assembly/MEGAHIT/MEGAHIT-{sample}.contigs.fa",
    "intermediates/binning/alignments/MEGAHIT",
]
output = [
    "{config.out_dir}/GenomeBinning/SemiBin2/bins",
    "{config.out_dir}/GenomeBinning/SemiBin2/log",
]
depends_on = ["bowtie2_align_megahit"]
description = "Binning of the MEGAHIT assembly with SemiBin2 (upstream SEMIBIN_SINGLEEASYBIN)"
shell = """
