[rules.resources]
threads = 12
memory = "72G"
time_limit = "16h"

[rules.environment]
conda = "envs/comebin.yaml"

# ---------------------------------------------------------------------------
# METABINNER (4 upstream processes per assembly; prefix {assembler}-MetaBinner-{id})
# ---------------------------------------------------------------------------
[[rules]]
name = "metabinner_kmer_spades"
input = ["intermediates/assembly/SPAdes/SPAdes-{sample}.scaffolds.fa"]
output = ["intermediates/binning/metabinner/{sample}/SPAdes-MetaBinner-{sample}_kmer_4_f{config.min_contig_size}.csv.gz"]
description = "4-mer composition profile of the SPAdes assembly (upstream METABINNER_KMER)"
shell = """
mkdir -p intermediates/binning/metabinner/{sample}
wd=$(pwd)
mkdir -p .tmp/mb_kmer_spades_{sample} && cd .tmp/mb_kmer_spades_{sample}
ln -sf "$wd/{input[0]}" assembly.fa
metabinner_path=$(dirname $(which run_metabinner.sh))
python $metabinner_path/scripts/gen_kmer.py assembly.fa {config.min_contig_size} 4
gzip -cn assembly_kmer_4_f{config.min_contig_size}.csv > SPAdes-MetaBinner-{sample}_kmer_4_f{config.min_contig_size}.csv.gz
mv SPAdes-MetaBinner-{sample}_kmer_4_f{config.min_contig_size}.csv.gz "$wd/intermediates/binning/metabinner/{sample}/"
cd "$wd"
rm -rf .tmp/mb_kmer_spades_{sample}
"""

