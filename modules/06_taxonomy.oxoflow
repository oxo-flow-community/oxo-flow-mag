threads = 2
memory = "4G"
time_limit = "4h"

[rules.environment]
conda = "envs/prokka.yaml"

[[rules]]
name = "prokka_spades_semibin2"
input = [
    "{config.out_dir}/GenomeBinning/SemiBin2/bins",
    "{config.out_dir}/GenomeBinning/SemiBin2/unbinned",
]
output = ["{config.out_dir}/Annotation/Prokka/SPAdes"]
depends_on = ["semibin_spades"]
description = "PROKKA annotation of the SPAdes SemiBin2 bins and chunks (upstream PROKKA, one process per bin)"
shell = """
wd=$(pwd)
mkdir -p .tmp/prokka_spades_semibin2_{sample} && cd .tmp/prokka_spades_semibin2_{sample}
mkdir -p "$wd/{config.out_dir}/Annotation/Prokka/SPAdes"
for f in "$wd"/{config.out_dir}/GenomeBinning/SemiBin2/bins/SPAdes-SemiBin2-{sample}*.fa.gz \
         "$wd"/{config.out_dir}/GenomeBinning/SemiBin2/unbinned/SPAdes-SemiBin2-{sample}*[0-9].fa.gz; do
    [ -e "$f" ] || continue
    prefix=$(basename "$f")
    prefix=${prefix%.fa.gz}
    prefix=${prefix%.fasta.gz}
    prefix=${prefix%.fa}
    prefix=${prefix%.fasta}
    gunzip -c "$f" > "$prefix.fa"
    prokka --metagenome --cpus {threads} --prefix "$prefix" "$prefix.fa"
    mv $prefix/* "$wd/{config.out_dir}/Annotation/Prokka/SPAdes/"
    rm -rf $prefix "$prefix.fa"
done
cd "$wd"
rm -rf .tmp/prokka_spades_semibin2_{sample}
"""

