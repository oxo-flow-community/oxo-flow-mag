    --batch-summary "$wd/{config.out_dir}/GenomeBinning/QC/BUSCO/SPAdes-SemiBin2-unclassified-unrefined-{sample}/{sample}-auto-busco.batch_summary.txt" \
    --bins-dir "$wd/{config.out_dir}/GenomeBinning/SemiBin2/bins" \
