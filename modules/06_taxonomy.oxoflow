    mkdir -p bins_dir
    while read -r b; do
        [ -z "$b" ] && continue
        ln -sf "$wd/$2/$b" bins_dir/$b
    done < "$wd/$1"
    mkdir pplacer_tmp
    gtdbtk classify_wf \
        --extension gz \
        --min_perc_aa {config.gtdbtk_min_perc_aa} \
        --min_af {config.gtdbtk_min_af} \
        --pplacer_cpus {config.gtdbtk_pplacer_cpus} \
        --genome_dir bins_dir \
        --prefix "$3" \
        --out_dir "$3" \
        --cpus {threads} \
        --scratch_dir pplacer_tmp
    mv "$3/gtdbtk.log" "$3/$3.log"
    mv "$3/gtdbtk.warnings.log" "$3/$3.warnings.log"
    cp "$3"/classify/*.summary.tsv "$wd/intermediates/binning/gtdbtk/summaries/SPAdes-MetaBinner-{sample}/"
    mkdir -p "$wd/{config.out_dir}/Taxonomy/GTDB-Tk/SPAdes/MetaBinner/{sample}"
    mv "$3" "$wd/{config.out_dir}/Taxonomy/GTDB-Tk/SPAdes/MetaBinner/{sample}/"
    cd "$wd"
    rm -rf "$4"
}
if [ -s passed_bins.txt ]; then
    classify_group passed_bins.txt "{config.out_dir}/GenomeBinning/MetaBinner/bins" "SPAdes-MetaBinner-unclassified-unrefined-{sample}" .tmp/gtdbtk_bins_spades_metabinner_{sample}
