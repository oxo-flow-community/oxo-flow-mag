    mv "$3" "$wd/{config.out_dir}/Taxonomy/GTDB-Tk/SPAdes/SemiBin2/{sample}/"
    cd "$wd"
    rm -rf "$4"
}
if [ -s passed_bins.txt ]; then
    classify_group passed_bins.txt "{config.out_dir}/GenomeBinning/SemiBin2/bins" "SPAdes-SemiBin2-unclassified-unrefined-{sample}" .tmp/gtdbtk_bins_spades_semibin2_{sample}
