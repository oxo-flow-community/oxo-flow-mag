    cp "$3"/classify/*.summary.tsv "$wd/intermediates/binning/gtdbtk/summaries/SPAdes-COMEBin-{sample}/"
    mkdir -p "$wd/{config.out_dir}/Taxonomy/GTDB-Tk/SPAdes/COMEBin/{sample}"
    mv "$3" "$wd/{config.out_dir}/Taxonomy/GTDB-Tk/SPAdes/COMEBin/{sample}/"
    cd "$wd"
    rm -rf "$4"
}
if [ -s passed_bins.txt ]; then
    classify_group passed_bins.txt "{config.out_dir}/GenomeBinning/COMEBin/bins" "SPAdes-COMEBin-unclassified-unrefined-{sample}" .tmp/gtdbtk_bins_spades_comebin_{sample}
fi
if [ -s passed_chunks.txt ]; then
    classify_group passed_chunks.txt "{config.out_dir}/GenomeBinning/COMEBin/unbinned" "SPAdes-COMEBin-unclassified-unrefined_unbinned-{sample}" .tmp/gtdbtk_chunks_spades_comebin_{sample}
fi
"""

