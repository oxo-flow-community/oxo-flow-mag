    mkdir -p "$wd/{config.out_dir}/Taxonomy/GTDB-Tk/SPAdes/CONCOCT/{sample}"
    mv "$3" "$wd/{config.out_dir}/Taxonomy/GTDB-Tk/SPAdes/CONCOCT/{sample}/"
    cd "$wd"
    rm -rf "$4"
}
if [ -s passed_bins.txt ]; then
    classify_group passed_bins.txt "{config.out_dir}/GenomeBinning/CONCOCT/bins" "SPAdes-CONCOCT-unclassified-unrefined-{sample}" .tmp/gtdbtk_bins_spades_concoct_{sample}
fi
if [ -s passed_chunks.txt ]; then
    classify_group passed_chunks.txt "{config.out_dir}/GenomeBinning/CONCOCT/unbinned" "SPAdes-CONCOCT-unclassified-unrefined_unbinned-{sample}" .tmp/gtdbtk_chunks_spades_concoct_{sample}
fi
"""

[rules.resources]
threads = 2
memory = "140G"
time_limit = "12h"

[rules.environment]
conda = "envs/gtdbtk.yaml"

[[rules]]
name = "gtdbtk_spades_comebin"
input = [
    "{config.out_dir}/GenomeBinning/QC/BUSCO/SPAdes-COMEBin-unclassified-unrefined-{sample}/{sample}-auto-busco.batch_summary.txt",
    "{config.out_dir}/GenomeBinning/QC/BUSCO/SPAdes-COMEBin-unclassified-unrefined_unbinned-{sample}/{sample}-auto-busco.batch_summary.txt",
    "{config.out_dir}/GenomeBinning/COMEBin/bins",
    "{config.out_dir}/GenomeBinning/COMEBin/unbinned",
    "intermediates/gtdbtk_db/database",
]
output = [
    "intermediates/binning/gtdbtk/discarded/SPAdes-COMEBin-{sample}.txt",
    "intermediates/binning/gtdbtk/summaries/SPAdes-COMEBin-{sample}",
]
depends_on = ["busco_spades_comebin", "gtdbtk_db_preparation"]
description = "GTDB-Tk classification of the SPAdes COMEBin bins passing the BUSCO filter (upstream GTDBTK filter + GTDBTK_CLASSIFYWF)"
shell = """
wd=$(pwd)
mkdir -p intermediates/binning/gtdbtk/discarded intermediates/binning/gtdbtk/summaries/SPAdes-COMEBin-{sample}
# replicate the upstream Groovy QC filter: per group, read the BUSCO batch
# summary (Input_file/Complete/Duplicated), drop negative readings and bins
# without metrics; a bin passes if any single reading clears both thresholds
python "$wd/scripts/filter_bins_by_qc.py" \
    --batch-summary "$wd/{config.out_dir}/GenomeBinning/QC/BUSCO/SPAdes-COMEBin-unclassified-unrefined-{sample}/{sample}-auto-busco.batch_summary.txt" \
    --bins-dir "$wd/{config.out_dir}/GenomeBinning/COMEBin/bins" \
    --bins-glob "SPAdes-COMEBin-{sample}*.fa.gz" \
