[workflow]
name = "06_taxonomy"
description = "nf-core/mag 5.5.0 06_taxonomy fragment"
# ---------------------------------------------------------------------------
# TAXONOMY (nf-core/mag 5.5.0 default path): GTDB-Tk database preparation,
# GTDB-Tk classification per (assembler, binner) group of the bins passing
# the BUSCO-based QC filter (the upstream Groovy filter is replicated in
# scripts/filter_bins_by_qc.py), the gtdbtk + bin summaries, PROKKA
# annotation of every bin, and MultiQC.
#
# Like the QC fragment, each per-(assembler, binner) GTDB-Tk group runs
# classify_wf twice: once for the bins (prefix ...-unclassified-unrefined-)
# and once for the passing unbinned chunks (...-unrefined_unbinned-). Both
# out_dir trees land in results/Taxonomy/GTDB-Tk/{assembler}/{binner}/{sample}/.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# GTDBTK_DB_PREPARATION: unpack the GTDB-Tk data tar.gz (or copy a local
# directory). Upstream default --gtdb_db is a download URL; the file must be
# downloaded first (see README).
# ---------------------------------------------------------------------------
[[rules]]
name = "gtdbtk_db_preparation"
input = ["{config.gtdb_db}"]
output = ["intermediates/gtdbtk_db/database"]
description = "Prepare the GTDB-Tk reference database (upstream GTDBTK_DB_PREPARATION)"
shell = """
mkdir -p intermediates/gtdbtk_db/database
if [ -d "{input[0]}" ]; then
    # user passed a directory instead of a tar.gz
    cp -r "{input[0]}"/. intermediates/gtdbtk_db/database/
else
    tar -xzf "{input[0]}" -C intermediates/gtdbtk_db/database --strip 1
fi
"""

[rules.resources]
threads = 1
memory = "7G"
time_limit = "4h"

[rules.environment]
conda = "envs/gtdbtk_db_preparation.yaml"
[[rules]]
name = "gtdbtk_spades_metabat2"
input = [
    "{config.out_dir}/GenomeBinning/QC/BUSCO/SPAdes-MetaBAT2-unclassified-unrefined-{sample}/{sample}-auto-busco.batch_summary.txt",
    "{config.out_dir}/GenomeBinning/QC/BUSCO/SPAdes-MetaBAT2-unclassified-unrefined_unbinned-{sample}/{sample}-auto-busco.batch_summary.txt",
    "{config.out_dir}/GenomeBinning/MetaBAT2/bins",
    "{config.out_dir}/GenomeBinning/MetaBAT2/unbinned",
    "intermediates/gtdbtk_db/database",
]
output = [
    "intermediates/binning/gtdbtk/discarded/SPAdes-MetaBAT2-{sample}.txt",
    "intermediates/binning/gtdbtk/summaries/SPAdes-MetaBAT2-{sample}",
]
depends_on = ["busco_spades_metabat2", "gtdbtk_db_preparation"]
description = "GTDB-Tk classification of the SPAdes MetaBAT2 bins passing the BUSCO filter (upstream GTDBTK filter + GTDBTK_CLASSIFYWF)"
shell = """
wd=$(pwd)
mkdir -p intermediates/binning/gtdbtk/discarded intermediates/binning/gtdbtk/summaries/SPAdes-MetaBAT2-{sample}
# replicate the upstream Groovy QC filter: per group, read the BUSCO batch
# summary (Input_file/Complete/Duplicated), drop negative readings and bins
# without metrics; a bin passes if any single reading clears both thresholds
python "$wd/scripts/filter_bins_by_qc.py" \
    --batch-summary "$wd/{config.out_dir}/GenomeBinning/QC/BUSCO/SPAdes-MetaBAT2-unclassified-unrefined-{sample}/{sample}-auto-busco.batch_summary.txt" \
    --bins-dir "$wd/{config.out_dir}/GenomeBinning/MetaBAT2/bins" \
    --bins-glob "SPAdes-MetaBAT2-{sample}*.fa.gz" \
    --min-completeness {config.gtdbtk_min_completeness} \
    --max-contamination {config.gtdbtk_max_contamination} \
    --out-passed passed_bins.txt \
    --out-discarded discarded_bins.txt
python "$wd/scripts/filter_bins_by_qc.py" \
    --batch-summary "$wd/{config.out_dir}/GenomeBinning/QC/BUSCO/SPAdes-MetaBAT2-unclassified-unrefined_unbinned-{sample}/{sample}-auto-busco.batch_summary.txt" \
    --bins-dir "$wd/{config.out_dir}/GenomeBinning/MetaBAT2/unbinned" \
    --bins-glob "SPAdes-MetaBAT2-{sample}*[0-9].fa.gz" \
    --min-completeness {config.gtdbtk_min_completeness} \
    --max-contamination {config.gtdbtk_max_contamination} \
    --out-passed passed_chunks.txt \
    --out-discarded discarded_chunks.txt
cat discarded_bins.txt discarded_chunks.txt > discarded_all.txt
cp discarded_all.txt intermediates/binning/gtdbtk/discarded/SPAdes-MetaBAT2-{sample}.txt

export GTDBTK_DATA_PATH="$(find -L intermediates/gtdbtk_db -name metadata -type d -exec dirname {} \\; | head -1)"
classify_group() {
    # $1 = passed list, $2 = source dir, $3 = gtdbtk prefix, $4 = scratch dir
    mkdir -p "$4" && cd "$4"
    mkdir -p bins_dir
    while read -r b; do
        [ -z "$b" ] && continue
        ln -sf "$wd/$2/$b" bins_dir/$b
    done < "$wd/$1"
    mkdir pplacer_tmp
    gtdbtk classify_wf \
        --extension gz \
        --min_perc_aa {config.gtdbtk_min_perc_aa} \
        --min_af {config.gtdbtk_min_af} \
        --pplacer_cpus {config.gtdbtk_pplacer_cpus} \
        --genome_dir bins_dir \
        --prefix "$3" \
        --out_dir "$3" \
        --cpus {threads} \
        --scratch_dir pplacer_tmp
    mv "$3/gtdbtk.log" "$3/$3.log"
    mv "$3/gtdbtk.warnings.log" "$3/$3.warnings.log"
    cp "$3"/classify/*.summary.tsv "$wd/intermediates/binning/gtdbtk/summaries/SPAdes-MetaBAT2-{sample}/"
    mkdir -p "$wd/{config.out_dir}/Taxonomy/GTDB-Tk/SPAdes/MetaBAT2/{sample}"
    mv "$3" "$wd/{config.out_dir}/Taxonomy/GTDB-Tk/SPAdes/MetaBAT2/{sample}/"
    cd "$wd"
    rm -rf "$4"
}
if [ -s passed_bins.txt ]; then
    classify_group passed_bins.txt "{config.out_dir}/GenomeBinning/MetaBAT2/bins" "SPAdes-MetaBAT2-unclassified-unrefined-{sample}" .tmp/gtdbtk_bins_spades_metabat2_{sample}
fi
if [ -s passed_chunks.txt ]; then
    classify_group passed_chunks.txt "{config.out_dir}/GenomeBinning/MetaBAT2/unbinned" "SPAdes-MetaBAT2-unclassified-unrefined_unbinned-{sample}" .tmp/gtdbtk_chunks_spades_metabat2_{sample}
fi
"""

[rules.resources]
threads = 2
memory = "140G"
time_limit = "12h"

[rules.environment]
conda = "envs/gtdbtk.yaml"

[[rules]]
name = "gtdbtk_spades_maxbin2"
input = [
    "{config.out_dir}/GenomeBinning/QC/BUSCO/SPAdes-MaxBin2-unclassified-unrefined-{sample}/{sample}-auto-busco.batch_summary.txt",
    "{config.out_dir}/GenomeBinning/QC/BUSCO/SPAdes-MaxBin2-unclassified-unrefined_unbinned-{sample}/{sample}-auto-busco.batch_summary.txt",
    "{config.out_dir}/GenomeBinning/MaxBin2/bins",
    "{config.out_dir}/GenomeBinning/MaxBin2/unbinned",
    "intermediates/gtdbtk_db/database",
]
output = [
    "intermediates/binning/gtdbtk/discarded/SPAdes-MaxBin2-{sample}.txt",
    "intermediates/binning/gtdbtk/summaries/SPAdes-MaxBin2-{sample}",
]
depends_on = ["busco_spades_maxbin2", "gtdbtk_db_preparation"]
description = "GTDB-Tk classification of the SPAdes MaxBin2 bins passing the BUSCO filter (upstream GTDBTK filter + GTDBTK_CLASSIFYWF)"
shell = """
wd=$(pwd)
mkdir -p intermediates/binning/gtdbtk/discarded intermediates/binning/gtdbtk/summaries/SPAdes-MaxBin2-{sample}
# replicate the upstream Groovy QC filter: per group, read the BUSCO batch
# summary (Input_file/Complete/Duplicated), drop negative readings and bins
# without metrics; a bin passes if any single reading clears both thresholds
python "$wd/scripts/filter_bins_by_qc.py" \
    --batch-summary "$wd/{config.out_dir}/GenomeBinning/QC/BUSCO/SPAdes-MaxBin2-unclassified-unrefined-{sample}/{sample}-auto-busco.batch_summary.txt" \
    --bins-dir "$wd/{config.out_dir}/GenomeBinning/MaxBin2/bins" \
    --bins-glob "SPAdes-MaxBin2-{sample}*.fa.gz" \
    --min-completeness {config.gtdbtk_min_completeness} \
    --max-contamination {config.gtdbtk_max_contamination} \
    --out-passed passed_bins.txt \
    --out-discarded discarded_bins.txt
python "$wd/scripts/filter_bins_by_qc.py" \
    --batch-summary "$wd/{config.out_dir}/GenomeBinning/QC/BUSCO/SPAdes-MaxBin2-unclassified-unrefined_unbinned-{sample}/{sample}-auto-busco.batch_summary.txt" \
    --bins-dir "$wd/{config.out_dir}/GenomeBinning/MaxBin2/unbinned" \
    --bins-glob "SPAdes-MaxBin2-{sample}*[0-9].fa.gz" \
    --min-completeness {config.gtdbtk_min_completeness} \
    --max-contamination {config.gtdbtk_max_contamination} \
    --out-passed passed_chunks.txt \
    --out-discarded discarded_chunks.txt
cat discarded_bins.txt discarded_chunks.txt > discarded_all.txt
cp discarded_all.txt intermediates/binning/gtdbtk/discarded/SPAdes-MaxBin2-{sample}.txt

export GTDBTK_DATA_PATH="$(find -L intermediates/gtdbtk_db -name metadata -type d -exec dirname {} \\; | head -1)"
classify_group() {
    # $1 = passed list, $2 = source dir, $3 = gtdbtk prefix, $4 = scratch dir
    mkdir -p "$4" && cd "$4"
    mkdir -p bins_dir
    while read -r b; do
        [ -z "$b" ] && continue
