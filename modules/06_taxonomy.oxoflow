    --min-completeness {config.gtdbtk_min_completeness} \
    --max-contamination {config.gtdbtk_max_contamination} \
    --out-passed passed_chunks.txt \
    --out-discarded discarded_chunks.txt
cat discarded_bins.txt discarded_chunks.txt > discarded_all.txt
cp discarded_all.txt intermediates/binning/gtdbtk/discarded/SPAdes-CONCOCT-{sample}.txt

export GTDBTK_DATA_PATH="$(find -L intermediates/gtdbtk_db -name metadata -type d -exec dirname {} \\; | head -1)"
classify_group() {
    # $1 = passed list, $2 = source dir, $3 = gtdbtk prefix, $4 = scratch dir
