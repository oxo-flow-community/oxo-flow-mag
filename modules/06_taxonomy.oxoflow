        --extension gz \
        --min_perc_aa {config.gtdbtk_min_perc_aa} \
        --min_af {config.gtdbtk_min_af} \
        --pplacer_cpus {config.gtdbtk_pplacer_cpus} \
        --genome_dir bins_dir \
        --prefix "$3" \
        --out_dir "$3" \
        --cpus {threads} \
        --scratch_dir pplacer_tmp
    mv "$3/gtdbtk.log" "$3/$3.log"
    mv "$3/gtdbtk.warnings.log" "$3/$3.warnings.log"
    cp "$3"/classify/*.summary.tsv "$wd/intermediates/binning/gtdbtk/summaries/SPAdes-MaxBin2-{sample}/"
    mkdir -p "$wd/{config.out_dir}/Taxonomy/GTDB-Tk/SPAdes/MaxBin2/{sample}"
    mv "$3" "$wd/{config.out_dir}/Taxonomy/GTDB-Tk/SPAdes/MaxBin2/{sample}/"
    cd "$wd"
    rm -rf "$4"
}
if [ -s passed_bins.txt ]; then
    classify_group passed_bins.txt "{config.out_dir}/GenomeBinning/MaxBin2/bins" "SPAdes-MaxBin2-unclassified-unrefined-{sample}" .tmp/gtdbtk_bins_spades_maxbin2_{sample}
fi
if [ -s passed_chunks.txt ]; then
    classify_group passed_chunks.txt "{config.out_dir}/GenomeBinning/MaxBin2/unbinned" "SPAdes-MaxBin2-unclassified-unrefined_unbinned-{sample}" .tmp/gtdbtk_chunks_spades_maxbin2_{sample}
fi
"""

[rules.resources]
threads = 2
memory = "140G"
time_limit = "12h"

[rules.environment]
conda = "envs/gtdbtk.yaml"

[[rules]]
name = "gtdbtk_spades_concoct"
input = [
    "{config.out_dir}/GenomeBinning/QC/BUSCO/SPAdes-CONCOCT-unclassified-unrefined-{sample}/{sample}-auto-busco.batch_summary.txt",
    "{config.out_dir}/GenomeBinning/QC/BUSCO/SPAdes-CONCOCT-unclassified-unrefined_unbinned-{sample}/{sample}-auto-busco.batch_summary.txt",
    "{config.out_dir}/GenomeBinning/CONCOCT/bins",
    "{config.out_dir}/GenomeBinning/CONCOCT/unbinned",
    "intermediates/gtdbtk_db/database",
]
output = [
    "intermediates/binning/gtdbtk/discarded/SPAdes-CONCOCT-{sample}.txt",
    "intermediates/binning/gtdbtk/summaries/SPAdes-CONCOCT-{sample}",
]
depends_on = ["busco_spades_concoct", "gtdbtk_db_preparation"]
description = "GTDB-Tk classification of the SPAdes CONCOCT bins passing the BUSCO filter (upstream GTDBTK filter + GTDBTK_CLASSIFYWF)"
shell = """
wd=$(pwd)
mkdir -p intermediates/binning/gtdbtk/discarded intermediates/binning/gtdbtk/summaries/SPAdes-CONCOCT-{sample}
# replicate the upstream Groovy QC filter: per group, read the BUSCO batch
# summary (Input_file/Complete/Duplicated), drop negative readings and bins
# without metrics; a bin passes if any single reading clears both thresholds
python "$wd/scripts/filter_bins_by_qc.py" \
    --batch-summary "$wd/{config.out_dir}/GenomeBinning/QC/BUSCO/SPAdes-CONCOCT-unclassified-unrefined-{sample}/{sample}-auto-busco.batch_summary.txt" \
    --bins-dir "$wd/{config.out_dir}/GenomeBinning/CONCOCT/bins" \
