[rules.resources]
threads = 2
memory = "140G"
time_limit = "12h"

[rules.environment]
conda = "envs/gtdbtk.yaml"

# ---------------------------------------------------------------------------
# GTDBTK_SUMMARY: combine the classify_wf summaries with the QC-discarded
# bins into one table (upstream GTDBTK_SUMMARY, summary_gtdbtk.py)
# ---------------------------------------------------------------------------
[[rules]]
name = "gtdbtk_summary"
input = [
    "intermediates/binning/gtdbtk/discarded",
    "intermediates/binning/gtdbtk/summaries",
]
output = ["{config.out_dir}/Taxonomy/GTDB-Tk/gtdbtk_summary.tsv"]
depends_on = [
    "gtdbtk_spades_metabat2",
    "gtdbtk_spades_maxbin2",
    "gtdbtk_spades_concoct",
    "gtdbtk_spades_comebin",
    "gtdbtk_spades_metabinner",
    "gtdbtk_spades_semibin2",
    "gtdbtk_megahit_metabat2",
    "gtdbtk_megahit_maxbin2",
    "gtdbtk_megahit_concoct",
    "gtdbtk_megahit_comebin",
    "gtdbtk_megahit_metabinner",
    "gtdbtk_megahit_semibin2"
]
description = "Combine GTDB-Tk classification and QC-discarded bins into one table (upstream GTDBTK_SUMMARY)"
shell = """
mkdir -p {config.out_dir}/Taxonomy/GTDB-Tk
args_d=""
if ls intermediates/binning/gtdbtk/discarded/*.txt >/dev/null 2>&1; then
    cat intermediates/binning/gtdbtk/discarded/*.txt > discarded_all.txt
    if [ -s discarded_all.txt ]; then
        args_d="-d $(tr '\n' ' ' < discarded_all.txt)"
    fi
fi
args_s=""
if ls intermediates/binning/gtdbtk/summaries/*/*.summary.tsv >/dev/null 2>&1; then
    args_s="-s $(ls intermediates/binning/gtdbtk/summaries/*/*.summary.tsv | tr '\n' ' ')"
fi
if [ -n "$args_d" ] || [ -n "$args_s" ]; then
    summary_gtdbtk.py -x gz $args_d $args_s --out gtdbtk_summary.tsv
else
    touch gtdbtk_summary.tsv
fi
mv gtdbtk_summary.tsv {config.out_dir}/Taxonomy/GTDB-Tk/
"""

[rules.resources]
threads = 1
memory = "7G"
time_limit = "4h"

[rules.environment]
conda = "envs/gtdbtk_summary.yaml"

# ---------------------------------------------------------------------------
# BIN_SUMMARY: combine the depth, QUAST, BUSCO and GTDB-Tk tables into the
# final bin_summary.tsv (upstream BIN_SUMMARY, combine_tables.py)
# ---------------------------------------------------------------------------
[[rules]]
name = "bin_summary"
input = [
    "{config.out_dir}/GenomeBinning/depths/bins/bin_depths_summary.tsv",
    "{config.out_dir}/GenomeBinning/QC/quast_bin_summary.tsv",
    "{config.out_dir}/GenomeBinning/QC/busco_summary.tsv",
    "{config.out_dir}/Taxonomy/GTDB-Tk/gtdbtk_summary.tsv",
]
output = ["{config.out_dir}/GenomeBinning/bin_summary.tsv"]
depends_on = ["mag_depths_summary", "concat_quast", "concat_busco", "gtdbtk_summary"]
description = "Combine the bin QC and taxonomy tables into one summary (upstream BIN_SUMMARY)"
shell = """
args_quast=""
[ -s "{input[1]}" ] && args_quast="--quast_summary {input[1]}"
args_busco=""
[ -s "{input[2]}" ] && args_busco="--busco_summary {input[2]}"
args_gtdbtk=""
[ -s "{input[3]}" ] && args_gtdbtk="--gtdbtk_summary {input[3]}"
combine_tables.py \
    --depths_summary {input[0]} \
    $args_quast \
    $args_busco \
    $args_gtdbtk \
    --out bin_summary.tsv
mv bin_summary.tsv {config.out_dir}/GenomeBinning/
"""

[rules.resources]
threads = 1
memory = "7G"
time_limit = "4h"

[rules.environment]
conda = "envs/bin_summary.yaml"

# ---------------------------------------------------------------------------
# PROKKA (upstream runs one PROKKA process per bin, meta.id = bin name
# minus the fasta extension; publish results/Annotation/Prokka/{assembler}/)
# ---------------------------------------------------------------------------
[[rules]]
name = "prokka_spades_metabat2"
input = [
    "{config.out_dir}/GenomeBinning/MetaBAT2/bins",
    "{config.out_dir}/GenomeBinning/MetaBAT2/unbinned",
]
output = ["{config.out_dir}/Annotation/Prokka/SPAdes"]
depends_on = ["metabat2_spades", "split_fasta_metabat2_spades"]
description = "PROKKA annotation of the SPAdes MetaBAT2 bins and chunks (upstream PROKKA, one process per bin)"
shell = """
wd=$(pwd)
mkdir -p .tmp/prokka_spades_metabat2_{sample} && cd .tmp/prokka_spades_metabat2_{sample}
mkdir -p "$wd/{config.out_dir}/Annotation/Prokka/SPAdes"
for f in "$wd"/{config.out_dir}/GenomeBinning/MetaBAT2/bins/SPAdes-MetaBAT2-{sample}*.fa.gz \
         "$wd"/{config.out_dir}/GenomeBinning/MetaBAT2/unbinned/SPAdes-MetaBAT2-{sample}*[0-9].fa.gz; do
    [ -e "$f" ] || continue
    prefix=$(basename "$f")
    prefix=${prefix%.fa.gz}
    prefix=${prefix%.fasta.gz}
    prefix=${prefix%.fa}
    prefix=${prefix%.fasta}
    gunzip -c "$f" > "$prefix.fa"
    prokka --metagenome --cpus {threads} --prefix "$prefix" "$prefix.fa"
    mv $prefix/* "$wd/{config.out_dir}/Annotation/Prokka/SPAdes/"
    rm -rf $prefix "$prefix.fa"
done
cd "$wd"
rm -rf .tmp/prokka_spades_metabat2_{sample}
"""

[rules.resources]
threads = 2
memory = "4G"
time_limit = "4h"

[rules.environment]
conda = "envs/prokka.yaml"

