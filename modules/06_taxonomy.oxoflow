    "intermediates/gtdbtk_db/database",
]
output = [
    "intermediates/binning/gtdbtk/discarded/SPAdes-SemiBin2-{sample}.txt",
    "intermediates/binning/gtdbtk/summaries/SPAdes-SemiBin2-{sample}",
]
depends_on = ["busco_spades_semibin2", "gtdbtk_db_preparation"]
description = "GTDB-Tk classification of the SPAdes SemiBin2 bins passing the BUSCO filter (upstream GTDBTK filter + GTDBTK_CLASSIFYWF)"
