[rules.resources]
threads = 2
memory = "140G"
time_limit = "12h"

[rules.environment]
conda = "envs/gtdbtk.yaml"

[[rules]]
name = "gtdbtk_spades_semibin2"
input = [
    "{config.out_dir}/GenomeBinning/QC/BUSCO/SPAdes-SemiBin2-unclassified-unrefined-{sample}/{sample}-auto-busco.batch_summary.txt",
    "{config.out_dir}/GenomeBinning/QC/BUSCO/SPAdes-SemiBin2-unclassified-unrefined_unbinned-{sample}/{sample}-auto-busco.batch_summary.txt",
    "{config.out_dir}/GenomeBinning/SemiBin2/bins",
