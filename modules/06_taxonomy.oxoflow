export GTDBTK_DATA_PATH="$(find -L intermediates/gtdbtk_db -name metadata -type d -exec dirname {} \\; | head -1)"
classify_group() {
    # $1 = passed list, $2 = source dir, $3 = gtdbtk prefix, $4 = scratch dir
    mkdir -p "$4" && cd "$4"
    mkdir -p bins_dir
    while read -r b; do
        [ -z "$b" ] && continue
        ln -sf "$wd/$2/$b" bins_dir/$b
    done < "$wd/$1"
    mkdir pplacer_tmp
    gtdbtk classify_wf \
        --extension gz \
        --min_perc_aa {config.gtdbtk_min_perc_aa} \
        --min_af {config.gtdbtk_min_af} \
        --pplacer_cpus {config.gtdbtk_pplacer_cpus} \
        --genome_dir bins_dir \
        --prefix "$3" \
        --out_dir "$3" \
        --cpus {threads} \
        --scratch_dir pplacer_tmp
    mv "$3/gtdbtk.log" "$3/$3.log"
    mv "$3/gtdbtk.warnings.log" "$3/$3.warnings.log"
    cp "$3"/classify/*.summary.tsv "$wd/intermediates/binning/gtdbtk/summaries/MEGAHIT-COMEBin-{sample}/"
    mkdir -p "$wd/{config.out_dir}/Taxonomy/GTDB-Tk/MEGAHIT/COMEBin/{sample}"
    mv "$3" "$wd/{config.out_dir}/Taxonomy/GTDB-Tk/MEGAHIT/COMEBin/{sample}/"
    cd "$wd"
    rm -rf "$4"
}
if [ -s passed_bins.txt ]; then
    classify_group passed_bins.txt "{config.out_dir}/GenomeBinning/COMEBin/bins" "MEGAHIT-COMEBin-unclassified-unrefined-{sample}" .tmp/gtdbtk_bins_megahit_comebin_{sample}
fi
if [ -s passed_chunks.txt ]; then
    classify_group passed_chunks.txt "{config.out_dir}/GenomeBinning/COMEBin/unbinned" "MEGAHIT-COMEBin-unclassified-unrefined_unbinned-{sample}" .tmp/gtdbtk_chunks_megahit_comebin_{sample}
fi
"""

[rules.resources]
threads = 2
memory = "140G"
time_limit = "12h"

[rules.environment]
conda = "envs/gtdbtk.yaml"

[[rules]]
name = "gtdbtk_megahit_metabinner"
input = [
    "{config.out_dir}/GenomeBinning/QC/BUSCO/MEGAHIT-MetaBinner-unclassified-unrefined-{sample}/{sample}-auto-busco.batch_summary.txt",
    "{config.out_dir}/GenomeBinning/QC/BUSCO/MEGAHIT-MetaBinner-unclassified-unrefined_unbinned-{sample}/{sample}-auto-busco.batch_summary.txt",
    "{config.out_dir}/GenomeBinning/MetaBinner/bins",
    "{config.out_dir}/GenomeBinning/MetaBinner/unbinned",
    "intermediates/gtdbtk_db/database",
]
output = [
    "intermediates/binning/gtdbtk/discarded/MEGAHIT-MetaBinner-{sample}.txt",
    "intermediates/binning/gtdbtk/summaries/MEGAHIT-MetaBinner-{sample}",
]
depends_on = ["busco_megahit_metabinner", "gtdbtk_db_preparation"]
description = "GTDB-Tk classification of the MEGAHIT MetaBinner bins passing the BUSCO filter (upstream GTDBTK filter + GTDBTK_CLASSIFYWF)"
shell = """
wd=$(pwd)
mkdir -p intermediates/binning/gtdbtk/discarded intermediates/binning/gtdbtk/summaries/MEGAHIT-MetaBinner-{sample}
# replicate the upstream Groovy QC filter: per group, read the BUSCO batch
# summary (Input_file/Complete/Duplicated), drop negative readings and bins
# without metrics; a bin passes if any single reading clears both thresholds
python "$wd/scripts/filter_bins_by_qc.py" \
    --batch-summary "$wd/{config.out_dir}/GenomeBinning/QC/BUSCO/MEGAHIT-MetaBinner-unclassified-unrefined-{sample}/{sample}-auto-busco.batch_summary.txt" \
    --bins-dir "$wd/{config.out_dir}/GenomeBinning/MetaBinner/bins" \
    --bins-glob "MEGAHIT-MetaBinner-{sample}*.fa.gz" \
    --min-completeness {config.gtdbtk_min_completeness} \
    --max-contamination {config.gtdbtk_max_contamination} \
    --out-passed passed_bins.txt \
    --out-discarded discarded_bins.txt
python "$wd/scripts/filter_bins_by_qc.py" \
    --batch-summary "$wd/{config.out_dir}/GenomeBinning/QC/BUSCO/MEGAHIT-MetaBinner-unclassified-unrefined_unbinned-{sample}/{sample}-auto-busco.batch_summary.txt" \
    --bins-dir "$wd/{config.out_dir}/GenomeBinning/MetaBinner/unbinned" \
    --bins-glob "MEGAHIT-MetaBinner-{sample}*[0-9].fa.gz" \
    --min-completeness {config.gtdbtk_min_completeness} \
    --max-contamination {config.gtdbtk_max_contamination} \
    --out-passed passed_chunks.txt \
    --out-discarded discarded_chunks.txt
cat discarded_bins.txt discarded_chunks.txt > discarded_all.txt
cp discarded_all.txt intermediates/binning/gtdbtk/discarded/MEGAHIT-MetaBinner-{sample}.txt

export GTDBTK_DATA_PATH="$(find -L intermediates/gtdbtk_db -name metadata -type d -exec dirname {} \\; | head -1)"
classify_group() {
    # $1 = passed list, $2 = source dir, $3 = gtdbtk prefix, $4 = scratch dir
    mkdir -p "$4" && cd "$4"
    mkdir -p bins_dir
    while read -r b; do
        [ -z "$b" ] && continue
        ln -sf "$wd/$2/$b" bins_dir/$b
    done < "$wd/$1"
    mkdir pplacer_tmp
    gtdbtk classify_wf \
        --extension gz \
        --min_perc_aa {config.gtdbtk_min_perc_aa} \
        --min_af {config.gtdbtk_min_af} \
        --pplacer_cpus {config.gtdbtk_pplacer_cpus} \
        --genome_dir bins_dir \
        --prefix "$3" \
        --out_dir "$3" \
        --cpus {threads} \
        --scratch_dir pplacer_tmp
    mv "$3/gtdbtk.log" "$3/$3.log"
    mv "$3/gtdbtk.warnings.log" "$3/$3.warnings.log"
    cp "$3"/classify/*.summary.tsv "$wd/intermediates/binning/gtdbtk/summaries/MEGAHIT-MetaBinner-{sample}/"
    mkdir -p "$wd/{config.out_dir}/Taxonomy/GTDB-Tk/MEGAHIT/MetaBinner/{sample}"
    mv "$3" "$wd/{config.out_dir}/Taxonomy/GTDB-Tk/MEGAHIT/MetaBinner/{sample}/"
    cd "$wd"
    rm -rf "$4"
}
if [ -s passed_bins.txt ]; then
    classify_group passed_bins.txt "{config.out_dir}/GenomeBinning/MetaBinner/bins" "MEGAHIT-MetaBinner-unclassified-unrefined-{sample}" .tmp/gtdbtk_bins_megahit_metabinner_{sample}
fi
if [ -s passed_chunks.txt ]; then
    classify_group passed_chunks.txt "{config.out_dir}/GenomeBinning/MetaBinner/unbinned" "MEGAHIT-MetaBinner-unclassified-unrefined_unbinned-{sample}" .tmp/gtdbtk_chunks_megahit_metabinner_{sample}
fi
"""

