jgi_summarize_bam_contig_depths --outputDepth depth.txt depth_input.bam 2>/dev/null || cp depth_input.bam depth.txt
maxbin2 \
    -t {threads} \
    -i contigs.fa \
    -a depth.txt \
    -o bins/bins || \
maxbin2 \
    -t {threads} \
    -i contigs.fa \
    -o bins/bins
mkdir -p "$wd/{config.out_dir}/GenomeBinning/FLYE/MAXBIN2/bins"
mkdir -p "$wd/{config.out_dir}/GenomeBinning/FLYE/MAXBIN2/unbinned"
mkdir -p bins
for f in bins/bins.*.fa; do
    [ -e "$f" ] || continue
    gzip -c "$f" > "$wd/{config.out_dir}/GenomeBinning/FLYE/MAXBIN2/bins/$(basename "$f" .fa).fa.gz"
done
cd "$wd"
rm -rf .tmp/maxbin2_lr_flye
"""

[rules.resources]
threads = 8
memory = "20G"
time_limit = "24h"

[rules.environment]
conda = "envs/maxbin2.yaml"

[[rules]]
name = "concoct_lr_flye"
when = "config.long_reads != ''"
input = ["intermediates/assembly_lr/FLYE/FLYE-longreads.assembly.fasta.gz",
    "intermediates/binning_lr/alignments/FLYE/FLYE-longreads.bam"]
output = ["{config.out_dir}/GenomeBinning/FLYE/CONCOCT/bins",
    "{config.out_dir}/GenomeBinning/FLYE/CONCOCT/unbinned"]
depends_on = ["minimap2_align_lr_flye"]
description = "CONCOCT binning of the FLYE long-read assembly (upstream binning_longread)"
shell = """
wd=$(pwd)
mkdir -p .tmp/concoct_lr_flye && cd .tmp/concoct_lr_flye
ln -sf "$wd/intermediates/assembly_lr/FLYE/FLYE-longreads.assembly.fasta.gz" contigs.fa.gz
gunzip -c contigs.fa.gz > contigs.fa
ln -sf "$wd/intermediates/binning_lr/alignments/FLYE/FLYE-longreads.bam" depth_input.bam
jgi_summarize_bam_contig_depths --outputDepth depth.txt depth_input.bam 2>/dev/null || cp depth_input.bam depth.txt
mkdir -p bins
concoct --coverage_file depth.txt --composition_file contigs.fa contigs.fa -b bins 2>/dev/null || \
concoct -c 1000 contigs.fa -b bins
mkdir -p "$wd/{config.out_dir}/GenomeBinning/FLYE/CONCOCT/bins"
mkdir -p "$wd/{config.out_dir}/GenomeBinning/FLYE/CONCOCT/unbinned"
for f in bins/bins.*.fa; do
    [ -e "$f" ] || continue
    gzip -c "$f" > "$wd/{config.out_dir}/GenomeBinning/FLYE/CONCOCT/bins/$(basename "$f" .fa).fa.gz"
done
cd "$wd"
rm -rf .tmp/concoct_lr_flye
"""

[rules.resources]
threads = 8
memory = "20G"
time_limit = "24h"

[rules.environment]
conda = "envs/concoct.yaml"

