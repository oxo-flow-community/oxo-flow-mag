[workflow]
name = "03_binning_prep"
description = "nf-core/mag 5.5.0 03_binning_prep fragment"
# ---------------------------------------------------------------------------
# BINNING PREPARATION (nf-core/mag 5.5.0 default path, binning_map_mode=group):
# BOWTIE2_ASSEMBLY_BUILD -> BOWTIE2_ASSEMBLY_ALIGN per assembly; every
# assembly is aligned against every sample's reads in the cohort (upstream
# group mode), which the align rule implements as a shell loop over
# config.cohort_samples. Upstream names the alignments
# {assembler}-{asm}-{reads}; the own-alignment log is renamed
# {assembler}-{asm}.bowtie2.log.
# ---------------------------------------------------------------------------

# BOWTIE2_ASSEMBLY_BUILD (no label -> 1 cpu/7GB/4h). One index per assembly
# in intermediates; upstream keeps the index files in each task's workdir.
[[rules]]
name = "bowtie2_build_spades"
when = "config.reads_sheet == '' || {meta.reads_2} != '' || {meta.reads_layout} == 'interleaved'"
input = ["intermediates/assembly/SPAdes/SPAdes-{sample}.scaffolds.fa"]
output = [
    "intermediates/binning/assembly_index/SPAdes/SPAdes-{sample}.1.bt2",
    "intermediates/binning/assembly_index/SPAdes/SPAdes-{sample}.rev.1.bt2",
]
description = "Build the bowtie2 index of the SPAdes assembly (upstream BOWTIE2_ASSEMBLY_BUILD)"
shell = """
mkdir -p intermediates/binning/assembly_index/SPAdes
cd intermediates/binning/assembly_index/SPAdes
bowtie2-build --threads {threads} "$OLDPWD/{input[0]}" "SPAdes-{sample}"
"""

[rules.resources]
threads = 1
memory = "7G"
time_limit = "4h"

[rules.environment]
conda = "envs/bowtie2.yaml"

[[rules]]
name = "bowtie2_build_megahit"
input = ["intermediates/assembly/MEGAHIT/MEGAHIT-{sample}.contigs.fa"]
output = [
    "intermediates/binning/assembly_index/MEGAHIT/MEGAHIT-{sample}.1.bt2",
    "intermediates/binning/assembly_index/MEGAHIT/MEGAHIT-{sample}.rev.1.bt2",
]
description = "Build the bowtie2 index of the MEGAHIT assembly (upstream BOWTIE2_ASSEMBLY_BUILD)"
shell = """
mkdir -p intermediates/binning/assembly_index/MEGAHIT
cd intermediates/binning/assembly_index/MEGAHIT
bowtie2-build --threads {threads} "$OLDPWD/{input[0]}" "MEGAHIT-{sample}"
"""

[rules.resources]
threads = 1
memory = "7G"
time_limit = "4h"

[rules.environment]
conda = "envs/bowtie2.yaml"

# BOWTIE2_ASSEMBLY_ALIGN (8 cpu / 12GB / 8h override). One rule instance per
# assembly; inside, a shell loop aligns the cohort's reads (group mode).
# BAMs stay in intermediates (upstream publishes them only when
# save_assembly_mapped_reads is set); the bowtie2 logs are published under
# results/Assembly/{assembler}/QC/{sample}/.
[[rules]]
name = "bowtie2_align_spades"
when = "config.reads_sheet == ''"
input = [
    # file-level inputs (not the shared dirs): exact-string edges +
    # per-file manifests make re-runs propagate — the dir-only input
    # let this rule stay fresh on a stale bam next to a fresh assembly
    # (live: ALE died on the mismatch)
    "intermediates/binning/assembly_index/SPAdes/SPAdes-{sample}.1.bt2",
    "intermediates/binning/assembly_index/SPAdes/SPAdes-{sample}.rev.1.bt2",
    "intermediates/QC_shortreads/remove_phix/{sample}_run1_phix_removed_1.unmapped.fastq.gz",
    "intermediates/QC_shortreads/remove_phix/{sample}_run1_phix_removed_2.unmapped.fastq.gz",
]
output = [
    "intermediates/binning/alignments/SPAdes",
    # the full row this instance writes (own + cross-sample bams):
    # declared so re-runs propagate to the depth/binning consumers —
    # dir-only outputs left stale cross-bams behind a fresh assembly
    # (live: the depth matrix had zero columns and MetaBAT2 spun).
    # The cohort names are hard-coded like the rest of the port's
    # per-assembler/per-sample expansion (config.cohort_samples).
    "intermediates/binning/alignments/SPAdes/SPAdes-{sample}-S1.bam",
    "intermediates/binning/alignments/SPAdes/SPAdes-{sample}-S2.bam",
    "{config.out_dir}/Assembly/SPAdes/QC/{sample}/SPAdes-{sample}.bowtie2.log",
]
depends_on = ["bowtie2_build_spades"]
description = "Align all cohort reads against the SPAdes assembly (upstream BOWTIE2_ASSEMBLY_ALIGN, group mode)"
shell = """
wd=$(pwd)
mkdir -p intermediates/binning/alignments/SPAdes {config.out_dir}/Assembly/SPAdes/QC/{sample}
mkdir -p .tmp/align_spades_{sample} && cd .tmp/align_spades_{sample}
# find the index base like the upstream module (works on symlinked dirs via find -L)
ln -sf "$wd/intermediates/binning/assembly_index/SPAdes" index
# the index dir is shared by both samples' builds — scope the find to
# THIS instance's assembly or -x gets "S2 S1" as one prefix (live:
# bowtie2 died, the empty pipeline still passed the dir-only output)
INDEX=$(find -L ./ -name "SPAdes-{sample}*.rev.1.bt2l" -o -name "SPAdes-{sample}*.rev.1.bt2" | sed 's/.rev.1.bt2l//' | sed 's/.rev.1.bt2//')
[ -z "$INDEX" ] && echo "Bowtie2 index files not found" 1>&2 && exit 1
for r in {config.cohort_samples}; do
    name="SPAdes-{sample}-$r"
    bowtie2 -p {threads} \\
            -x "$INDEX" \\
            -1 "$wd/intermediates/QC_shortreads/remove_phix/${r}_run1_phix_removed_1.unmapped.fastq.gz" \\
            -2 "$wd/intermediates/QC_shortreads/remove_phix/${r}_run1_phix_removed_2.unmapped.fastq.gz" \\
            2> ${name}.bowtie2.log | \\
        samtools view -@ {threads} -bS | \\
        samtools sort -@ {threads} -o ${name}.bam
    samtools index ${name}.bam
    # own-alignment log is renamed (upstream: if name == {asm}-{id}-{id})
    if [ "$r" = "{sample}" ]; then
        mv ${name}.bowtie2.log "SPAdes-{sample}.bowtie2.log"
        mv "SPAdes-{sample}.bowtie2.log" "$wd/{config.out_dir}/Assembly/SPAdes/QC/{sample}/"
    else
        mv ${name}.bowtie2.log "$wd/{config.out_dir}/Assembly/SPAdes/QC/{sample}/"
    fi
    mv ${name}.bam ${name}.bam.bai "$wd/intermediates/binning/alignments/SPAdes/"
done
cd "$wd"
rm -rf .tmp/align_spades_{sample}
"""

[rules.resources]
threads = 8
memory = "12G"
time_limit = "8h"

[rules.environment]
conda = "envs/bowtie2_samtools.yaml"

[[rules]]
name = "bowtie2_align_megahit"
when = "config.reads_sheet == ''"
input = [
    # file-level inputs (not the shared dirs): exact-string edges +
    # per-file manifests make re-runs propagate — the dir-only input
    # let this rule stay fresh on a stale bam next to a fresh assembly
    # (live: ALE died on the mismatch)
    "intermediates/binning/assembly_index/MEGAHIT/MEGAHIT-{sample}.1.bt2",
    "intermediates/binning/assembly_index/MEGAHIT/MEGAHIT-{sample}.rev.1.bt2",
    "intermediates/QC_shortreads/remove_phix/{sample}_run1_phix_removed_1.unmapped.fastq.gz",
    "intermediates/QC_shortreads/remove_phix/{sample}_run1_phix_removed_2.unmapped.fastq.gz",
]
output = [
    "intermediates/binning/alignments/MEGAHIT",
    # the full row this instance writes (own + cross-sample bams):
    # declared so re-runs propagate to the depth/binning consumers —
    # dir-only outputs left stale cross-bams behind a fresh assembly
    # (live: the depth matrix had zero columns and MetaBAT2 spun).
    # The cohort names are hard-coded like the rest of the port's
    # per-assembler/per-sample expansion (config.cohort_samples).
    "intermediates/binning/alignments/MEGAHIT/MEGAHIT-{sample}-S1.bam",
    "intermediates/binning/alignments/MEGAHIT/MEGAHIT-{sample}-S2.bam",
    "{config.out_dir}/Assembly/MEGAHIT/QC/{sample}/MEGAHIT-{sample}.bowtie2.log",
]
depends_on = ["bowtie2_build_megahit"]
description = "Align all cohort reads against the MEGAHIT assembly (upstream BOWTIE2_ASSEMBLY_ALIGN, group mode)"
shell = """
wd=$(pwd)
mkdir -p intermediates/binning/alignments/MEGAHIT {config.out_dir}/Assembly/MEGAHIT/QC/{sample}
mkdir -p .tmp/align_megahit_{sample} && cd .tmp/align_megahit_{sample}
ln -sf "$wd/intermediates/binning/assembly_index/MEGAHIT" index
# the index dir is shared by both samples' builds — scope the find to
# THIS instance's assembly or -x gets "S2 S1" as one prefix (live:
# bowtie2 died, the empty pipeline still passed the dir-only output)
INDEX=$(find -L ./ -name "MEGAHIT-{sample}*.rev.1.bt2l" -o -name "MEGAHIT-{sample}*.rev.1.bt2" | sed 's/.rev.1.bt2l//' | sed 's/.rev.1.bt2//')
[ -z "$INDEX" ] && echo "Bowtie2 index files not found" 1>&2 && exit 1
for r in {config.cohort_samples}; do
    name="MEGAHIT-{sample}-$r"
    bowtie2 -p {threads} \\
            -x "$INDEX" \\
            -1 "$wd/intermediates/QC_shortreads/remove_phix/${r}_run1_phix_removed_1.unmapped.fastq.gz" \\
            -2 "$wd/intermediates/QC_shortreads/remove_phix/${r}_run1_phix_removed_2.unmapped.fastq.gz" \\
            2> ${name}.bowtie2.log | \\
        samtools view -@ {threads} -bS | \\
        samtools sort -@ {threads} -o ${name}.bam
    samtools index ${name}.bam
    # own-alignment log is renamed (upstream: if name == {asm}-{id}-{id})
    if [ "$r" = "{sample}" ]; then
        mv ${name}.bowtie2.log "MEGAHIT-{sample}.bowtie2.log"
        mv "MEGAHIT-{sample}.bowtie2.log" "$wd/{config.out_dir}/Assembly/MEGAHIT/QC/{sample}/"
    else
        mv ${name}.bowtie2.log "$wd/{config.out_dir}/Assembly/MEGAHIT/QC/{sample}/"
    fi
    mv ${name}.bam ${name}.bam.bai "$wd/intermediates/binning/alignments/MEGAHIT/"
done
cd "$wd"
rm -rf .tmp/align_megahit_{sample}
"""

[rules.resources]
threads = 8
memory = "12G"
time_limit = "8h"

[rules.environment]
conda = "envs/bowtie2_samtools.yaml"

# SHEET-MODE BOWTIE2_ASSEMBLY_ALIGN (SPAdes): one rule per assembly covering
# every read set in the cohort (upstream group mode). PE rows map with the
# concordant -1/-2 pair; single-end and interleaved rows map their single
# stream with -U (upstream BOWTIE2_ASSEMBLY_ALIGN single-end branch - bowtie2
# has no interleaved pair flag, so interleaved input is mapped per read).
# Default mode: pruned at plan time (default plan byte-identical).
[[rules]]
name = "bowtie2_align_spades_sheet"
when = "config.reads_sheet != '' && {meta.reads_1} != ''"
input = [
    "intermediates/binning/assembly_index/SPAdes/SPAdes-{sample}.1.bt2",
    "intermediates/binning/assembly_index/SPAdes/SPAdes-{sample}.rev.1.bt2",
]
output = [
    "intermediates/binning/alignments/SPAdes",
    "{config.out_dir}/Assembly/SPAdes/QC/{sample}/SPAdes-{sample}.bowtie2.log",
]
depends_on = ["bowtie2_build_spades"]
description = "Align all cohort reads against the SPAdes assembly from the reads sheet (upstream BOWTIE2_ASSEMBLY_ALIGN, group mode)"
shell = """
wd=$(pwd)
mkdir -p intermediates/binning/alignments/SPAdes {config.out_dir}/Assembly/SPAdes/QC/{sample}
mkdir -p .tmp/align_spades_{sample} && cd .tmp/align_spades_{sample}
ln -sf "$wd/intermediates/binning/assembly_index/SPAdes" index
INDEX=$(find -L ./ -name "SPAdes-{sample}*.rev.1.bt2l" -o -name "SPAdes-{sample}*.rev.1.bt2" | sed 's/.rev.1.bt2l//' | sed 's/.rev.1.bt2//')
[ -z "$INDEX" ] && echo "Bowtie2 index files not found" 1>&2 && exit 1
for r in {config.cohort_samples}; do
    name="SPAdes-{sample}-$r"
    if [ -s "$wd/intermediates/QC_shortreads/remove_phix/${r}_run1_phix_removed_2.unmapped.fastq.gz" ]; then
        # pe row: concordant -1/-2 (upstream paired branch)
        bowtie2 -p {threads} \
                -x "$INDEX" \
                -1 "$wd/intermediates/QC_shortreads/remove_phix/${r}_run1_phix_removed_1.unmapped.fastq.gz" \
                -2 "$wd/intermediates/QC_shortreads/remove_phix/${r}_run1_phix_removed_2.unmapped.fastq.gz" \
                2> ${name}.bowtie2.log | \
            samtools view -@ {threads} -bS | \
            samtools sort -@ {threads} -o ${name}.bam
    else
        # single/interleaved row: single-read mapping (upstream -U branch)
        bowtie2 -p {threads} \
                -x "$INDEX" \
                -U "$wd/intermediates/QC_shortreads/remove_phix/${r}_run1_phix_removed_1.unmapped.fastq.gz" \
                2> ${name}.bowtie2.log | \
            samtools view -@ {threads} -bS | \
            samtools sort -@ {threads} -o ${name}.bam
    fi
    samtools index ${name}.bam
    # own-alignment log is renamed (upstream: if name == {asm}-{id}-{id})
    if [ "$r" = "{sample}" ]; then
        mv ${name}.bowtie2.log "SPAdes-{sample}.bowtie2.log"
        mv "SPAdes-{sample}.bowtie2.log" "$wd/{config.out_dir}/Assembly/SPAdes/QC/{sample}/"
    else
        mv ${name}.bowtie2.log "$wd/{config.out_dir}/Assembly/SPAdes/QC/{sample}/"
    fi
    mv ${name}.bam ${name}.bam.bai "$wd/intermediates/binning/alignments/SPAdes/"
done
cd "$wd"
rm -rf .tmp/align_spades_{sample}
"""

[rules.resources]
threads = 8
memory = "12G"
time_limit = "8h"

[rules.environment]
conda = "envs/bowtie2_samtools.yaml"

# SHEET-MODE BOWTIE2_ASSEMBLY_ALIGN (MEGAHIT): one rule per assembly covering
# every read set in the cohort (upstream group mode). PE rows map with the
# concordant -1/-2 pair; single-end and interleaved rows map their single
# stream with -U (upstream BOWTIE2_ASSEMBLY_ALIGN single-end branch - bowtie2
# has no interleaved pair flag, so interleaved input is mapped per read).
# Default mode: pruned at plan time (default plan byte-identical).
[[rules]]
name = "bowtie2_align_megahit_sheet"
when = "config.reads_sheet != '' && {meta.reads_1} != ''"
input = [
    "intermediates/binning/assembly_index/MEGAHIT/MEGAHIT-{sample}.1.bt2",
    "intermediates/binning/assembly_index/MEGAHIT/MEGAHIT-{sample}.rev.1.bt2",
]
output = [
    "intermediates/binning/alignments/MEGAHIT",
    "{config.out_dir}/Assembly/MEGAHIT/QC/{sample}/MEGAHIT-{sample}.bowtie2.log",
]
depends_on = ["bowtie2_build_megahit"]
description = "Align all cohort reads against the MEGAHIT assembly from the reads sheet (upstream BOWTIE2_ASSEMBLY_ALIGN, group mode)"
shell = """
wd=$(pwd)
mkdir -p intermediates/binning/alignments/MEGAHIT {config.out_dir}/Assembly/MEGAHIT/QC/{sample}
mkdir -p .tmp/align_megahit_{sample} && cd .tmp/align_megahit_{sample}
ln -sf "$wd/intermediates/binning/assembly_index/MEGAHIT" index
INDEX=$(find -L ./ -name "MEGAHIT-{sample}*.rev.1.bt2l" -o -name "MEGAHIT-{sample}*.rev.1.bt2" | sed 's/.rev.1.bt2l//' | sed 's/.rev.1.bt2//')
[ -z "$INDEX" ] && echo "Bowtie2 index files not found" 1>&2 && exit 1
for r in {config.cohort_samples}; do
    name="MEGAHIT-{sample}-$r"
    if [ -s "$wd/intermediates/QC_shortreads/remove_phix/${r}_run1_phix_removed_2.unmapped.fastq.gz" ]; then
        # pe row: concordant -1/-2 (upstream paired branch)
        bowtie2 -p {threads} \
                -x "$INDEX" \
                -1 "$wd/intermediates/QC_shortreads/remove_phix/${r}_run1_phix_removed_1.unmapped.fastq.gz" \
                -2 "$wd/intermediates/QC_shortreads/remove_phix/${r}_run1_phix_removed_2.unmapped.fastq.gz" \
                2> ${name}.bowtie2.log | \
            samtools view -@ {threads} -bS | \
            samtools sort -@ {threads} -o ${name}.bam
    else
        # single/interleaved row: single-read mapping (upstream -U branch)
        bowtie2 -p {threads} \
                -x "$INDEX" \
                -U "$wd/intermediates/QC_shortreads/remove_phix/${r}_run1_phix_removed_1.unmapped.fastq.gz" \
                2> ${name}.bowtie2.log | \
            samtools view -@ {threads} -bS | \
            samtools sort -@ {threads} -o ${name}.bam
    fi
    samtools index ${name}.bam
    # own-alignment log is renamed (upstream: if name == {asm}-{id}-{id})
    if [ "$r" = "{sample}" ]; then
        mv ${name}.bowtie2.log "MEGAHIT-{sample}.bowtie2.log"
        mv "MEGAHIT-{sample}.bowtie2.log" "$wd/{config.out_dir}/Assembly/MEGAHIT/QC/{sample}/"
    else
        mv ${name}.bowtie2.log "$wd/{config.out_dir}/Assembly/MEGAHIT/QC/{sample}/"
    fi
    mv ${name}.bam ${name}.bam.bai "$wd/intermediates/binning/alignments/MEGAHIT/"
done
cd "$wd"
rm -rf .tmp/align_megahit_{sample}
"""

[rules.resources]
threads = 8
memory = "12G"
time_limit = "8h"

[rules.environment]
conda = "envs/bowtie2_samtools.yaml"
